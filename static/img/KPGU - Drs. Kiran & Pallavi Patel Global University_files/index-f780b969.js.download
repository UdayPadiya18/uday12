ren:[r.jsx(w,{height:"200px",bgcolor:o||"#fff",className:"d-flex align-items-center",justifyContent:"center",p:2,children:r.jsx("img",{src:i,className:"w-100 h-100",alt:!0})}),r.jsx(w,{p:2,children:r.jsx("h5",{children:a})})]})});return r.jsxs(r.Fragment,{children:[r.jsx(An,{banner:{title:"MOUs",img:"https://res.cloudinary.com/dby2vbxv3/image/upload/v1702100388/KPGU/Banners/banner-2.jpg"}}),r.jsxs(w,{maxWidth:e,mx:"auto",p:"3%",bgcolor:"#fff",mt:7,borderRadius:4,className:"smooth-shadow",children:[r.jsx("h4",{className:"fw-bold color-secondary mb-3",children:"Our Valued Industry Partnerships"}),r.jsx(Je,{content:["At Drs. Kiran & Pallavi Patel Global University (KPGU), we are proud to collaborate with leading organizations through Memorandums of Understanding (MOUs). These strategic partnerships are designed to enhance our students' learning experiences, provide industry exposure, and open pathways to diverse career opportunities. By aligning with renowned companies, we ensure our students receive top-tier training and placement support, fostering an environment where academic excellence meets real-world application."]}),r.jsx(k,{container:!0,spacing:4,mt:4,children:t.map(({img:a,name:i,bgc:o},s)=>r.jsx(n,{bgc:o,img:a,name:i},s))})]})]})}function Qhe(){const{maxWidth:e}=p.useContext(X),t=p.useRef(null),n=[{img:"https://res.cloudinary.com/dby2vbxv3/image/upload/v1720088883/KPGU/Student%20Testimonials/d3dtxayolxuqippmryor.webp",name:"Vivek Jadav",branch:"Bsc. Chemisty",testimony:"I Mr. Vivek Jadav from Bsc. Chemistry is final year student, Krishna School of Science, KPGU, Vadodara. I am immensely grateful to our Director, Training of Placement Co-ordinator Dr. Miral Vora and our faculty members for providing me with the finest education and a conductive environment that has greatly contributed to be selected at Tata Consultancy Services (TCS) Ahmadabad, which help me to shape my career. I am also thankful to the Training and Placement Department for facilitating placement opportunities with top - Tier Company. The college activities and the library have also played a significant role in my overall development."},{img:"https://res.cloudinary.com/dby2vbxv3/image/upload/v1720088883/KPGU/Student%20Testimonials/ctj2iswd17tg4fcna8kv.webp",name:"Hemini Patel",branch:"B.Sc Microbiology",testimony:"I Ms. Hemini Patel from B.Sc. Microbiology in Final year students, Krishna School of Science, KPGU, Vadodara. I am also thankful to the Training & Placement Department for helping placement opportunities with top-tier companies. I am hugely grateful to our - Director, Training & Placement co-ordinator Dr. Miral Vora & our faculty members for providing me with the best education & an encouraging environment that has greatly contributed to be selected at Tata Consultancy Services (TCS), Ahmedabad, which will help me to shape my career. The enrichment from both the college activities & access to the library has been instrumental in shaping my overall development."},{img:"https://res.cloudinary.com/dby2vbxv3/image/upload/v1720088882/KPGU/Student%20Testimonials/qc8racpuxvfjbhbvnb1c.webp",name:"Tirth Dhobi",branch:"B.Sc Chemistry",testimony:"I Mr. Tirth Dhobi from B.Sc. Chemistry third year students, Krishna School of Science, KPGU, Vadodara. I have greatly contributed to be selected at Tata Consultancy Services (TCS), Ahmedabad. I am incredibly grateful to our Director, Training and Placement Co-ordinator Dr. Miral Vora, and Faculty members for the opportunities and support provided. The comprehensive training and guidance offered by the placement cell equipped me with the necessary skills and confidence to excel in interviews and secure a position in an interview one secure a position in a reputable company. The college’s emphasis on practical learning and industry connections played a crucial role in preparing me for the challenges of the professional world. I am proud to have been part of a college that priorities success and career growth and I am confident that the foundation laid here will serve me well in future endeavour."},{img:"https://res.cloudinary.com/dby2vbxv3/image/upload/v1720088882/KPGU/Student%20Testimonials/v0vfjtxhzumscnpgyis1.webp",name:"Roshan Baviskar",branch:"MBA Finance",testimony:"I am Roshan Baviskar from MBA (Finance), Krishna School of Emerging Technologies, KPGU, Vadodara. I am gladly in debt of KPGU, Directors & Placement officer for providing me with this great opportunity. I am glad to announce that I have been selected by Bandhan Bank with the guidance of director, Training & Placement Office - Devendra Sir. The support and guidance provided by them helped me in my interviews. Devendra Sir helped me brush my skills and confidence towards various aspects of placement talks like group discussions, Personal Interviews, etc. Through their guidance, I have excelled in interviews, which ultimately gave fruitful results. Moreover, our director sir provided special guidance towards the roles and responsibilities of the job that was offered by Bandhan Bank. I am proud to be part of a college that is working continuously for providing knowledge, placement opportunities and shaping the youth of our nation."},{img:"https://res.cloudinary.com/dby2vbxv3/image/upload/v1720088882/KPGU/Student%20Testimonials/lnodchydwwfqbgvsedev.webp",name:"Zeel Patel",branch:"B.Sc Chemistry",testimony:"I Mr. Zeel Patel from B.Sc. Chemistry final year student, Krishna School of Science, KPGU, Vadodara. I have greatly contributed to be selected at B Positive Tradex Pvt. Ltd. in Vadodara. The comprehensive training and guidance offered by the placement cell prepared me with the necessary skills and confidence to excel in interviews and secure a position in a reputable company. I am incredibly grateful to our director, training and placement coordinator Dr. Miral Vora and our faculty members for the opportunity and support provided. The college’s emphasis on practical training, learning, and industry connections played a crucial role in preparing me for the challenges of the professional world. I am proud to have been part of a college that prioritizes success and career growth, and I am assured that the foundation placed here will serve me well in my upcoming endeavors."},{img:"https://res.cloudinary.com/dby2vbxv3/image/upload/v1720088882/KPGU/Student%20Testimonials/ftvn4bbewlf19tswigyu.webp",name:"Devansh Pandya ",branch:"Computer Science",testimony:"I am thrilled to announce that I have been selected as on campus placement from KPGU. It was a great experience on placement drive, throughout placement time college has shown immense support and their coordination. A heartful thanks to Mr. Vruti Parikh mam for their coordination and also heartful thanks to Mr. Devendra Yadav Sir TPO of KPGU. The guidance and support provided by the faculty were instrumental, their expertise and encouragement helped me develop the necessary skills and confidence to excel in the selection process. The supportive and nurturing environment at KPGU fostered a culture of growth and learning. It encouraged me to push my boundaries, explore new opportunities, and strive for excellence in all endeavors. The college’s placement cell played a pivotal role in facilitating the entire placement process, from organizing recruitment drives to providing interview preparation guidance. Their efforts ensured a smooth transition from academia to the corporate world."},{img:"https://res.cloudinary.com/dby2vbxv3/image/upload/v1720088882/KPGU/Student%20Testimonials/xeixdvbadma0hrg3gixo.webp",name:"Keni solanki",branch:"Computer Science",testimony:"I am thrilled to announce that I have been selected as on campus placement from KPGU. It was a great experience on the placement drive, throughout placement Time College has shown immense support and their coordination. A heartful thanks to Mrs. Vruti Parikh mam for their coordination and heart full thanks to Mr. Devendra Yadav sir TPO of KPGU. The guidance and support provided by the faculty were incredible, their expertise and encouragement helped me develop the necessary skills and confidence to excel in the selection process. The supportive and nurturing environment at KPGU fostered a culture of growth and learning. They encouraged me to push my boundaries, explore new opportunities, and strive for excellence in all endeavours. The college’s placement cell played a pivotal role in facilitating the entire placement process, from organizing recruitment drives to providing interview preparation guidance. Their efforts ensured a smooth transition from academia to the corporate world."}],a=[{name:"NESTLE India",img:"https://res.cloudinary.com/dby2vbxv3/image/upload/v1720874827/KPGU/Placements/nsedqemwsvlnoleorkim.svg"},{name:"Tata Consultancy Services",img:"https://res.cloudinary.com/dby2vbxv3/image/upload/v1720874823/KPGU/Placements/yzzju0njhn0j9njl9fwb.svg"},{name:"Alembic Pharmaceuticals Limited",img:"https://res.cloudinary.com/dby2vbxv3/image/upload/v1720874841/KPGU/Placements/jljbbjvntv99uu9njyvk.svg"},{name:"L&T Energy Hydrocarbon.",img:"https://res.cloudinary.com/dby2vbxv3/image/upload/v1720874829/KPGU/Placements/vyorbab7ns313k9ljnet.svg"},{name:"Reliance Industries Limited (RIL",img:"https://res.cloudinary.com/dby2vbxv3/image/upload/v1720874825/KPGU/Placements/uoyuzefjfuztfvhpsczb.svg"},{name:"Tech Mahindra",img:"https://res.cloudinary.com/dby2vbxv3/image/upload/v1720985841/KPGU/Placements/nedo7ymgsvdzrs18uic9.svg"},{name:"JBM Group",img:"https://res.cloudinary.com/dby2vbxv3/image/upload/v1720874831/KPGU/Placements/eon4tz2ur02olfpwwnya.svg"},{name:"Jindal Infralogistics Ltd.",img:"https://res.cloudinary.com/dby2vbxv3/image/upload/v1720874831/KPGU/Placements/ksxg06xcmzdwik73okt2.svg"},{name:"Indus Towers",img:"https://res.cloudinary.com/dby2vbxv3/image/upload/v1720874831/KPGU/Placements/kl7kxrmry79ftxd848as.svg"},{name:"Suzuki Motor Gujarat Private Limited",img:"https://res.cloudinary.com/dby2vbxv3/image/upload/v1720874823/K