idth:e,mx:"auto",mb:1,p:"5%",py:5,className:"smooth-shadow rounded-4",bgcolor:"#fff",children:[r.jsx(k,{item:!0,sm:12,md:6,children:r.jsx("img",{src:"https://res.cloudinary.com/dby2vbxv3/image/upload/v1702911780/KPGU/Banners/about-banner.jpg",alt:"about us",width:"100%",height:"100%",className:"object-fit-cover rounded-4"})}),r.jsxs(k,{item:!0,sm:12,md:6,px:{xs:0,md:4},pb:3,mt:{xs:3,md:0},children:[r.jsx(He,{variant:"h3",fontWeight:600,className:"about-heading",children:"About KPGU..."}),r.jsx("h4",{className:"fw-bold mt-3",children:"Established as Private University in 2021 under the provisions of:"}),r.jsx("h5",{className:"fw-bold mt-3",children:r.jsx("div",{className:"me-2 mt-0",children:r.jsxs("div",{className:"d-flex align-items-start",children:[r.jsx("div",{className:"me-2",children:r.jsx(Il,{color:"secondary"})}),r.jsxs("div",{children:["Gujarat Private Universities Act, 2009 and Gujarat Private Universities (Amendment) Act, 2021 (Gujarat Act 15 of 2021)",r.jsx($,{variant:"contained",className:"fw-semibold mt-1 ms-2",color:"secondary",size:"small",href:"https://drive.google.com/file/d/1vIPwwtPWZrAUWrSnh6j7ZtFzWXxBGeU4/view",target:"_blank",disableElevation:!0,children:"Click to see"})]})]})})}),r.jsx("h5",{className:"fw-bold mt-3",children:r.jsx("div",{className:"me-2 mt-0",children:r.jsxs("div",{className:"d-flex align-items-start",children:[r.jsx("div",{className:"me-2",children:r.jsx(Il,{color:"secondary"})}),r.jsxs("div",{children:["Notification of Education Department, Government of Gujarat",r.jsx($,{variant:"contained",className:"fw-semibold mt-1 ms-2",color:"secondary",size:"small",href:"https://drive.google.com/file/d/1mKWnGFbD87IiewLvSJbeLXSXQItjXxsq/view",target:"_blank",disableElevation:!0,children:"Click to see"})]})]})})}),r.jsxs(He,{variant:"body1",className:"about-text mt-4",textAlign:"justify",mt:1,children:[r.jsxs("b",{children:["Drs. Kiran & Pallavi Patel Global University (KPGU) Vadodara,"," "]})," ",r.jsx("b",{children:"(formerly BITS Edu Campus)"})," offers quality education in Engineering and Technology, Health-Care, Science, Commerce and Management, Nursing."]}),r.jsx(k,{container:!0,spacing:1,mt:2,justifyContent:"center",children:s.map((m,f)=>r.jsx(l,{name:m},f))})]})]}),r.jsx(w,{width:e,mx:"auto",mb:1,px:"5%",className:"smooth-shadow rounded-4",bgcolor:"#fff",children:r.jsx(k,{container:!0,spacing:2,mt:3})}),r.jsx(w,{width:e,mx:"auto",mt:0,px:"5%",py:"3%",className:"smooth-shadow rounded-4",bgcolor:"#fff",children:r.jsx(w,{children:r.jsx(Je,{content:['KPGU aims to become a "University of Global Eminence," aligned with its vision to serve higher education, healthcare, and humanity with relentless pursuit of progress. The university’s transformation from an affiliating institution into a self-governing university marks a key milestone in its journey toward this goal. This success is possible due to dedicated efforts of the entire "Team Bits Edu Campus," under the guidance of Shree Krishna Educational & Charitable Trust.','By adhering to the KPGU Vision-2040, KPGU has positioned itself as a "Gateway to Global Excellence," to explore opportunities that will elevate performance to new levels. This growth reflects the university’s mission of globalizing knowledge through creation, acquisition, preservation, and exchange, and fostering a collaborative environment that nurtures innovative, compassionate, and socially responsible global citizens.',"KPGU is dedicated to achieving multifaceted excellence across academics, research, collaboration, outreach activities, skill development, and employability initiatives. These efforts ensure the continual progress of all stakeholders and reinforce KPGU's commitment to shaping individuals with scientific temper, empathy, courage, and creativity, contributing meaningfully to society.","With this transformational framework, KPGU is prepared to achieve national and international recognition, advancing the cause of higher education, healthcare, and service to mankind, while remaining ever-focused on new horizons and continual growth.","The vision of our esteemed Founder President, Shree Jagdishbhai D. Patel, to establish KPGU Vadodara as Gujarat's first foreign university campus is swiftly becoming a reality. Guided by global standards and benchmarks, this initiative is designed to secure a bright future for our students. This landmark achievement aligns with the provisions of the New Education Policy (NEP-2020).","Globally acclaimed University from the USA is associating with KPGU, Vadodara as Gujarat Campus through efforts and patronage of Dr. Kiran C. Patel, a proponent of Indo-American initiatives from Florida, USA.","KPGU has increased infrastructure to about 18 lakhs Sq.ft. and focused on Skill, Interdisciplinary, Industry driven curriculum with global appeal, collaborative research, social inclusiveness w.r.t. National Development Goals through its qualified faculty."]})})}),r.jsx(Ke,{value:a,children:r.jsxs(k,{container:!0,spacing:2,mt:1,children:[r.jsx(k,{item:!0,xs:12,children:r.jsx(w,{bgcolor:"#fff",p:2,borderRadius:4,className:"smooth-shadow sticky-top ",children:r.jsxs(Ve,{onChange:o,orientation:"horizontal",textColor:"secondary",indicatorColor:"secondary",variant:`${t<900?"scrollable":"fullWidth"}`,children:[r.jsx(G,{className:`${t<1020?"fs-6":"fs-5"} fw-bold`,label:"6 University Faculties",value:"1"}),r.jsx(G,{className:`${t<1020?"fs-6":"fs-5"} fw-bold`,label:"11 Constituent Institutions",value:"2"}),r.jsx(G,{className:`${t<1020?"fs-6":"fs-5"} fw-bold`,label:"6 Centers of Excellence",value:"3"})]})})}),r.jsx(k,{item:!0,xs:12,children:r.jsxs(w,{bgcolor:"#fff",px:"1.7%",borderRadius:4,className:"smooth-shadow",children:[r.jsx(W,{value:"1",children:r.jsx(k,{container:!0,spacing:2,children:c.map(({name:m,link:f},g)=>r.jsx(h,{link:f,name:m},g))})}),r.jsx(W,{value:"2",children:r.jsx(k,{container:!0,spacing:2,children:d.map(({name:m,link:f},g)=>r.jsx(h,{link:f,name:m},g))})}),r.jsx(W,{value:"3",children:r.jsx(k,{container:!0,spacing:2,children:u.map(({name:m,link:f},g)=>r.jsx(h,{link:f,name:m},g))})})]})})]})}),r.jsxs(w,{width:e,mx:"auto",mt:3,px:"5%",pt:"3%",className:"smooth-shadow rounded-4",bgcolor:"#fff",children:[r.jsx("h2",{className:"fw-bold color-secondary",children:"KPGU at a Glance..."}),r.jsxs("ul",{className:"mt-4",children:[r.jsx("li",{className:"fs-5 mb-3 text-capital fw-semibold ",children:"Implemented Comprehensive Research Policy to motivate faculty and students to conduct research, that led to complete 101 Research Projects amounting to ₹ 32 Lakhs from AICTE & GUJCOST and 4.50 Crores from SSIP and SOIC."}),r.jsx("li",{className:"fs-5 mb-3 text-capital fw-semibold ",children:"Grant sanctioned from Govt. Agencies: 3 Cr from Startup India- Govt. of India and 2 Cr from GKS under SSIP, Govt. of Gujarat in 2022."}),r.jsx("li",{className:"fs-5 mb-3 text-capital fw-semibold ",children:"Created academic eco-system for learning and research, including instruments (GC, FTIR, HPLC), facilities (FAB LAB, High Voltage Lab, PLC, CAD/CAM, MATLAP, PSIM, PRO-E), Botanical Garden and Animal House."}),r.jsx("li",{className:"fs-5 mb-3 text-capital fw-semibold ",children:"Published scientific papers (168) in SCI Journals, granted 6 industrial design and awarded 4 patents out of 45 under examination and 20 more patents under prosecution."}),r.jsx("li",{className:"fs-5 mb-3 text-capital fw-semibold ",children:"Established Institute Innovation Council (IIC) under MOEs Innovation Cell (Govt. of India) and recipient of 3.5 star ranking and listed among the top ten universities for IPR and Startup activities in 2022-2023."}),r.jsx("li",{className:"fs-5 mb-3 text-capital fw-semibold ",children:"Identified among top performing incubators under Startup India Seed fund scheme, Govt. of India since 2022."}),r.jsx("li",{className:"fs-5 mb-3 text-capital fw-semibold ",children:"Recognized as Nodal Institute under Assistance to StartUp Gujarat Cell of Industry Commissionerate, Govt. of Gujarat, (2021 onwards)."}),r.jsx("li",{className:"fs-5 mb-3 text-capital fw-semibold ",children:'Registered Section 8 Company named "Krishna Edu Foundation" - KEF under company Act 2013 and provided end to end support to innovators and startups through Seed Funding, Co-Working Spaces, Mentoring, and Networking.'}),r.jsx("li",{className:"fs-5 mb-3 text-capital fw-semibold ",children:"Selected as Implementing Agency (Group 2) under MeitY Startup Hub-GENESIS scheme in 2024."}),r.jsx("li",{className:"fs-5 mb-3 text-capital fw-semibold ",children:"10000+ Students Outreached and Sensitized for innovation in 2020-2024."}),r.jsx("li",{className:"fs-5 mb-3 text-capital fw-semibold ",children:"150+ innovations supported financially in 2020-2024."}),r.jsx("li",{className:"fs-5 mb-3 text-capital fw-semibold ",children:"2200+ Startup Applications Received for incubation since 2022."}),r.jsx("li",{className:"fs-5 mb-3 text-capital fw-semibold ",children:"36 Startups supported financially since 2021."}),r.jsx("li",{className:"fs-5 mb-3 text-capital fw-semibold ",children:"55+ Startups incubated since 2021."}),r.jsx("li",{className:"fs-5 mb-3 text-capital fw-semibold ",children:"75+ Mentors on board since 2020."}),r.jsx("li",{className:"fs-5 mb-3 text-capital fw-semibold ",children:"Revenue of ₹19.61 Crore Generated by Startups since 2022."}),r.jsx("li",{className:"fs-5 mb-3 text-capital fw-semibold ",children:"150+ jobs created by Startups since 2022."}),r.jsx("li",{className:"fs-5 mb-3 text-capital fw-semibold ",children:"Startups appreciated at prestigious expos & events at G20 Finance Minister's and Central Bank Governors (FCBD) meeting, India Med Tech Expo, Startup Mahakumbh, Vibrant Gujarat Startup Conclave, Ministry of Ayush Pavillion at World Food India during 2023-2024."}),r.jsx("li",{className:"fs-5 mb-3 text-capital fw-semibold ",children:"Identified Centre for Entrepreneurship, Technology Incubation & Business Acceleration (CETIBA)-District Training Centre by SPIPA."}),r.jsx("li",{className:"fs-5 mb-3 text-capital fw-semibold ",children:"Entered into MOU (100+) with Government Agencies, Industries, and Industrial Associations."}),r.jsx("li",{className:"fs-5 mb-3 text-capital fw-semibold ",children:"Fostered active international collaborations with Carleton Global Academy-Carleton University, Canada, University of North Alabama (UNA), USA, Catholic University of Murcia (UCAM), Spain and North Southern Eastern University (NSU), Florida for academic exchange programs."}),r.jsx("li",{className:"fs-5 mb-3 text-capital fw-semibold ",children:"Provisions for the Freeships & scholarships for deserving, meritorious and economically weak students."}),r.jsx("li",{className:"fs-5 mb-3 text-capital fw-semibold ",children:"Library and Information Centre (built-up area of 20000 Sq. Ft.), accommodating 1000 students, consists of 59314 book resources, e-Resources, journals, periodicals of ₹2 Crores."}),r.jsx("li",{className:"fs-5 mb-3 text-capital fw-semibold ",children:"E-Library equipped with automated Library Management System (LMS) with RFID (Radio Frequency Identification System) Technology with SOUL2.0 (Software made by INFLIBNET) Centre and E-Journals form UGC Under DELNET available to foster multidisciplinary learning."}),r.jsx("li",{className:"fs-5 mb-3 text-capital fw-semibold ",children:"Computer centre is equipped with 165 Computers connected thorough dedicated leased Wi-Fi Internet."}),r.jsx("li",{className:"fs-5 mb-3 text-capital fw-semibold ",children:"Provisions for ICT enabled Smart Class rooms, internet and campus Wi-Fi, CCTV surveillance system, 100 mbps internet connectivity, Gymnasium, Transport facility, Auditorium, Sports ground, Student Community Learning Club, Shopping Complex, Banks & ATM, etc. available."}),r.jsx("li",{className:"fs-5 mb-3 text-capital fw-semibold ",children:"Existence of Student cells such as Anti-ragging Cell, Anti-Sexual harassment Cell, Anti-discrimination cell, Career and Placement Cell and Community Learning Club, etc."}),r.jsx("li",{className:"fs-5 mb-3 text-capital fw-semibold ",children:"Students demonstrated performance in examination and secured Gold Medals and results consistently remained in the range of 70 to 90% for UG programs and 90 to 100% for PG in PG programs."}),r.jsx("li",{className:"fs-5 mb-3 text-capital fw-semibold ",children:"Training, Career Counseling and Placements (TNP) cell recorded 80% students placement."}),r.jsx("li",{className:"fs-5 mb-3 text-capital fw-semibold ",children:"Students secured more than 40 Recognition Awards under leadership, distinguished services, outstanding achievements, NSS, blood donation, Thalassemia drive, best student award, sports, etc."}),r.jsx("li",{className:"fs-5 mb-3 text-capital fw-semibold ",children:"Both Boys and Girls hostel with all modern amenities, including AC facilities. Hygienic, modern mess available."}),r.jsx("li",{className:"fs-5 mb-3 text-capital fw-semibold ",children:"Recognized Krishna School of Science with Certificate of Excellence from MakeIntern (E-Cell of IIT Kharagpur) and Identified as Zonal Training Center in the region."}),r.jsx("li",{className:"fs-5 mb-3 text-capital fw-semibold ",children:"Implemented NEP - 2020 and KPGU registered on the ABC (Academic Bank of Credits) portal."})]})]})]})]})}function xq(){const{maxWidth:e,innerWidth:t}=p.useContext(X),[n,a]=p.useState(null),i=p.useRef(null);p.useEffect(()=>{console.log(i.current.offsetHeight),a(i.current.offsetHeight)},[n]),console.log(i);const o=[{des:"Globalization through creation, acquisition, preservation and exchange of knowledge."},{des:"To provide collaborative environment for exchange of ideas, virtues & values. 10 To develop good human being possessing scientific temper, compassion, empathy, courage and creative imagination."},{des:"To nurture innovative and socially cultured global citizen."},{des:"To develop good human being possessing scientific temper, compassion, empathy, courage and creative imagination."},{des:"To foster multifaceted excellence in education and research outreach."}];return r.jsxs(r.Fragment,{children:[r.jsxs(hi,{children:[r.jsx("title",{children:"Vision and Mission of KPGU University"}),r.jsx("meta",{name:"description",content:"Explore the vision and mission of Drs. Kiran & Pallavi Patel Global University (KPGU). With a vision to become a University of Global Eminence by 2040, KPGU aims to serve the cause of higher education, healthcare, and service to mankind. Through a commitment to continual progress and pursuit of newer horizons, KPGU endeavors to foster multifaceted excellence in education, research, and outreach. Its mission includes globalization through knowledge exchange, creating a collaborative environment for idea exchange, nurturing innovative and socially cultured global citizens, and developing individuals with scientific temper, compassion, empathy, courage, and creative imagination."})]}),r.jsxs(w,{width:e,mx:"auto",p:"5%",className:"smooth-shadow rounded-4",bgcolor:"#fff",children:[r.jsx("h1",{className:"color-secondary fw-bolder mb-4",children:"Our Strategic Compass"}),r.jsxs(k,{container:!0,children:[r.jsx(k,{item:!0,xs:12,md:6,children:r.jsx("img",{src:"https://res.cloudinary.com/dby2vbxv3/image/upload/v1727178448/KPGU/WhatsApp_Image_2024-09-24_at_17.11.53_ada2f690_kosdsz.jpg",className:"w-100 h-100",alt:""})}),r.jsx(k,{item:!0,order:{xs:1,md:0},xs:12,md:6,children:r.jsx(w,{height:"100%",display:"flex",justifyContent:"center",flexDirection:"column",p:2,children:r.jsx(He,{fontWeight:600,variant:"body1",gutterBottom:!0,className:"fs-5 ",children:r.jsx(Qe,{quote:"The Drs. Kiran & Pallavi Patel Global University seeks to be an Organization of Universal Eminence Serving the Cause of Higher Education, Health Care and Service to the Mankind, Ever in Pursuit of Newer Horizons, ingrained with Spirit of Continual Progress of Stakeholders.",right:!0})})})}),r.jsx(k,{item:!0,xs:12,md:6,children:r.jsx(w,{p:2,ref:i,mt:3,children:o.map(({des:s},l)=>r.jsxs(ce,{direction:"row",alignItems:"start",children:[r.jsxs(He,{variant:"body1",gutterBottom:!0,className:"fs-4 me-1 color-secondary",fontWeight:600,children:[l+1,"."]}),r.jsx(He,{fontWeight:600,variant:"body1",gutterBottom:!0,className:"fs-5 color-secondary",children:s})]},l))})}),r.jsx(k,{item:!0,xs:12,md:6,children:r.jsx("img",{src:"https://res.cloudinary.com/dby2vbxv3/image/upload/v1727178448/KPGU/WhatsApp_Image_2024-09-24_at_17.12.14_e29ede02_voz2ic.jpg",className:"w-100 h-100",alt:""})})]})]}),r.jsxs(k,{container:!0,width:e,mx:"auto",px:"5%",py:"3%",mt:3,className:"smooth-shadow rounded-4",bgcolor:"#fff",children:[r.jsx("h2",{className:"fw-bold color-secondary",children:"Core Values"}),r.jsx(Je,{content:["The core values that underpin who we are to permeate the mission and assist in achieving its vision. The university respects the differences among individuals irrespective of socio-economic status, geographic location, religion, and cultural background so as to harbinger the perspective for the benefit of society.","The core values translated into value statements represent the hallmark of KPGU as an institution of higher learning. KPGU has demonstrated to act out of these core values in the governance, management, operations, teaching and learning, research and innovation, engagement, and other activities of the university to achieve the vision and accompanying goals. The core values of KPGU listed below have been in place ever since its establishment as an academic institution."]}),r.jsxs("ul",{children:[r.jsxs("li",{className:"fw-semibold fs-5 mt-2",children:[r.jsx("b",{children:"Academic integrity"}),": KPGU upholds the principles of honesty, transparency, and ethical conduct in every aspect."]}),r.jsxs("li",{className:"fw-semibold fs-5 mt-2",children:[r.jsx("b",{children:"Academic excellence"}),": KPGU strives to achieve academic standards in teaching and research with a focus on the professional growth of students, to meet society, and industry needs."]}),r.jsxs("li",{className:"fw-semibold fs-5 mt-2",children:[r.jsx("b",{children:"Local and global commitment"}),": KPGU commits to adopt curricula and pedagogy for knowledge-enabling education to enhance employability and encourage an entrepreneurial spirit that acts as a catalyst for transformative change in research and education."]}),r.jsxs("li",{className:"fw-semibold fs-5 mt-2",children:[r.jsx("b",{children:"Inclusiveness and mutual respect"}),": KPGU embraces geographic diversity and works collaboratively that respect and value the contributions of each individual."]}),r.jsxs("li",{className:"fw-semibold fs-5 mt-2",children:[r.jsx("b",{children:"Dedication and social responsibilities"}),": KPGU resolves to work hard relentlessly to elevate academic activities and build an effective ecosystem with industry, alumni, and research laboratories to leverage benefits to students and society."]}),r.jsxs("li",{className:"fw-semibold fs-5 mt-2",children:[r.jsx("b",{children:"Sustainability"}),": KPGU adopts environmental sustainability in all practices and rejuvenates the curricula for Sustainable Development Goals-based education."]})]})]}),r.jsxs(k,{container:!0,width:e,mx:"auto",px:"5%",py:"3%",mt:3,className:"smooth-shadow rounded-4",bgcolor:"#fff",children:[r.jsx("h2",{className:"fw-bold color-secondary",children:"Objectives"}),r.jsx("h4",{children:"The objectives of the university constitute the key determinants to integrate the vision with the mission mode for creating academic excellence. For this purpose, the objectives are to:"}),r.jsxs("ul",{children:[r.jsx("li",{className:"fw-semibold fs-5 mt-2",children:"Provide quality education to students from a variety of educational and socio-economic backgrounds in applied science, engineering technology, health sciences, and management disciplines to meet national and globally competitive needs."}),r.jsx("li",{className:"fw-semibold fs-5 mt-2",children:"Strengthen the existing academic programs, start new tailor-made courses addressing the needs of the industries, and improve the academic and research environment of the University."}),r.jsx("li",{className:"fw-semibold fs-5 mt-2",children:"Encourage students to work on collaborative research projects and undertake postgraduate studies."}),r.jsx("li",{className:"fw-semibold fs-5 mt-2",children:"Evolve active bilateral instruments for industry involvement to propagate need-based research through learning and make a significant contribution to creating a knowledge base."}),r.jsx("li",{className:"fw-semibold fs-5 mt-2",children:"Set up innovation foundations to foster techno-entrepreneurship innovation among graduates."}),r.jsx("li",{className:"fw-semibold fs-5 mt-2",children:"Institute a strong community component in the curriculum to inculcate a social perspective."}),r.jsx("li",{className:"fw-semibold fs-5 mt-2",children:"Act as a trend-setting institution and develop as the premier technical institution in the state."}),r.jsx("li",{className:"fw-semibold fs-5 mt-2",children:"Disseminate knowledge by organizing talks. seminars, symposia, workshops, and conferences."}),r.jsx("li",{className:"fw-semibold fs-5 mt-2",children:"Restructure the systems for academic and administrative transparency and accountability through policies."}),r.jsx("li",{className:"fw-semibold fs-5 mt-2",children:"Do all such things as are necessary, or conducive to the attainment of all or any of the objectives uncovered in the above points."})]})]})]})}function wq(){const{maxWidth:e}=p.useContext(X),t=[{des:"It gives me great happiness to note that Krishna Edu Campus that, over 16 Years of Existence as an affiliating campus now stands converted into Drs Kiran & Pallavi Patel Global University (KPGU), Vadodara with the capabilities to deliver contemporary higher education built on skill cured, interdisciplinary, industry driven, employability-oriented globalised curriculum and innovation fostered, interdisciplinary & high impact collaborative research."},{des:"Being a an Indian-American, having studied MBBS in Gujarat, having had an advanced medical education in America and having travelled across the globe, I have witnessed the changing paradigms of higher education and its impact world over, especially in the context of my motherland, India. Having established number of centres of importance in US and India, where intercountry association is at the centre of activity, I had envisaged a University that can truly deliver 21st Century Skills Driven Global Education."},{des:"By sharing my ideas with the Founder President & Managing Trustee, Shree Jagdishbhai D. Patel, of Shree Krishna Educational & Charitable Trust (SKECT), the constituent institutes of which have achieved national acclaim in higher professional education, I decided to get associated and extend all the support, especially so in terms of the collaborations with US universities."},{des:"Drs Kiran & Pallavi Patel Global University (KPGU), Vadodara is committed to transform students into globally competent professionals, who can address the challenges of this century. I am sure that the KPGU, Vadodara will make every effort to provide a great academic and campus ambience through its world class infrastructure, fully equipped departments with hi-tech gadgets, fully fledged workforce and stakeholder centric, high-quality systems of academics, research and inclusive governance. I am certain that this University will reach greater heights and etch its name prominently on global map in the time to come. I am sure you will have great learning experience to reach that coveted goal of your life, where you intensely seek to be."},{des:"Best Wishes"}];return r.jsxs(w,{maxWidth:e,mx:"auto",p:"5%",children:[r.jsxs(k,{container:!0,className:"smooth-shadow",borderRadius:3,overflow:"clip",my:5,bgcolor:"#fff",children:[r.jsx(k,{item:!0,xs:12,md:4,children:r.jsx(w,{className:"w-100 h-100 ",children:r.jsx("img",{src:"https://res.cloudinary.com/dby2vbxv3/image/upload/v1703929293/KPGU/Images/Dr_Kiran_C_Patel.webp",className:"w-100 h-100 object-fit-cover",alt:"photo"})})}),r.jsxs(k,{item:!0,xs:12,md:8,p:2,children:[r.jsx("h3",{className:"display-5 fw-semibold",children:"Dr. Kiran C. Patel"}),r.jsxs("p",{className:"fs-4 mb-2",children:[r.jsx("b",{children:"Hon’ble President "}),",",r.jsx("br",{}),"Drs. Kiran & Pallavi Patel Global University [KPGU, Vadodara]"]}),r.jsxs("p",{className:"fs-4 mb-2",children:[r.jsx("b",{children:"Chairman"}),",",r.jsx("br",{}),"Dr Kiran C Patel Medical College & Research Institute [KMCRI] BHARUCH"]}),r.jsxs("p",{className:"fs-4 mb-2",children:[r.jsx("b",{children:"Indian-American Philanthropist & Cardiologist"})," ",r.jsx("br",{}),"Tampa, Florida, USA"]})]})]}),r.jsxs(He,{variant:"h6",fontWeight:"600",children:["Dear Students to-be, ",r.jsx("br",{}),"Greetings from Tampa, Florida, US."]}),r.jsx(w,{mt:4,children:t.map(({des:n},a)=>r.jsx(Je,{content:[n]},a))})]})}function Cq(){const{maxWidth:e}=p.useContext(X),t=[{des:"I am honored and proud to write this note for aspirants who dream of pursuing studies in this most vibrant campus. This Krishna Edu Campus, Vadodara started its initial journey in 2003 with 6 constituent schools affiliated with different state Universities and now, metamorphosed to function from 2021 as Drs. Kiran & Pallavi Patel Global University, (KPGU), Vadodara. In the short span, KPGU has achieved a high level of efficiency and progress in all spheres of academics and serves as a beacon of science and technology in the Gujarat region."},{des:'It is worth mentioning here that the University has provided all the essential scientific and educational elements along with state-of-the-art facilities, including modern classrooms, well-equipped laboratories, books and digital resources in the library, and spacious common areas for collaborative work ensuring a conducive learning environment leading towards creativity and innovation. Now, the University has embarked on a new exciting pathway to Global excellence and adopted the "KPGU vision 2040" document to drive our strategic plans for enhanced performance at Global Horizons.'},{des:'KPGU seeks to carve intellectuals through a holistic education that will not only focus on training with knowledge and skills but also ingrain humanitarian values. Hence, we believe that "Education is not meant for learning merely to earn degrees for jobs, but rather to nurture academic growth with global citizenry traits". In the pursuit of academic excellence, our faculty members make efforts to provide appropriate guidance, counseling, and resources to help the students achieve their academic and career goals. Besides, we encourage research activities and students have the opportunity to participate in research. The collaborations with industry, government, and educational institutes provide opportunities for internships, research, and real-world experiences. Overall, KPGU seeks to implement comprehensive quality standards in all aspects of academic spheres, thus reinforcing scientific attitudes among creative students fraternity able cadres to play a major role in the development of society at large.'},{des:"As the founder President of KPGU, Vadodara, I thought to establish Gujarat's first foreign university campus. Now, I feel happy to share that this dream is now on the verge of becoming a reality due to the implementation of the new National Education Policy (NEP) 2020. For the same, KPGU, Vadodara is honored to have the great patronage of Dr. Kiran C. Patel, a distinguished Indian - American philanthropist and a strong proponent of Indo- American initiatives from Tampa, Florida, USA, who has established myriads of centres of academic excellence across the world, including Nova Southeastern University, University of South Florida, Centre for Global Solutions at USA, Patel School, Pallavi Patel Medical College, USA and Centre of Sustainable Development at IIT Gandhinagar through contributions of more than 800 million in charity. India remained at the centre of his active collaboration to establish Dr. Kiran C. Patel Medical College & Research Centre (KMCRI), Bharuch, Gujarat. Now, a top-ranked globally recognized prestigious University collaborating with KPGU, Vadodara to create Gujarat's first foreign university campus. This endeavor will facilitate increased access to our students, thereby ensuring a bright future for all."},{des:"I, therefore, appeal to you to embark on your academic pathway with us and encourage all prospective students to explore the myriad opportunities available. I assure you to support at each step of the path to make your journey a phenomenal success. I wish you all to have a remarkable experience on the academic path at KPGU and look forward to witnessing your academic progress and achievements during your time here."},{des:"With best wishes"}];return r.jsxs(w,{maxWidth:e,mx:"auto",p:"5%",children:[r.jsxs(k,{container:!0,className:"smooth-shadow",borderRadius:3,overflow:"clip",my:5,bgcolor:"#fff",children:[r.jsx(k,{item:!0,xs:12,md:4.7,children:r.jsx(w,{className:"w-100 h-100 ",children:r.jsx("img",{src:"https://res.cloudinary.com/dby2vbxv3/image/upload/v1729238561/KPGU/Images/jagdish-sir-a-671215f81f8a9_bsuf40.webp",className:"w-100 h-100 object-fit-cover",alt:"photo"})})}),r.jsxs(k,{item:!0,xs:12,md:7.3,p:2,children:[r.jsx("h3",{className:"display-5 fw-semibold",children:"Shree Jagdishbhai D. Patel"}),r.jsxs("p",{className:"fs-5 mb-2",children:[r.jsx("b",{children:"Hon’ble Founder President"}),r.jsx("br",{}),"Drs. Kiran & Pallavi Patel Global University (KPGU), Vadodara"]}),r.jsxs("p",{className:"fs-5 mb-2",children:[r.jsx("b",{children:"Hon’ble Founder President & Managing Trustee"}),",",r.jsx("br",{}),"Shree Krishna Educational & Charitable Trust (SKECT), Vadodara (Sponsoring Body of KPGU Vadodara)"]}),r.jsxs("p",{className:"fs-5 mb-2",children:[r.jsx("b",{children:"Hon'ble Founder & CEO"}),",",r.jsx("br",{}),"Dr. Kiran C. Patel Medical College & Research Institute (KMCRI), Bharuch."]})]})]}),r.jsxs(He,{variant:"h6",fontWeight:"600",children:["My Dear Students, ",r.jsx("br",{}),"Warm Greetings from Krishna Edu Campus!!!"]}),r.jsx(w,{mt:4,children:t.map(({des:n},a)=>r.jsx(Je,{content:[n]},a))})]})}function Sq(){const{maxWidth:e}=p.useContext(X),t=[{des:"It is with great pleasure and honor that I serve as the Provost (I/c) of Drs. Kiran and Pallavi Patel Global University (KPGU), Vadodara. I warmly welcome all the students joining us from across the country for our undergraduate and postgraduate programs. Your journey with KPGU marks the beginning of a transformative chapter, where ambition is nurtured, and passion is transformed into profession."},{des:"Since its establishment, KPGU has been steadfast in its mission to create a more equitable society, supported by a world-class, secure campus and an innovative educational framework. Our cutting-edge infrastructure, combined with a range of specialized schools, ensures that we provide an education of the highest quality in science, technology, and health sciences—empowering students to shape their futures with confidence. As we align ourselves with the Vision-2040, we remain dedicated to fostering progress and innovation, instilling in our students a deep-seated drive for excellence in every facet of their academic journey."},{des:"Our programs are rigorously designed and regulated by esteemed bodies such as the UGC, AICTE, PCI, NCISM, INC, and GSCPT, with several schools recognized by the NBA and SSIP. KPGU’s sprawling campus offers a vibrant learning environment, featuring ICT-enabled classrooms, state-of-the-art laboratories, well-stocked libraries, spacious common areas, and separate hostels for boys and girls. These facilities are meticulously crafted to create an ideal setting for intellectual exploration, personal growth, and creative thinking, ensuring that students thrive both academically and socially."},{des:"At KPGU, we are committed to preparing our students to excel in an ever-evolving world. Our programs are dynamic, equipping graduates to meet the demands of industries driven by innovation and technological advancement. Through consistent efforts, we ensure that our students are industry-ready, capable of addressing real-world challenges in health, agriculture, science, and engineering. Beyond academics, the university fosters a rich culture of research and collaboration, supported by extramural/SSIP grants, consultancy work, patent applications, and high-impact publications, all contributing to the advancement of knowledge and innovation."},{des:"I take pride in the unwavering dedication of our faculty, whose expertise and passion for teaching ensure that KPGU remains a leader in higher education, not only within Gujarat but on a global scale. Looking forward, I am confident that KPGU will continue to meet and exceed the challenges of the modern academic landscape. The coming years will be defined by a deep commitment to quality education and pioneering innovation, as we unlock new possibilities for research and discovery, particularly in the pursuit of sustainable development."},{des:"Our vision is clear: KPGU is on the cusp of embracing a multidisciplinary approach to academic excellence, fulfilling its mission to lead in education, research, and outreach. Together, we will inspire the next generation of global citizens and thought leaders, committed to making meaningful contributions to society and the world. I am excited to witness the remarkable achievements of our students and faculty as we continue to strive toward a future of global eminence."}];return r.jsxs(w,{maxWidth:e,mx:"auto",p:"5%",children:[r.jsxs(k,{container:!0,className:"smooth-shadow",borderRadius:3,overflow:"clip",my:5,bgcolor:"#fff",children:[r.jsx(k,{item:!0,xs:12,md:4,height:"300px",children:r.jsx(w,{className:"w-100 h-100 ",children:r.jsx("img",{src:"https://res.cloudinary.com/dby2vbxv3/image/upload/v1703926605/KPGU/Images/a-b-Chaudhary.w