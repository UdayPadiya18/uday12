 of Understanding (MOU) between Krishna School of Physiotherapy & Rehabilitation (KSPR), Vadodara, and various Multispeciality Hospitals of Vadodara, strengthens academic and clinical collaboration. It provides students with invaluable hands-on experience in a clinical setting, bridging the gap between theoretical learning and practical application, while enhancing patient care and fostering professional growth."]}),r.jsx(k,{container:!0,spacing:2,children:o.map(({Address:s,HospitalName:l,mapLink:c},d)=>r.jsx(k,{item:!0,xs:12,sm:6,md:4,children:r.jsxs(w,{className:"smooth-shadow h-100 rounded-4 p-3 position-relative",children:[r.jsx("h4",{className:"color-secondary fw-bold",children:l}),r.jsx("h6",{className:"text-secondary fw-bold mb-5",children:s}),r.jsx($,{variant:"contained",color:"secondary",target:"_blank",size:"small",href:c,sx:{position:"absolute",bottom:16},startIcon:r.jsx(yV,{}),children:"find in maps"})]})},d))})]})})]})}function tY(){const{maxWidth:e,innerWidth:t}=p.useContext(X),[n,a]=p.useState("1"),i=(s,l)=>{a(l)},o=[{name:"Prof. Nimesh D. Chokshi",imgNo:"8777",designation:"Director & Professor",experience:36,qualification:"M.Sc.(Nursing)",customLink:""},{name:"Ms. Yaiphakonbi Contractor",imgNo:"0891",designation:"Associate Professor",experience:13,qualification:"M.Sc.(Nursing)",customLink:"https://res.cloudinary.com/dby2vbxv3/image/upload/v1710235056/KPGU/Faculty%20Images/KSN/0891.webp"},{name:"Ms. Priyanka Aritra Dey",imgNo:"5873",designation:"Assistant Professor",experience:9,qualification:"M.Sc.(Nursing)",customLink:""},{name:"Ms. Chintal Purohit",imgNo:"6174",designation:"Assistant Professor",experience:9,qualification:"M.Sc.(Nursing)",customLink:""},{name:"Ms. Rojlin Tigga",imgNo:"5874",designation:"Assistant Professor",experience:11,qualification:"M.Sc.(Nursing)",customLink:""},{name:"MS. Mitali Solanki",imgNo:"5881",designation:"Assistant Professor",experience:6,qualification:"M.Sc (Nursing)",customLink:""},{name:"MS. Rehmat Dosani",imgNo:"195