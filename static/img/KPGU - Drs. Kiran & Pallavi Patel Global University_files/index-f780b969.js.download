es & values.","To develop good human being possessing scientific temper, compassion, empathy, courage and creative imagination.","To nurture innovative and socially cultured global citizen.","To foster multifaceted excellence in education and research outreach."];return r.jsxs(r.Fragment,{children:[r.jsxs(w,{borderRadius:4,className:"smooth-shadow-card p-3",children:[r.jsx("h2",{className:"fw-bold color-secondary fs-1",children:"Vision"}),r.jsx(Qe,{quote:"KPGU Aspires to be globally acclaimed a value-driven University, recognized for excellence in teaching, research and outreach; promoting access and inclusion; collaborative and innovative culture; and prepare socially responsible global citizens.",right:!0})]}),r.jsxs(w,{mt:7,borderRadius:4,className:"smooth-shadow-card p-3",children:[r.jsx("h2",{className:"fw-bold color-secondary fs-1 mb-4",children:"Mission"}),r.jsx(w,{pl:2,color:"secondary.main",children:e.map((t,n)=>r.jsxs(ce,{direction:"row",mb:1,children:[r.jsx(w,{children:r.jsx(ze,{sx:{fontSize:"25px"}})}),r.jsx(w,{children:r.jsx("h4",{children:t})})]},n))})]})]})}function One(){const{maxWidth:e,innerWidth:t}=p.useContext(X),[n,a]=Pe.useState("1"),i=(o,s)=>{a(s)};return r.jsx(r.Fragment,{children:r.jsx(Ke,{value:n,children:r.jsx(w,{maxWidth:e,mx:"auto",children:r.jsxs(k,{container:!0,px:"3%",mt:7,children:[r.jsx(k,{item:!0,xs:12,md:3,pb:4,children:r.jsx(w,{className:"smooth-shadow",bgcolor:"#fff",p:2,borderRadius:4,position:"sticky",top:0,children:r.jsxs(Ve,{onChange:i,"aria-label":"lab API tabs example",orientation:`${t<900?"horizontal":"vertical"}`,textColor:"secondary",indicatorColor:"secondary",variant:"scrollable",children:[r.jsx(G,{className:"align-items-start fw-bold text-start ",label:"Message From HOD",value:"1"}),r.jsx(G,{className:"align-items-start fw-bold text-start ",label:"About Department",value:"2"}),r.jsx(G,{className:"align-items-start fw-bold text-start ",label:"Vision And Mission",value:"3"}),r.jsx(G,{className:"align-items-start fw-bold text-start ",label:"Laboratories",value:"5"}),r.jsx(G,{className:"align-items-start fw-bold text-start ",label:"Faculty",value:"7"})]})})}),r.jsx(k,{item:!0,xs:12,md:9,pl:t<900?"0":4,children:r.jsxs(w,{className:"smooth-shadow",bgcolor:"#fff",borderRadius:4,children:[r.jsx(W,{value:"1",children:r.jsx(Ine,{})}),r.jsx(W,{value:"2",children:r.jsx(Mne,{})}),r.jsx(W,{value:"3",children:r.jsx(Lne,{})}),r.jsx(W,{value:"5",children:r.jsx(Rne,{})}),r.jsx(W,{value:"6",children:r.jsx(Dne,{})}),r.jsx(W,{value:"7",children:r.jsx(_ne,{})})]})})]})})})})}function Kne(){return p.useContext(X),r.jsx(r.Fragment,{children:r.jsx(In,{hodImg:"https://res.cloudinary.com/dby2vbxv3/image/upload/v1709635905/KPGU/Faculty%20Images/KSET/hod-ee.webp",hodEmail:"hod.ee.kset@kpgu.ac.in",hodName:"Dr. Samir H. Patel",hodOf:" Electrical Engineering",hodOfShort:"[KSET]",hodMessage:["It is my pleasure and honor to welcome you all to the Department of Electrical Engineering at Drs. Kiran & Pallavi Patel Global University, Vadodara, Gujarat, India. Since its inception in 2004, the Krishna Edu Campus has been a premiere engineering institute in Gujarat. The Electrical Engineering department is an integral part of the institute right from the day of commencement. The Electrical Engineering is an evergreen branch of engineering offering white collar profession.","An Electrical Engineer is an all-rounder required in all the industries, PSUs, Urban or Rural administrative agencies. The branch is one of the most popular for those seeking the government jobs. The latest trends in EV, Battery technologies, Solar, Wind, Industrial Automation, Robotics are offering excellent opportunities to an Electrical Engineer in addition to old and ever popular career options. This has resulted in the department boasting highly proficient electrical engineers among its alumni who are contributing towards building a brighter future for our society and nation."]})})}function Gne(){return r.jsxs(w,{borderRadius:4,children:[r.jsx("h2",{className:"text-uppercase fw-bold color-secondary mb-4",children:"About Department"}),r.jsx(Je,{content:["The Department of Electrical Engineering of the Krishna School of Emerging Technology and Applied Research (KSET), KPGU Vadodara came into existence in the year 2023. The department has qualified and dedicated faculty members from NITs and other premier Institutes. The department is conducting P.G. program in Electrical Engineering Faculties of the department encourage students for practical learning through their projects and dissertations."]})]})}function Une(){const{maxWidth:e}=p.useContext(X),t=[{name:"Dr. Samir H. Patel",imgNo:"6013",designation:"Associate Professor || Head",experience:14,qualification:"Ph.D. || M.E. [Power System] || B.E. [Electrical]",customLink:""},{name:"Mr. Ketul Kachhia",imgNo:"6192",designation:"Assistant Professor",experience:11,qualification:"Ph.D. [Pursuing] || M.Tech. [Power System] || MBA[MARKETING] || B.E. [ELECTRICAL]",customLink:""},{name:"Mr. Vijay Bharat Desle",imgNo:"6015",designation:"Assistant Professor",experience:10,qualification:"Ph.D. [Pursuing] || M.Tech. [Electrical Power Systems] || B.Tech. [Electrical]",customLink:""},{name:"Mr. Divyesh Vasava",imgNo:"",designation:"Assistant Professor",experience:3,qualification:"M.Tech. [Power System] || B.E. [ELECTRICAL]",customLink:"https://res.cloudinary.com/dby2vbxv3/image/upload/v1710303212/KPGU/Faculty%20Images/KSET/0880.webp"},{name:"Ms. Jasminbanu Mansuri",imgNo:"",designation:"Assistant Professor",experience:5,qualification:"M.Tech. [Power System] || B.E. [ELECTRICAL]",customLink:"https://res.cloudinary.com/dby2vbxv3/image/upload/v1726564420/KPGU/Faculty%20Images/KSET/ms-jasmin-mansuri-66e9480adf503_b5cpd9.webp"}];return r.jsx(w,{maxWidth:e,mx:"auto",bgcolor:"#fff",borderRadius:4,children:r.jsx(k,{container:!0,spacing:2,children:t.map(({name:n,designation:a,experience:i,qualification:o,imgNo:s,customLink:l},c)=>r.jsx(Qt,{name:n,qualification:o,designation:a,experience:i,facultyName:"KSET",imgNo:s,MainLink:"https://res.cloudinary.com/dby2vbxv3/image/upload/v1707801651/KPGU/Faculty%20Images/",customLink:l,insideTab:!0},c))})})}function Bne(){const e=["To develop excellent technical skills in students ","To be inclined towards entrepreneurship, research, and innovation. ","To instill professional ethics and human values in graduates who are  committed to improving society"];return r.jsxs(r.Fragment,{children:[r.jsxs(w,{borderRadius:4,className:"smooth-shadow-card p-3",textAlign:"justify",children:[r.jsx("h2",{className:"fw-bold color-secondary fs-1",children:"Vision"}),r.jsx(Qe,{quote:"To produce Electrical Engineering graduates with world-class technical skills, capable of contributing as industry experts, entrepreneurs, and researchers",right:!0})]}),r.jsxs(w,{mt:7,borderRadius:4,className:"smooth-shadow-card p-3",children:[r.jsx("h2",{className:"fw-bold color-secondary fs-1 mb-4",children:"Mission"}),r.jsx(w,{pl:2,color:"secondary.main",children:e.map((t,n)=>r.jsxs(ce,{direction:"row",mb:1,textAlign:"justify",children:[r.jsx(w,{children:r.jsx(ze,{sx:{fontSize:"25px"}})}),r.jsx(w,{children:r.jsx("h4",{children:t})})]},n))})]})]})}function Fne(){const e=[{title:"MATLAB"},{title:"Mi Power"},{title:"Proteus"},{title:"P-Sim 9.1"},{title:"SCILAB"}],t=({title:n})=>r.jsx(k,{item:!0,xs:12,sm:6,md:4,children:r.jsx(w,{className:"smooth-shadow-card h-100",borderRadius:4,overflow:"hidden",children:r.jsx(w,{p:2,children:r.jsx("h4",{className:"fw-bold color-secondary mb-0",children:n})})})});return r.jsx(r.Fragment,{children:r.jsxs(w,{borderRadius:4,children:[r.jsx("h2",{className:"fw-bold color-secondary fs-1 mb-4",children:"Software Labs"}),r.jsx(k,{container:!0,spacing:2,children:e.map(({title:n},a)=>r.jsx(t,{title:n},a))})]})})}function $ne(){const e=[{title:"Distributed Generation System"},{title:"Renewable Energy"},{title:"Restructured Power System"},{title:"Power Electronics & Drives"},{title:"Power System Operation & Control"},{title:"Power System Planning & Reliability"},{title:"Smart Grid"}],t=({title:n})=>r.jsx(k,{item:!0,xs:12,sm:6,md:6,children:r.jsx(w,{className:"smooth-shadow-card h-100",borderRadius:4,overflow:"hidden",children:r.jsx(w,{p:2,children:r.jsx("h4",{className:"fw-bold color-secondary mb-0",children:n})})})});return r.jsx(r.Fragment,{children:r.jsxs(w,{borderRadius:4,children:[r.jsx("h2",{className:"fw-bold color-secondary fs-1 mb-4",children:"Research Areas"}),r.jsx(k,{container:!0,spacing:4,children:e.map(({title:n,img:a,des:i},o)=>r.jsx(t,{title:n},o))})]})})}function zne(){const e=[{title:"POWER ELECTRONICS LAB",des:["To enable students, understand the operation of semiconductor devices and power electronics converters, the laboratory is equipped with experimental set-ups where students are exposed to design-based experiments. The laboratory also enables students to carry out UG projects effectively.","Thyristor converters, DC chopper modules, power devices such as Thyristors, Power MOSFETs, IGBTs of various voltage and current ratings, Opto-Isolators, Pulse transformers and other related commutating components are there in the laboratory.","A Number of modules of AC-DC converters, voltage controllers – single phase as well as three phase, DC chopper units and inverters using Power MOSFETs and IGBTs, solid state soft start units for three phase induction motors have been built in the last five years as project works of UG students."],img:"https://res.cloudinary.com/dby2vbxv3/image/upload/v1721902959/KPGU/Images/Labs/KSET-Electrical-Engineering/power-electronics-lab-kset-and-ksds-11-37-66a227220bda4_yqguwx.webp"},{title:"ELECTRICAL MEASUREMENT AND INSTRUMENTATION LABORATORY",des:["This is the lab which is very important for the basic knowledge about the various instruments with facilities for the group of 20 students to carry out experiments independently.","The lab is equipped with latest technologies in electrical measurement and instrumentation such as Kelvin Bridges, Wheatstone’s bridges, energy meters, digital multi meters, etc. It ensures that the students become experts in practical knowledge related to electrical measurement process under the guidance of faculty members from the Department of Electrical Engineering. The lab is well equipped and enables students to understand the fundamentals of various measuring instruments.","Major Equipment in Measurement and instrumentation Lab areLVDT(Linear Variable differential transformer), Thermocouple, pressure gauge, Resistance strain gauge etc."],img:"https://res.cloudinary.com/dby2vbxv3/image/upload/v1721902960/KPGU/Images/Labs/KSET-Electrical-Engineering/electrical-measurement-and-instrumentation-laboratory-kset-and-ksds-2-38-66a227195697b_cjhizr.webp"},{title:"HIGH VOLTAGE ENGINEERING LABORATORY",des:["A state-of-the-art laboratory is designed to provide platform for basic studies. It offers testing facilities for the power apparatus insulators. This laboratory helps students to understand the various aspects of insulation and phenomenon like lightning and surges in electrical power system.",""],img:"https://res.cloudinary.com/dby2vbxv3/image/upload/v1721902960/KPGU/Images/Labs/KSET-Electrical-Engineering/high-voltage-engineering-laboratory-kset-and-ksds-10-42-66a2271d837b2_gfy5fi.webp"},{title:"POWER SYSTEM PROTECTION LABORATORY",des:["A protection laboratory equipped with number of relays including numerical relays for transformer, and motor protection has been developed. This laboratory is useful to the students of UG in getting up-to-date knowledge of the working of various types of relays by actual demonstration on in-house designed panels."],img:"https://res.cloudinary.com/dby2vbxv3/image/upload/v1721902959/KPGU/Images/Labs/KSET-Electrical-Engineering/power-system-protection-laboratory-kset-and-ksds-12-41-66a22725b7d7a_tknj51.webp"},{title:"ELECTRICAL WORKSHOP LAB",des:["The workshop is used for course introduction to electrical engineering. Here the students are given hands on training in electrical wirings. They are given a basic idea about the operation and power consumption of certain electrical appliances such are mixtures, iron box, pumps, fan etc. Students are familiarized with supply arrangements and their limitations, knowledge of standard voltages and their tolerances, safety aspects of electrical systems and importance of protective measures in wiring systems, knowledge about the types of wires, cables and other accessories used in wiring. Students are able to wire simple lighting circuits for domestic buildings and distinguish between light and power circuits and to measure electrical circuit parameters and current, voltage and power in a circuit."],img:"https://res.cloudinary.com/dby2vbxv3/image/upload/v1721902959/KPGU/Images/Labs/KSET-Electrical-Engineering/electrical-workshop-lab-kset-and-ksds-11-35-66a22719deb85_h8kgme.webp"},{title:"MICROPROCESSOR LABORATORY",des:["This laboratory will introduce students to get familiar with the architecture and basic operations of micro controller and microprocessor. It provides in-depth knowledge of Software and hardware experiments with a microprocessor and controller system. It also deals with assembly language programming, simple input/output interfacing, and interrupt processing in microprocessor and micro controller systems."],img:"https://res.cloudinary.com/dby2vbxv3/image/upload/v1721902959/KPGU/Images/Labs/KSET-Electrical-Engineering/microprocessor-laboratory-kset-and-ksds-4-39-66a22721c32f1_p0rcua.webp"},{title:"Machines Lab",des:["The Machines Lab in the Electrical Engineering Department at Krishna School of Diploma Studies is equipped with advanced machinery and tools essential for hands-on learning and experimentation. The lab features a wide range of electrical machines  allowing students to gain practical experience in operating, testing, and analyzing these machines. The lab's infrastructure is designed to simulate real-world industrial scenarios, helping students understand the principles of electromagnetism, power generation, and electrical drives. With modern equipment and dedicated faculty support, the Machines Lab ensures that students develop strong technical skills and a deeper understanding of electrical engineering concepts."],img:"https://res.cloudinary.com/dby2vbxv3/image/upload/v1721902961/KPGU/Images/Labs/KSET-Electrical-Engineering/electrical-machine-lab-kset-and-ksds-7-36-66a2271593fae_coxmao.webp"}],t=({title:n,img:a,des:i})=>r.jsx(k,{item:!0,xs:12,sm:6,children:r.jsxs(w,{className:"smooth-shadow-card h-100",borderRadius:4,overflow:"hidden",children:[r.jsx(w,{children:r.jsx("img",{src:a,className:"w-100",alt:""})}),r.jsxs(w,{p:2,children:[r.jsx("h4",{className:"fw-bold color-secondary",children:n}),i.map(o=>r.jsx("h6",{className:"fw-bold text-secondary mb-3",children:o}))]})]})});return r.jsx(r.Fragment,{children:r.jsxs(w,{borderRadius:4,children:[r.jsx("h2",{className:"fw-bold color-secondary fs-1 mb-4",children:"Electrical Machines  Labs"}),r.jsx(k,{container:!0,spacing:2,children:e.map(({title:n,des:a,img:i},o)=>r.jsx(t,{title:n,des:a,img:i},o))})]})})}function Vne(){const e=[{title:"Power Electronics and Drives",img:"https://res.cloudinary.com/dby2vbxv3/image/upload/v1729322431/KPGU/Images/Institutions/KST/power-electronics-and-drives-67135d4d53d68_newx3a.webp"},{title:"Robotics & Automation",img:"https://res.cloudinary.com/dby2vbxv3/image/upload/v1729323670/KPGU/Images/Institutions/KST/Robotics_Automation_gtr5d9.webp"},{title:"Electric and Hybrid Vehicles",img:"https://res.cloudinary.com/dby2vbxv3/image/upload/v1729323853/KPGU/Images/Institutions/KST/Electric_and_Hybrid_Vehicles_kii90x.webp"}],t=({title:n,img:a})=>r.jsx(k,{item:!0,xs:12,sm:6,md:6,children:r.jsxs(w,{className:"smooth-shadow-card h-100",borderRadius:4,overflow:"hidden",children:[r.jsx(w,{children:r.jsx("img",{src:a,alt:"",className:"w-100"})}),r.jsx(w,{p:2,children:r.jsx("h4",{className:"fw-bold color-secondary",children:n})})]})});return r.jsxs(w,{borderRadius:4,children:[r.jsx("h2",{className:"fw-bold color-secondary fs-1 mb-4",children:"Honors - Minors Offered Broadly"}),r.jsx(k,{container:!0,spacing:4,children:e.map(({title:n,img:a},i)=>r.jsx(t,{img:a,title:n},i))})]})}function Hne(){const{maxWidth:e,innerWidth:t}=p.useContext(X),[n,a]=Pe.useState("1"),i=(o,s)=>{a(s)};return r.jsx(r.Fragment,{children:r.jsx(Ke,{value:n,children:r.jsx(w,{maxWidth:e,mx:"auto",children:r.jsxs(k,{container:!0,px:"3%",mt:7,children:[r.jsx(k,{item:!0,xs:12,md:3,pb:4,children:r.jsx(w,{className:"smooth-shadow",bgcolor:"#fff",p:2,borderRadius:4,position:"sticky",top:0,children:r.jsxs(Ve,{onChange:i,"aria-label":"lab API tabs example",orientation:`${t<900?"horizontal":"vertical"}`,textColor:"secondary",indicatorColor:"secondary",variant:"scrollable",children:[r.jsx(G,{className:"align-items-start fw-bold text-start ",label:"Message From HOD",value:"1"}),r.jsx(G,{className:"align-items-start fw-bold text-start ",label:"About Department",value:"2"}),r.jsx(G,{className:"align-items-start fw-bold text-start ",label:"Vision And Mission",value:"3"}),r.jsx(G,{className:"align-items-start fw-bold text-start ",label:"Honors Minors Broadly",value:"4"}),r.jsx(G,{className:"align-items-start fw-bold text-start ",label:"SOFTWARE LAB",value:"5"}),r.jsx(G,{className:"align-items-start fw-bold text-start ",label:"LABORATORIES",value:"6"}),r.jsx(G,{className:"align-items-start fw-bold text-start ",label:"Research Areas",value:"7"}),r.jsx(G,{className:"align-items-start fw-bold text-start ",label:"Faculty",value:"8"})]})})}),r.jsx(k,{item:!0,xs:12,md:9,pl:t<900?"0":4,children:r.jsxs(w,{className:"smooth-shadow",bgcolor:"#fff",borderRadius:4,children:[r.jsx(W,{value:"1",children:r.jsx(Kne,{})}),r.jsx(W,{value:"2",children:r.jsx(Gne,{})}),r.jsx(W,{value:"3",children:r.jsx(Bne,{})}),r.jsx(W,{value:"4",children:r.jsx(Vne,{})}),r.jsx(W,{value:"5",children:r.jsx(Fne,{})}),r.jsx(W,{value:"6",children:r.jsx(zne,{})}),r.jsx(W,{value:"7",children:r.jsx($ne,{})}),r.jsx(W,{value:"8",children:r.jsx(Une,{})})]})})]})})})})}function Wne(){return p.useContext(X),r.jsx(r.Fragment,{children:r.jsx(In,{hodImg:"https://res.cloudinary.com/dby2vbxv3/image/upload/v1709635524/KPGU/Faculty%20Images/KSET/hod-it.webp",hodEmail:"hod.it.kset@kpgu.ac.in",hodName:"Dr. Nandini M. Chaudhari",hodOf:"Information Technology",hodOfShort:"[KSET]",hodMessage:["Department of Information Technology has started its journey from 2021 with intake of 60 students, The objective of IT department is imparting knowledge in cutting-edge technologies in Information Technology.","We take tremendous pride in our academic excellence; The Department has a team of dynamic, young and dedicated staff, with specialization in wide array of areas. Our faculty members are known for blending advanced theories with practical Engineering applications. We continue to strive to meet our mission.","In order to ensure the quality education, We provide the continuous learning approach and research for the students. As the department, we use project-based learning, case-based learning, expert talks and capstone projects for the learning process for the students. Accordingly, measures are taken to keep the students busy throughout the course. The periodically updated curriculum imparts technical knowledge to the students and the application based environment in the state of the art laboratories.","The department collaborate with the industry through the industrial visits and hands on practical sessions so that the students gain the experience with the different technologies used in the industry. The Department not only to make the students IT professionals, but also to groom them as kind citizens of the society, who are going to be the inspiration for future generations.","It will be our responsibility to provide you with excellent education, we expect from you to work hard and run that extra mile to achieve your grand academic and personal success.","Please feel free to contact us on official email address provided on website.","Thank you for visiting us"]})})}function qne(){const e=[{title:"Network Security"},{title:"Big Data Analytics"},{title:"Cloud Computing"},{title:"Internet of Things"},{title:"Artificial Intelligence"},{title:"Machine learning"},{title:"Data Science"}],t=({title:n})=>r.jsx(k,{item:!0,xs:12,sm:6,md:4,children:r.jsx(w,{className:"smooth-shadow-card h-100",borderRadius:4,overflow:"hidden",children:r.jsx(w,{p:2,children:r.jsx("h5",{className:"fw-bold color-secondary",children:n})})})});return r.jsxs(w,{borderRadius:4,children:[r.jsx("h2",{className:"text-uppercase fw-bold color-secondary mb-4",children:"About Department"}),r.jsx(Je,{content:["The Department of IT Information Technology was established in the year 2020 with the objective of imparting knowledge in cutting-edge technologies in Information Technology.","After creating successful computer professionals from the last 17 years at Babaria Institute of Technology we now entered into the education of Information Technology under our Global University.","The Department has a team of dynamic, young and dedicated staff, with specialization in a wide array of areas. The Department has well equipped laboratories with Computer Systems and facilities that are vital to train the students in state-of-art software and hardware. The Department always strives to reach the latest technology and advancement in this field to the young learners as well as aspirants by inviting the corporate legends and experienced academicians to enlighten the IT community of our institution. The department supports the self-learning capability of the students through its rich core competencies"]}),r.jsx(k,{container:!0,spacing:2,children:e.map(({title:n},a)=>r.jsx(t,{title:n},a))})]})}function Yne(){const e=[{title:"Cyber Security",img:"https://res.cloudinary.com/dby2vbxv3/image/upload/v1708579016/KPGU/Images/Institutions/KSET/cyber-security.webp"},{title:"Artificial Intelligence & Mac