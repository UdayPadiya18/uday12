,{title:"Krishna School of Diploma Studies [KSDS]"}),r.jsx(vr,{dirImg:"https://res.cloudinary.com/dby2vbxv3/image/upload/v1709633320/KPGU/Faculty%20Images/KSDS/dir-img.webp",dirEmail:"dir.ksds@kpgu.ac.in",dirName:"Dr. Dattesh Y. Joshi",dirOf:"Krishna School of Diploma Studies",dirOfShort:"[KSDS]",dirMessage:["Welcome to the esteemed Krishna School of Diploma Studies (KSDS) at Drs. Kiran & Pallavi Patel Global University (KPGU), Vadodara. As the Director, I am honoured to lead our dedicated team in fostering academic excellence and innovation.","Our holistic approach to learning imparts technical knowledge alongside critical thinking and problem-solving skills. Our experienced faculty ensures students are well-equipped for the dynamic engineering landscape.","Through cutting-edge curricula, labs, and industry collaborations, we offer a transformative educational experience that prepares students for leadership roles.","Committed to values of integrity and inclusivity, we provide a diverse and respectful environment. Our website showcases programs, faculty, research, and campus life.","Whether you’re a student, parent, industry partner, or academician, we look forward to your engagement with us.","Thank you for considering Krishna School of Diploma Studies (KSDS), Drs. Kiran & Pallavi Patel Global University (KPGU), Vadodara as your educational destination. Join us on a journey of knowledge and excellence."]})]})}),r.jsx("div",{style:{padding:"40px 0 0 0"},id:"department",children:r.jsxs(w,{maxWidth:e,mx:"auto",p:"3%",bgcolor:"#fff",borderRadius:4,className:"smooth-shadow",children:[r.jsx("h2",{className:"fw-bold color-secondary mb-4",children:"Department"}),r.jsx(k,{container:!0,spacing:4,children:s.map(({img:c,name:d,link:u},h)=>r.jsx(l,{img:c,name:d,link:u},h))})]})}),r.jsx("div",{style:{padding:"40px 0 0 0"},id:"program",children:r.jsx(Br,{Programs:Fq.Programs})}),r.jsx("div",{style:{padding:"40px 0 0 0"},id:"announcements"})]})}function oY(){const{maxWidth:e}=p.useContext(X),t=xt(),[n,a]=p.useState("1"),i=(d,u)=>{a(u)},o=["Published 75+ research papers in the SCOPUS Indexed and, UGC-CARE listed journals in last 4 years.","Published more then seven books and thirteen book chapters.","Organized international seminar on &quot;Opportunities Emerging Around Artificial Intelligence&quot; on 23 January, 2024 by department of CSE/IT and Expert sessions led by resource person from from Australia and an AI specialist from GTU (Gujarat Technological University) .","Project on Hand Gesture Control Developed by students of IT Department Mr. Sahaj Katariya and Ohm Mewada selected in the final round for Devang Mehta IT Award , 2024.","Organized seminar on “EV Charging Infrastructure” by department of Electrical and Mechanical Engineering on 30/09/2024 supported by Tecso Chargezone Ltd, Vadodara","Awarded SHODH-Financial Aid to Ms. Deepshikha Agrawal, Ph.D. research scholar , KPGU under the guidance of Dr. Nandini Chaudhari, for research in Quantum Computing since October-2023.","Organized workshop on “IOT and its applications” by IT department on 22-23 September , 2023","Organized FDP on &quot;AI/ML/CV/IOT/SAP/ABAP&quot; by CSE/IT department in association with Edu Net Foundation on 23-28 November 2023","A Team Elite of IT department under got selected in the grand finale of Smart India Hackathon 2022 launched by AICTE and the Ministry of Education Innovation cell."],s=[{img:"https://res.cloudinary.com/dby2vbxv3/image/upload/v1708498523/KPGU/icon/comuter-science.svg",name:"COMPUTER SCIENCE & ENGINEERING",link:"/academics/kset/computer-science-and-engineering"},{img:"https://res.cloudinary.com/dby2vbxv3/image/upload/v1708498523/KPGU/icon/infromation-tech.svg",name:"information technology",link:"/academics/kset/information-technology"},{img:"https://res.cloudinary.com/dby2vbxv3/image/upload/v1708498523/KPGU/icon/electrical-engineering.svg",name:"electrical engineering",link:"/academics/kset/electrical-engineering"},{img:"https://res.cloudinary.com/dby2vbxv3/image/upload/v1708498523/KPGU/icon/mechanics.svg",name:"mechanical engineering",link:"/academics/kset/mechanical-engineering"},{img:"https://res.cloudinary.com/dby2vbxv3/image/upload/v1708498523/KPGU/icon/civil.svg",name:"civil engineering",link:"/academics/kset/civil-engineering"}],l=[{title:"One-Day Seminar on EV Charging Infrastructure",des:"The One-Day Seminar on EV Charging Infrastructure, organized by Tecso Charge Pvt Ltd in collaboration with KSET, took place on September 30, 2023. The seminar was designed to provide valuable insights into the world of Electric Vehicle (EV) charging infrastructure and its prospects.",date:"30/09/2024",img:"https://res.cloudinary.com/dby2vbxv3/image/upload/v1731488757/KPGU/Events/KSET/One-Day_Seminar_on_EV_Charging_Infrastructure_ahmpfy.png"},{title:"Engineer’s Day Celebration 2024",des:"Engineer's Day is celebrated every year in recognition of engineer’s invaluable role in shaping our modern world, KSET had organized various technical competition to enhance and innovate the technical skills of the students.",date:"18/09/2024",img:"https://res.cloudinary.com/dby2vbxv3/image/upload/v1731491076/KPGU/Events/KSET/Engineer_s_Day_Celebration_2024_tk4sqq.png"},{title:"Internal Smart India Hackathon 2024",des:"The internal Hackathon was organized on 6th Sept. 2024 for students of Faculty of Engineering & Technology, the objective of this internal hackathon was to foster innovation and provide students with an opportunity to present their technical and problem-solving skills, while selecting the best teams to represent KPGU at the SIH 2024.",date:"06/09/2024",img:"https://res.cloudinary.com/dby2vbxv3/image/upload/v1731488757/KPGU/Events/KSET/Internal_Smart_India_Hackathon_2024_ft7kzd.jpg"},{title:"IBM’s Student Developer Program-Learning Session",des:"Departments of CSE/IT & Industry-Academia Cell KSET organized exclusive sessions to introduce students to the latest advancements in Artificial Intelligence (AI), Generative AI (GenAI), and data science, using IBM's watsonx platform with hands-on experience and knowledge to help students become future developers, equipped with valuable industry-recognized credentials.",date:"05/09/2024",img:"https://res.cloudinary.com/dby2vbxv3/image/upload/v1731488759/KPGU/Events/KSET/IBM_s_Student_Developer_Program-Learning_Session_xvzudi.png"},{title:"Participation in Smart India Hackathon 2022 (Banglore)",des:"One team from the IT department got selected in the grand finale of Smart India Hackthon 2022 launched by AICTE and the Ministry of Education Innovation cell . Smart India Hackathon (SIH) 2022 is a prestigious nationwide event that brings together some of India's brightest minds in technology and innovation. Organized by the Ministry of Education, Government of India, along with All India Council for Technical Education (AICTE)",date:"25/08/2024",img:"https://res.cloudinary.com/dby2vbxv3/image/upload/v1731488764/KPGU/Events/KSET/Participation_in_Smart_India_Hackathon_2022_Banglore_rzi2x5.png"},{title:"Industrial Visit IGTR (Indo German Tool Room, Ahmedabad)",des:"Industrial visit for 3rd & 5th semester, Mechanical engineering students on 12th August 2023 was conducted to improve students practical knowledge and get benefited in their respective theoretical knowledge at  IGTR, Ahmedabad (Indo German Tool Room).",date:"12/08/2024",img:"https://res.cloudinary.com/dby2vbxv3/image/upload/v1731491662/KPGU/Events/KSET/Industrial_Visit_IGTR_Indo_German_Tool_Room_Ahmedabad_rabigf.jpg"},{title:"Participation in Project competition at Devenag Mehta IT Award 2024",des:"An innovative project from the Department of Information Technology has been selected for the prestigious Devenag Mehta IT Award 2024 - in the final round! Project title was Hand Gesture Control Developed by Sahaj Kathiriya and Ohm Mewada under guidance of Dr. Nandini Chaudhari (HOD IT).",date:"09/08/2024",img:"https://res.cloudinary.com/dby2vbxv3/image/upload/v1731488769/KPGU/Events/KSET/Participation_in_Project_competition_at_Devenag_Mehta_IT_Award_2024_wq2oca.jpg"},{title:"Freelancing Session & WordPress Workshop",des:"Department of CSE had arranged a expert lecture to provide participants with a deep understanding of Wordpress and Freelancing, equipping them with the knowledge and insights necessary to leverage these technologies effectively in educational settings.",date:"07/08/2024",img:"https://res.cloudinary.com/dby2vbxv3/image/upload/v1731490979/KPGU/Events/KSET/Freelancing_Session_WordPress_Workshop_ehr9xe.jpg"},{title:"An Orientation Program for Batch 2024-25” (B. Tech)",des:"The objective of an orientation program for new B Tech CSE/IT/CE students at Drs. Kiran & Pallavi Patel University is to provide a comprehensive introduction to the academic and social environment of the university. The program aims to facilitate a smooth transition for students into university life and to equip them with the necessary tools and information to succeed.",date:"22/07/2024",img:"https://res.cloudinary.com/dby2vbxv3/image/upload/v1731488757/KPGU/Events/KSET/An_Orientation_Program_for_Batch_2024-25_B._Tech_fsfuvm.jpg"},{title:"Farewell 2024",des:"Farewell was organized to honor and appreciate the contributions of departing members, reflect on shared experiences, and provide a platform for everyone to express gratitude, build lasting memories, and wish the outgoing individuals success and happiness in their future endeavors. It also fosters a sense of closure while celebrating the transitions ahead.",date:"31/05/2024",img:"https://res.cloudinary.com/dby2vbxv3/image/upload/v1731491424/KPGU/Events/KSET/Farewell_2024_xzd8vh.jpg"},{title:"An Orientation Program on Software Development live project work opportunities by Vadodara Fire & Emergency Service by VMC",des:"The Vadodara Fire & Emergency Service (VFES) by VMC recently conducted an orientation and Q&A session for Pre-final year CSE/ IT students to provide guidance on project modules related to emergency services on 20th May,2024. This initiative aims to bridge the gap between academic knowledge and practical application, preparing students for real-world challenges in IT and public safety sectors.",date:"20/05/2024",img:"https://res.cloudinary.com/dby2vbxv3/image/upload/v1731488758/KPGU/Events/KSET/an_Orientation_Program_on_Software_Development_live_project_work_opportunities_by_Vadodara_Fire_Emergency_Service_by_VMC_mjlm1f.jpg"},{title:"A seminar on Introduction to Git, GitHub, and Open-Source Workshop (Student’s Club)",des:"On 11-04-2024, the GDSC club organized this workshop on developing the projects on Git and GitHub which was conducted by expert speaker Mr. Vandit Pandya-Azure Developer Lead, Cloud Native Vadodara Organizer, Beta MLSA. There were 52 students participated in this workshop.",date:"11/04/2024",img:"https://res.cloudinary.com/dby2vbxv3/image/upload/v1731488758/KPGU/Events/KSET/A_seminar_on_Introduction_to_Git_GitHub_and_Open-Source_Workshop_Student_s_Club_agpo4j.jpg"},{title:"Two days’ workshop on ‘Lean Six Sigma for efficiency and sustainability improvement’",des:"Mechanical engineering department organized a two days’ workshop on ‘Lean Six Sigma for efficiency and sustainability improvement’ on 1st and 2nd April 2022. The workshop was focused on various concept, tools and techniques of continuous improvement in quality management by systematically removing eight kinds of waste like Transportation, Inventory, Motion, Waiting, Over-production, over-processing, delay and non- utilized manpower, and achieve process optimization, quality improvement and provide a framework for overall organizational culture change.",date:"01/04/2024 to 02/04/2024",img:"https://res.cloudinary.com/dby2vbxv3/image/upload/v1731491534/KPGU/Events/KSET/Two_days_workshop_on_Lean_Six_Sigma_for_efficiency_and_sustainability_improvement_uohtf5.jpg"},{title:"Awareness program on research papers writing",des:'This Awareness program held on 30th March 2024 on "Research Paper: part 1 Basics" has been designed with a set of clear objectives to facilitate a comprehensive exploration of the surrounding Research. Mainly focused on Research paper writing including Plagiarism checking and searching reputed journals.',date:"30/03/2024",img:"https://res.cloudinary.com/dby2vbxv3/image/upload/v1731488760/KPGU/Events/KSET/Awareness_program_on_research_papers_writing_yefofn.jpg"},{title:"Opportunities Emerging Around Artificial Intelligence (International Seminar)",des:'An international seminar titled "Opportunities Emerging Around Artificial Intelligence" was held by KSET on January 23, 2024. Experts from Australia and an AI specialist from GTU led the expert sessions.',date:"23/01/2024",img:"https://res.cloudinary.com/dby2vbxv3/image/upload/v1731488772/KPGU/Events/KSET/Opportunities_Emerging_Around_Artificial_Intelligence_International_Seminar_cwglre.jpg"},{title:"IOT Workshop",des:"A 2 days’ workshop on Internet of Things has been organized by the IT department to keep students up to date on new upcoming technologies to create smart environment on 22 September 2023.",date:"22/09/2023",img:"https://res.cloudinary.com/dby2vbxv3/image/upload/v1731488767/KPGU/Events/KSET/IOT_Workshop_jnm5fe.jpg"},{title:"Reel Making competition on Engineer’ Day",des:"To enhance the creativity of the students , Capturing the event of Engineers Day and making reels for competition has organized by Our Aakriti, Edison Thomson Club of IT Department.",date:"18/09/2023",img:"https://res.cloudinary.com/dby2vbxv3/image/upload/v1731489292/KPGU/Events/KSET/Reel_Making_competition_on_Engineer_Day_furaom.jpg"},{title:"IOT Project Competition",des:"The competition on IOT applications for CSE and IT students was organized on 23rd September 2023 to create a competitive environment for the students.",date:"22/09/2023",img:"https://res.cloudinary.com/dby2vbxv3/image/upload/v1731488765/KPGU/Events/KSET/IOT_Project_Competition_khonka.jpg"},{title:"Cyber Crime Awareness Program (Suraksha Setu Society)",des:"This awareness training equips everyone with the knowledge and skills to recognize and respond to common cyber threats, reducing the likelihood of data breaches caused by human error or negligence.",date:"06/02/2024",img:"https://res.cloudinary.com/dby2vbxv3/image/upload/v1731488758/KPGU/Events/KSET/Cyber_Crime_Awareness_Program_Suraksha_Setu_Society_bg4ni5.png"}],c=({name:d,img:u,link:h})=>r.jsx(k,{item:!0,xs:12,sm:6,md:4,children:r.jsx(w,{className:"smooth-shadow-card department-card",p:2,borderRadius:4,onClick:()=>t(h),children:r.jsxs(k,{container:!0,spacing:2,alignItems:"center",children:[r.jsx(k,{item:!0,xs:12,sm:12,md:3,children:r.jsx("img",{src:u,alt:"",className:"w-100 d-block mx-auto",style:{maxWidth:"120px"}})}),r.jsxs(k,{item:!0,xs:12,sm:12,md:9,textTransform:"uppercase",textAlign:{xs:"center",md:"start"},children:[r.jsx("h5",{className:"mb-0 fw-bold ",children:"Department of "}),r.jsx("h5",{children:d})]})]})})});return r.jsxs(r.Fragment,{children:[r.jsx(Ke,{value:n,children:r.jsx(w,{className:"smooth-shadow",bgcolor:"rgba(256, 256, 256, 0.6)",sx:{backdropFilter:"blur(10px)"},p:2,borderRadius:4,mt:7,position:"sticky",top:0,maxWidth:e,mx:"auto",zIndex:99999999,children:r.jsxs(Ve,{onChange:i,"aria-label":"lab API tabs example",orientation:"horizontal",textColor:"secondary",indicatorColor:"secondary",variant:"scrollable",children:[r.jsx(G,{className:"align-items-start fw-bold text-start  fs-5",label:"Message From Director",value:"1",href:"#director-message"}),r.jsx(G,{className:"align-items-start fw-bold text-start  fs-5",label:"Departments",value:"2",href:"#department"}),r.jsx(G,{className:"align-items-start fw-bold text-start  fs-5",label:"Programs",value:"3",href:"#program"}),r.jsx(G,{className:"align-items-start fw-bold text-start  fs-5",label:"Achievements",value:"4",href:"#achievements"}),r.jsx(G,{className:"align-items-start fw-bold text-start  fs-5",label:"Activities",value:"4",href:"#activities"})]})})}),r.jsx("div",{style:{padding:"40px 0 0 0"},id:"director-message",children:r.jsxs(w,{maxWidth:e,mx:"auto",p:"3%",bgcolor:"#fff",borderRadius:4,className:"smooth-shadow",children:[r.jsx(gr,{title:"Krishna School of Emerging Technology & Applied Research (KSET)"}),r.jsx(vr,{dirImg:"https://res.cloudinary.com/dby2vbxv3/image/upload/v1709635524/KPGU/Faculty%20Images/KSET/hod-it.webp",dirEmail:"dir.kset@kpgu.ac.in",dirName:"Dr. Nandini M. Chaudhari",dirOf:"Krishna School of Emerging Technology & Applied Research",dirOfShort:"[KSET]",dirMessage:["Dear Students, Faculty, and Esteemed Colleagues,","Welcome to Krishna School of Emerging Technology and Applied Research (KSET), a constituent institute of Drs. Kiran and Pallavi Patel Global University, Vadodara, Gujarat, INDIA, where the pursuit of knowledge and the passion for innovation converge to shape the future. As the Director of this esteemed institution, it is both an honor and a privilege to extend a warm greeting to all members of our vibrant academic community.","Our institute stands at the forefront of engineering education, driven by a commitment to excellence and a dedication to nurturing the next generation of leaders and innovators. We believe that engineering is not merely a field of study, but a gateway to transforming ideas into reality and solving the complex challenges of our world.","At KSET, we offer more than just a curriculum; we provide an environment that fosters creativity, critical thinking, and collaboration. Our world-class faculty, state-of-the-art facilities, and robust industry connections ensure that our students receive a comprehensive education that prepares them for the dynamic demands of the engineering profession.","We emphasize a holistic approach to learning, combining rigorous academic instruction with hands- on experience and real-world applications. Our strong industry ties and research initiatives provide our students with unparalleled opportunities to engage in ground breaking projects and make meaningful contributions to their fields of interest. Our institute’s values are grounded in integrity, innovation, and excellence, and we strive to uphold these principles in all that we do.","As we move forward, our focus remains on continuously evolving our programs and resources to stay ahead of emerging trends and technologies. We are excited about the future and the endless possibilities that lie ahead for our students, faculty, and the engineering profession as a whole.","Thank you for being a part of the KSET family. Together, let us embark on this journey of discovery, learning, and growth, and make a positive impact on the world.","With best regards,","Director"]})]})}),r.jsx("div",{style:{padding:"40px 0 0 0"},id:"department",children:r.jsxs(w,{maxWidth:e,mx:"auto",p:"3%",bgcolor:"#fff",borderRadius:4,className:"smooth-shadow",children:[r.jsx("h2",{className:"fw-bold color-secondary mb-4",children:"Department"}),r.jsx(k,{container:!0,spacing:4,children:s.map(({img:d,name:u,link:h},m)=>r.jsx(c,{img:d,name:u,link:h},m))})]})}),r.jsx("div",{style:{padding:"40px 0 0 0"},id:"program",children:r.jsx(Br,{Programs:Uq.Programs})}),r.jsx("div",{style:{padding:"40px 0 0 0"},id:"achievements",children:r.jsxs(w,{maxWidth:e,mx:"auto",p:"3%",bgcolor:"#fff",borderRadius:4,className:"smooth-shadow",children:[r.jsx("h2",{className:"fw-bold color-secondary mb-4",children:"Achievements"}),r.jsx("ul",{children:o.map((d,u)=>r.jsx("li",{className:"fs-5 fw-bold mt-3",children:d},u))})]})}),r.jsx("div",{style:{padding:"40px 0 0 0"},id:"activities",children:r.jsxs(w,{p:"3%",bgcolor:"#fff",borderRadius:4,className:"smooth-shadow",maxWidth:e,mx:"auto",children:[r.jsx("h2",{className:"fw-bold color-secondary fs-1",children:"Activities"}),r.jsx(k,{container:!0,spacing:3,mt:1,children:l.map(({date:d,des:u,img:h,title:m},f)=>r.jsx(J0,{date:d,des:u,img:h,title:m},f))})]})})]})}function sY(){const[e,t]=p.useState({});let n=Gn().pathname.split("/")[Gn().pathname.split("/").length-1];return p.useEffect(()=>{n==="campus-life"&&t({title:"Campus Life",img:"https://res.cloudinary.com/dby2vbxv3/image/upload/v1702100388/KPGU/Banners/banner-2.jpg"}),n==="facilities"&&t({title:"Facilities",img:"https://res.cloudinary.com/dby2vbxv3/image/upload/v1702100388/KPGU/Banners/banner-2.jpg"}),n==="gallery"&&t({title:"Gallery",img:"https://res.cloudinary.com/dby2vbxv3/image/upload/v1702100388/KPGU/Banners/banner-2.jpg"})},[n]),r.jsxs(r.Fragment,{children:[r.jsx(An,{banner:e}),r.jsx(ds,{})]})}function lY(){const{maxWidth:e}=p.useContext(X);return r.jsx(w,{maxWidth:e,mx:"auto",p:"3%",children:"CampusLife"})}function cY(){const{maxWidth:e}=p.useContext(X),t=p.useRef(null),[n,a]=p.useState("Modern Departments and Laboratories"),i=(d,u)=>{a(u)};console.log(n);const o=({onClick:d,side:u})=>r.jsx($,{variant:"contained",color:"secondary",size:"small",className:"px-0 rounded-pill",onClick:d,children:u==="right"?r.jsx(q0,{}):r.jsx(W0,{})}),s=()=>{t.current.swiper.slidePrev()},l=()=>{t.current.swiper.slideNext()},c=[{title:"Modern Departments and Laboratories",images:["https://res.cloudinary.com/dby2vbxv3/image/upload/v1721934218/KPGU/campus/Facilities/well-equipped-departments-and-laboratories-2-66a2a0f3882b5_gjiloj.webp","https://res.cloudinary.com/dby2vbxv3/image/upload/v1721934216/KPGU/campus/Facilities/well-equipped-departments-and-laboratories-4-66a2a0f6c6826_timpyv.webp","https://res.cloudinary.com/dby2vbxv3/image/upload/v1721934213/KPGU/campus/Facilities/well-equipped-departments-and-laboratories-3-66a2a100c3213_b7gc0f.webp","https://res.cloudinary.com/dby2vbxv3/image/upload/v1721934214/KPGU/campus/Facilities/well-equipped-departments-and-laboratories-1-66a2a0fdc6472_lqlgyo.webp"],des:"KPGU, Vadodara offers cutting-edge facilities in the departments and laboratories for students to secure there future. in the short span, each department has specialized labs designed to meet the unique needs of various fields of study, from engineering and sciences to healthcare and technology. These spaces provide students with hands-on experience, enabling them to apply theoretical knowledge in practical scenarios. With modern instruments and facilities, the university make students industry-ready through quality education so as to mach with the pace of rapid technology advances. Laboratories are equipped with modern instruments (GC, HPLC, FTIR, X-Ray Machine) and ultra modern facilities (PLC / CAD-CAM / MATLAB / FABLABS / High Voltage Lab / PSIM / PRO-E). Separate computer labs (10) with provision of ~200 Desktop computers are establish to conduct practicals in computer related subjects"},{title:"Smart Classrooms",images:["https://res.cloudinary.com/dby2vbxv3/image/upload/v1721934221/KPGU/campus/Facilities/smart-classrooms-66a2a0ec510dc_ohahdd.webp","https://res.cloudinary.com/dby2vbxv3/image/upload/v1727325096/KPGU/campus/Facilities/clasroom-21-66f4e30d9fae1_egqq1l.webp"],des:"KPGU has state-of-the classrooms designed to enhance the learning experience with modern technology and well ventilated with natural light and adequate electrical facility. Each room is equipped with advanced projectors creating an interactive atmosphere for both instructors and students. The spacious layout and ergonomically designed seating chairs, teaching aids ensure a conducive environment for focus. Each classroom provide an ideal seating for lectures, presentations, and group discussions, fostering innovation and knowledge sharing in a dynamic academic environ. Entire campus has dedicated internet leased line of 100 Mbps connected to all terminals. Students and faculty are free to access internet. This help students to prepare academic assignments for events. the access speed enables students and staff to download and upload files at a faster rate."},{title:"Central Library",images:["https://res.cloudinary.com/dby2vbxv3/image/upload/v1721934220/KPGU/campus/Facilities/library-66a2a0f03c1a0_kapd7v.webp","https://res.cloudinary.com/dby2vbxv3/image/upload/v1727325097/KPGU/campus/Facilities/library-11-66f4e31c18f4c_evwdjk.webp","https://res.cloudinary.com/dby2vbxv3/image/upload/v1727325096/KPGU/campus/Facilities/library-21-66f4e320d86d5_nvvz9f.webp"],des:"Central Library plays pivotal role for knowledge and learning.Central Library  offers a vast collection of academic resources with provision for ~60,000 books, E-Journals form DELNET, E-Library, Print Journals, CDs, and essential peripherals to accommodate ~500 students. Library portal on website provides links for learning recourses (24x7) to students and faculty members. The 500 Chairs placed in the Library is outcome of smallest detailing worked out in selecting ergonomic chairs for the students. Also the whole Library Management System is made fully automated where in the students uses RFID (Radio Frequency Identification System) for various functioning like book search, issue and return. We are the first in the State to launch this RFID System for various modules of Campus Management. Besides, few constituent schools (KAMC, KSPR) has separate library unites as per norms. library provides a comfortable seating areas and private study rooms for learning purposes."},{title:"Workshop",images:["https://res.cloudinary.com/dby2vbxv3/image/upload/v1721934450/KPGU/campus/Facilities/WORKSHOP_iag0nm.webp","https://res.cloudinary.com/dby2vbxv3/image/upload/v1727325097/KPGU/campus/Facilities/workshop-21-66f4e326ee7c8_q4tt45.webp"],des:"The state-of-the-art Workshop facility spread over 17500 Sq.ft. with two roofs spanning across the entire area supported on the hings. The workshop houses smithy, carpentry, fitting, and tool shops. The workshop possesses CNC engraving machine, CNC turning center with eight-station turret, simulation software, fully operational foundry, CAD-CAM, facility besides other advanced gadgets, lathes and mechanical process machines. The workshop facilities provides hands-on practical experiences to the students and enables to apply theoretical concepts in real world scenario. The workshop serves as a dynamic area where students form different engineering branches can perform practicals as per curriculum and develop skill-set. the workshop activities are supervise by experienced instructors."},{title:"Animal house",images:["https://res.cloudinary.com/dby2vbxv3/image/upload/v1727072822/KPGU/Images/Labs/Animal%20House/jds6498-copy-66f10a1d3707f_pdgqys.webp","https://res.cloudinary.com/dby2vbxv3/image/upload/v1727072822/KPGU/Images/Labs/Animal%20House/jds6500-copy-66f10a1d64016_wzluky.webp","https://res.cloudinary.com/dby2vbxv3/image/upload/v1727072822/KPGU/Images/Labs/Animal%20House/jds6502-copy-66f10a20dfc76_hjwmni.webp"],des:"Animal house facility at Krishna School of Pharmacy & Research (KSP) consist of a specialized environment designed to house and care for mice and rats, primarily for research, breeding, and educational purposes. These facilities are equipped with controlled conditions that regulate temperature, humidity, and light to ensure the well-being and comfort of the mice and rats. Strict protocols for hygiene, feeding, and veterinary care are maintained to promote animal health and minimize stress. Ethical standards governed by institutional ethical committee guidelines, ensure that animals are treated carefully. Protocols in an animal house facility are established to ensure the health, safety, and ethical treatment of the animals, while also maintaining the integrity of the research. In addition to providing a safe habitat, animal house facilities play a crucial role in advancing scientific research in campus."},{title:"Matrusri Davalba Ayurved Hospital",images:["https://res.cloudinary.com/dby2vbxv3/image/upload/v1727325096/KPGU/campus/Facilities/davalba-hospital-21-66f4e312d055a_mtryiq.webp","https://res.cloudinary.com/dby2vbxv3/image/upload/v1727325096/KPGU/campus/Facilities/davalba-hospital-11-66f4e311adcea_zcqgir.webp"],des:"Matrusri Davalba Ayurved Hospital (MDAH) is attached to Krishna Ayurved Medical College (KAMC) and operational since 2015. MADH is 60 bed hospital having seven OPDs equipped with modern infrastructure and competent Consultants from various specialties in Ayurveda. MDAH caters the healthcare services to patients from neighboring 12 villages, students, and KPGU staff. MADH offers Medical Care through Ayurvedic Systems of Medicine to the suffering humanity, particularly in the rural areas of Vadodara. MDAH practices the balance between Classical Ayurvedic concepts and Modern Medical advancements by utilizing modern diagnostic equipment (ECG machine with software, X-ray machine, cell counter, Ambulance, etc.) for early as well as accurate diagnosis (autoanalyzer) for managing diseases by Ayurvedic medicines. The treatments comprehensively integrate Yog and Physiotherapy into the Ayurvedic Panchakarma regimen. Medical officers, nursing staff, and support staff are taking care of the entire hospital. Operation theater with all amanitas is available for surgical procedures. MDAH offers vast clinical exposure to the students of KAMC pursuing studies in BAMS. Patients are given medicines, stay, and food in IPD at no cost, but charge minimal costs of all investigations and therapies."},{title:"Student Digital-Portal",images:["https://res.cloudinary.com/dby2vbxv3/image/upload/v1729189684/KPGU/StudentCorner/screenshot-2024-10-17-235228-6711563f0e9ee_kg3klp.webp"],des:"KPGU utilizes a cloud-based ERP system to simplify and automate many tasks, making university operations smoother and more efficient. This system handles everything from fee management, admissions, and payroll to curriculum, exam management, placements, and classroom training. Advanced technology ensures that all university activities run seamlessly, integrating with the rules and processes of various councils. The ERP system creates a digital campus, making it easier for students, staff, and systems to interact. It personalizes the learning experience for students and shifts the university’s focus to being more system-oriented, ensuring tasks and follow-ups are handled automatically."},{title:"Auditorium",images:["https://res.cloudinary.com/dby2vbxv3/image/upload/v1721934222/KPGU/campus/Facilities/auditorium-66a2a0e8c81aa_weuado.webp","https://res.cloudinary.com/dby2vbxv3/image/upload/v1727325098/KPGU/campus/Facilities/auditorium-21-66f4e3093872b_oynomm.webp"],des:"Krishna Edu Campus has state-of-the-art auditorium with capacity to accommodate 200 and 180 students, receptively on a gradient floor and range raised stage. both auditorium are complete with LCD projector, large screen, multi-media and audio system, wifi internet connectivity. The  auditorium has made provision for echo-free acoustic and variable light illumination system with comfortable cushion-chair arrangement for audience. The auditorium perfect place for various academic and cultural events."},{title:"Cafeteria",images:["https://res.cloudinary.com/dby2vbxv3/image/upload/v1721934215/KPGU/campus/Facilities/cafeteria-66a2a0fa1628f_k6vbiv.webp","https://res.cloudinary.com/dby2vbxv3/image/upload/v1727325097/KPGU/campus/Facilities/img-26751-66f4e31b49103_b9txf3.webp"],des:"Krishna Edu campus offers sufficient space (5000 Sq.ft.) where 500 students can dine at same time that enables students and staff to have lunch and breakfast. Separate hall (accommodate ~50) available on first floor of Cafeteria to dine. The menu is prepared with fresh ingredients and caters to diverse tastes. All health-oriented measures are practiced to provide variety of snacks and full meal to the students. Cafeteria is perfect spot to recharge ATP during the busy schedule. Besides, food stalls like Tea Post, Mr. Puff, etc. are available on campus. Overall Cafeteria area is well suited to have a peaceful munch."},{title:"Hostels",images:["https://res.cloudinary.com/dby2vbxv3/image/upload/v1721934214/KPGU/campus/Facilities/hostels-1-66a2a0fdd87ed_ejemj6.webp","https://res.cloudinary.com/dby2vbxv3/image/upload/v1727325097/KPGU/campus/Facilities/hostel-66f4e31635f82_tkhkxj.webp","https://res.cloudinary.com/dby2vbxv3/image/upload/v1721934223/KPGU/campus/Facilities/hostels-2-66a2a0e8d5aa1_nz5x0e.webp","https://res.cloudinary.com/dby2vbxv3/image/upload/v1721934214/KPGU/campus/Facilities/hostel-room-1-66a2a0fadd747_wu2shq.webp","https://res.cloudinary.com/dby2vbxv3/image/upload/v1721934219/KPGU/campus/Facilities/hostel-room-2-66a2a0f00e340_l41grt.webp","https://res.cloudinary.com/dby2vbxv3/image/upload/v1727325098/KPGU/campus/Facilities/hostels-11-66f4e3042a1df_zajnf5.webp","https://res.cloudinary.com/dby2vbxv3/image/upload/v1721934220/KPGU/campus/Facilities/hostel-mess-66a2a0eca8f6a_odygvh.webp"],des:"Krishna Edu campus has adequately ventilated and maintained separate residential hostels to accommodate both boys (150) and girls (450). Hostel offers fully furnished AC/NON-AC (2/3 beds) rooms having attached bath and balcony. Hostels possesses common dining hall as well as audio visual lounge. Both hostels has a secured living space monitored with round-the-clock security supported with CCTV Surveillance System, Fire Protection (Fire extinguishers, Water Mist Fire extinguishers) and friendly warden staff both hostels are designed to provide comfort and privacy, with modern amenities such as Wi-Fi internet connectivity, study areas, elevator, standby electrical power-backup generator and common lounges for relaxation. Both hostels are located within close proximity to the campus facilities, including the cafeteria and recreational areas, ensuring convenience for all residents. both hostels has mess with modern cooking gadgets for hygienic and nutritive food. Ban-Merry system is used to serve warm food on the dining table."},{title:"Transport Facility",images:["https://res.cloudinary.com/dby2vbxv3/image/upload/v1721934217/KPGU/campus/Facilities/transport-facility-66a2a0f349e99_uas6oh.webp","https://res.cloudinary.com/dby2vbxv3/image/upload/v1727325097/KPGU/campus/Facilities/transport-11-66f4e326eec7e_baeuic.webp"],des:"Krishna Edu campus offers a comprehensive transport facility to ensure that students have a smooth and convenient commute to and fro from Vadodara. The transportation system is featuring a fleet of well-maintained buses that operate on regular routes connecting the university with key pick-up points across the city. Students benefit from a streamlined process: upon payment of annual fees, they receive a receipt, which can later be exchanged for a bus pass card, granting them access to the transport services. This system not only facilitates efficient and reliable travel but also promotes safety and punctuality. The robust transport options provided by the university underscores its dedication to enhance student experience and accessibility."},{title:"Banking Facility",images:["https://res.cloudinary.com/dby2vbxv3/image/upload/v1721934213/KPGU/campus/Facilities/banking-facility-1-66a2a10268763_nzrosz.webp","https://res.cloudinary.com/dby2vbxv3/image/upload/v1721934216/KPGU/campus/Facilities/banking-facility-2-66a2a0f74351e_nc6vac.webp"],des:"A fully operational branch of Canara Bank is conveniently located within the campus premises, providing a comprehensive range of banking services for students, faculty, and staff. The branch offers services such as account management, deposits, withdrawals, loan assistance, and digital banking support, ensuring that all financial needs are met without the need to leave the campus. With an on-site ATM available 24/7, students can easily access their funds at any time. The presence of Canara Bank within the campus ensures hassle-free banking, making it easier for students to focus on their academics and campus life."}];return r.jsx(r.Fragment,{children:r.jsx(w,{children:r.jsxs(w,{maxWidth:e,mx:"auto",p:"3%",bgcolor:"#fff",mt:4,className:"smooth-shadow",borderRadius:4,children:[r.jsx("h3",{className:"text-uppercase fw-bold color-secondary",children:"Infrastructure"}),r.jsx(He,{variant:"body1",fontSize:20,fontFamily:"Nunito Sans",textAlign:"justify",fontWeight:700,children:"Krishna Edu campus is spread over 27 acres of lush green colossal campus. The campus is cosmopolitan in character, truly global in outlook yet deeply rooted to traditions and values of Indian culture. KPGU with it's impeccable academia, leading education framework and extensive facade in Vadodara city equipped with setup to transform passion into the profession. The campus harbours Krishna School of Emerging Technology & Applied Research, Krishna School of Diploma Studies, Krishna School of Technology, Krishna School of Pharmacy & Research, Krishna School of Physiotherapy & Rehabilitation, Krishna School of Nursing, Krishna Ayurved Medical College, Krishna School of Science, Krishna School of Business Management, Krishna School of Commerce and Krishna School of Arts & Humanities."}),r.jsx(Ke,{value:n,children:r.jsxs(k,{container:!0,spacing:2,position:"relative",mt:3,children:[r.jsx(k,{item:!0,xs:12,lg:4,children:r.jsx(w,{position:"sticky",top:0,p:2,bgcolor:"#fff",className:"smooth-shadow",borderRadius:4,children:r.jsx(Ve,{onChange:i,"aria-label":"lab API tabs example",orientation:`${innerWidth<1200?"horizontal":"vertical"}`,variant:"scrollable",textColor:"secondary",indicatorColor:"secondary",children:c.map(({title:d},u)=>r.jsx(G,{label:d,className:"align-items-start fw-bold text-uppercase text-xl-start",value:d},u))})})}),r.jsx(k,{item:!0,xs:12,lg:8,children:c.map(({des:d,images:u,title:h})=>r.jsx(W,{value:h,className:"p-0",children:r.jsx(w,{top:0,p:2,bgcolor:"#fff",className:"smooth-shadow",borderRadius:4,children:r.jsxs(w,{children:[r.jsx(fu,{height:"100%",spaceBetween:30,effect:"fade",pagination:{clickable:!0},autoplay:{delay:2e3,disableOnInteraction:!1},modules:[gk,qz,Yf],className:"mySwiper",loop:!0,grabCursor:!0,ref:t,children:u.map((m,f)=>r.jsx(Xr,{className:"h-100",children:r.jsxs(w,{position:"relative",children:[r.jsx("img",{src:m,className:"w-100 rounded-3 smooth-shadow",style:{cursor:"grab"}}),