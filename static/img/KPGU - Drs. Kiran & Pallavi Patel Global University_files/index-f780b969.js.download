startIcon:r.jsx(Al,{}),disableElevation:!0,children:"7861805185"}),r.jsx("br",{}),r.jsx($,{variant:"contained",color:"secondary",target:"_blank",className:"text-lowercase mt-2",href:"mailto:dy.dir.startup@kpgu.edu.in",startIcon:r.jsx(gu,{}),disableElevation:!0,children:"dy.dir.startup@kpgu.edu.in"})]})]});return r.jsxs(r.Fragment,{children:[r.jsxs(w,{maxWidth:e,mx:"auto",p:"5%",bgcolor:"#fff",mt:7,borderRadius:4,className:"smooth-shadow",children:[r.jsx("h2",{className:"fw-bold color-secondary m-0",children:"Start Up cell"}),r.jsx("h4",{className:"fw-semibold mb-3",children:"Under aeiges of Krishna Centre of Startup & Entrepreneurship"}),r.jsx(Je,{content:["Startup Cell of Kiran & Pallavi Patel Global University (KPGU), Vadodara, Gujarat is actively engaged in harnessing the entrepreneurial potential of startups by providing end to end support through seed funds, access      to infrastructure in terms of co-working Space & access to lab facilities comprising sophisticated equipment along with mentoring and networking platforms for start-ups by community building with wide range of the Industry Mentors, Investors, Government Stakeholders and Entrepreneurs.","Startup Cell acts as a collaborative platform that helps transform early-stage Startups into business ventures that make significant economic and social impact.","Through startup competitions, pitch events, and accelerator programs, the Startup Cell not only supports the growth of emerging startups but also promotes a culture of innovation in students, positioning the university as a key player in the entrepreneurial ecosystem."]})]}),r.jsxs(w,{maxWidth:e,mx:"auto",p:"5%",bgcolor:"#fff",mt:7,borderRadius:4,className:"smooth-shadow",children:[r.jsx("h2",{className:"fw-semibold color-secondary mb-5",children:"Supporting Agencies"}),r.jsx(k,{container:!0,spacing:4,children:t.map(({img:d,title:u,des:h},m)=>r.jsx(o,{img:d,des:h,title:u},m))})]}),r.jsxs(w,{maxWidth:e,mx:"auto",p:"5%",bgcolor:"#fff",mt:7,borderRadius:4,className:"smooth-shadow",children:[r.jsx("h2",{className:"fw-semibold color-secondary mb-4",children:"Events Related to Start-ups and Entrepreneurship"}),r.jsx(k,{container:!0,spacing:4,children:n.map(({title:d,date:u,points:h,description:m},f)=>r.jsx(s,{title:d,date:u,points:h,des:m},f))})]}),r.jsxs(w,{maxWidth:e,mx:"auto",p:"5%",bgcolor:"#fff",mt:7,borderRadius:4,className:"smooth-shadow",children:[r.jsx("h2",{className:"fw-semibold color-secondary mb-4",children:"Startups From Krishna Centre of Startup & Entrepreneurship"}),r.jsx(k,{container:!0,spacing:4,children:a.map(({companyDes:d,companyName:u,founderName:h,websiteLink:m,img:f,bgcolor:g},b)=>r.jsx(i,{companyDes:d,companyName:u,founderName:h,websiteLink:m,img:f,bgcolor:g},b))}),r.jsx(w,{children:l.map(({designation:d,image:u,name:h,quote:m},f)=>r.jsx(c,{designation:d,img:u,name:h,quote:m},f))})]})]})}function In({hodImg:e,hodName:t,hodEmail:n,hodMessage:a,hodOf:i,hodOfShort:o,ic:s}){return r.jsxs(r.Fragment,{children:[r.jsxs(k,{container:!0,borderRadius:4,overflow:"hidden",className:"smooth-shadow-card",children:[r.jsx(k,{item:!0,xs:12,md:4,children:r.jsx(w,{overflow:"hidden",height:"100%",children:r.jsx("img",{src:e,alt:"hodectors Image",className:"w-100 h-100 object-fit-cover rounded-4"})})}),r.jsx(k,{item:!0,xs:12,md:8,children:r.jsxs(w,{bgcolor:"#fff",height:"100%",p:2,pl:3,children:[r.jsx("h2",{className:"fs-1 fw-semibold",children:t}),r.jsxs("h5",{className:"text-secondary fw-semibold mb-0",children:["Head, ",s?"I/c":""," ",r.jsx("br",{})," Department of ",i," ",o]}),r.jsx("h4",{className:"color-secondary fw-bold"}),r.jsx($,{variant:"contained",color:"secondary",href:`mailto:${n}`,disableElevation:!0,startIcon:r.jsx(gu,{}),className:"text-lowercase mt-2",children:n})]})})]}),a?r.jsxs(w,{bgcolor:"#fff",p:2,borderRadius:4,mt:4,children:[r.jsx("h2",{className:"fw-bold color-secondary mb-1",children:"Message from HOD "}),r.jsx("h5",{className:"fw-bold color-secondary",children:"Welcome to KPGU"}),r.jsx(w,{mt:4,children:a.map((l,c)=>r.jsx(Je,{content:[l]},c))})]}):""]})}function Pne(){return r.jsx(r.Fragment,{children:r.jsx(In,{hodImg:"https://res.cloudinary.com/dby2vbxv3/image/upload/v1710302766/KPGU/Faculty%20Images/KSET/hod-civil.webp",hodEmail:"hod.civil.kset@kpgu.ac.in",hodName:"Dr. Khushbu Bhatt",hodOf:"Civil Engineering",hodOfShort:"[KSET]",hodMessage:["Since its inception in 2004, Krishna Edu Campus has established itself as a premier engineering institute in Gujarat. With a commitment to academic excellence, state-of-the-art infrastructure, and a dynamic learning environment, the campus has become a hub for nurturing future engineers and innovators","The Department of Civil Engineering began its journey three years ago with a vision to impart cutting-edge knowledge and skills in the field. Though still a young department, much like a two-leaf sapling, it is poised to grow into a towering tree of excellence over the next decade. We take immense pride in our academic standards and are dedicated to shaping the civil engineers of tomorrow.","Our team of energetic and highly qualified faculty members specializes in a wide range of civil engineering domains, blending advanced theoretical knowledge with practical applications. To ensure the quality of education, we emphasize hands-on teaching, rigorous training, continuous assessment, and well-structured tutorials, with regular testing to maximize student potential.","The curriculum is periodically updated to keep pace with industry developments, offering students both technical knowledge and practical skills. Our state-of-the-art laboratories provide an application-based learning environment, preparing students for real-world challenges.","While we are committed to delivering an exceptional educational experience, we also expect students to work hard, stay dedicated, and strive for academic and personal success. Together, we will build a strong foundation for a bright future in civil engineering."]})})}function Ene(){return r.jsxs(w,{borderRadius:4,children:[r.jsx("h2",{className:"text-uppercase fw-bold color-secondary mb-4",children:"About Department"}),r.jsx(Je,{content:["The department of civil engineering at KPGU is well established with high quality laboratories with a rich blend of traditional and modern equipment. Our well qualified faculty members from various specialized fields of civil engineering are dedicated to performing their duties and cultivating strong links with the industry, academic institutions, research institutions and consulting firms.","It has been crafted to serve as a hub where all the stakeholders can collaborate in optimizing teaching-learning processes which ensures tailor made programmes, effective teaching learning processes, creation of enabling habitat, pro-active participation of industry, embedding of stakeholders at every step of the value chain and others."]})]})}function kne(){const e=["Produce professionally brilliant and motivated Engineers in the field of Civil Engineering","Undertake developmental research, consultancy and technical interaction with industry","Meet the global need of competent and dedicated professionals through research & development, consultancy & extension activities which are relevant to the needs of mankind","Execute community driven, holistic programs with diverse and inclusive governance."];return r.jsxs(r.Fragment,{children:[r.jsxs(w,{borderRadius:4,className:"smooth-shadow-card p-3",children:[r.jsx("h2",{className:"fw-bold color-secondary fs-1",children:"Vision"}),r.jsx(Qe,{quote:"To develop the department into a center of excellence in education, research, training and consultancy to the extent that it becomes a significant player in the technical and overall development of the country and with skill-based knowledge achieve new horizons.",right:!0})]}),r.jsxs(w,{mt:7,borderRadius:4,className:"smooth-shadow-card p-3",children:[r.jsx("h2",{className:"fw-bold color-secondary fs-1 mb-4",children:"Mission"}),r.jsx(w,{pl:2,color:"secondary.main",children:e.map((t,n)=>r.jsxs(ce,{direction:"row",mb:1,children:[r.jsx(w,{children:r.jsx(ze,{sx:{fontSize:"25px"}})}),r.jsx(w,{children:r.jsx("h4",{children:t})})]},n))})]})]})}function Tne(){const[e,t]=Pe.useState(!1),n=s=>(l,c)=>{t(c?s:!1)},a=[{name:"Elements Of Civil Engineering",img:"https://res.cloudinary.com/dby2vbxv3/image/upload/v1726828824/KPGU/Images/Labs/KSET-Civil-Engineering/elements-of-civil-engineering-66ed50c1aaba3_qar9ml.webp",des:"The laboratory is designed to give exposure in practical works carried out in five different areas of civil engineering viz. Surveying and Leveling, Building Materials and Construction, Building Planning & Design, Transportation Engineering and Water Resources Engineering. Students are given a field practice to execute various survey work for primary residential buildings etc. The laboratory is equipped with the following major equipment.",points:["Various types of Measuring chains and tapes","Line ranger and cross staff","Compass","Dumpy Level","Theodolite","Amsler polar Planimeter","Models of Building, Society layout, dams, canals, Highway cross section, Bricks, foundations etc."]},{name:"BUILDING CONSTRUCTION LAB",img:"https://res.cloudinary.com/dby2vbxv3/image/upload/v1726828825/KPGU/Images/Labs/KSET-Civil-Engineering/building-construction-66ed50bd98ad6_xtafzf.webp",des:"Models of building components and typical civil engineering structures are available in this laboratory for thorough understanding of the subject. More than 35 wooden and steel models and charts are obtained for the laboratory. some of them are listed below.",points:["Models of ledged and braced doors, half paneled and half glazed doors, flush door","Models of different types of roofs","Models of different type of floorings","Models of different types of scaffolding","Models of different types of staircases","Models of road culvert with single arch and box types, railway culvert, cloverleaf junction, cross section of national highway, subsurface drainage, foundation, pneumatic caisson etc."]},{name:"MATERIAL TESTING LAB",img:"https://res.cloudinary.com/dby2vbxv3/image/upload/v1726828873/KPGU/Images/Labs/KSET-Civil-Engineering/material-testing-lab-66ed50ae64b1d_f2afgy.webp",des:"The laboratory is equipped to perform experiments for various types of forces and force systems, verifying fundamental laws of Mechanics and testing of engineering materials e.g. mild steel, cast iron, brass, timber etc . The laboratory is equipped with the following major equipment.",points:["Universal force table","Various lifting machines","Jib crane","Roof truss","Screw jack","Friction slide apparatus.","Compression Testing Machine","Hardness Testing Machine","Pendulum (Izod)Testing Machine","Universal Testing Machine","Fatigue Testing Machine","Torsion Testing Machine","Mechanical Extensometer with Dial Gauge."]},{name:"HYDROLOGY AND IRRIGATION ENGINEERING LAB",img:"https://res.cloudinary.com/dby2vbxv3/image/upload/v1726828873/KPGU/Images/Labs/KSET-Civil-Engineering/hydrology-and-irrigation-engineering-lab-kset-civil-9-22-66ed50b8a1ce3_cqfd6g.webp",des:"Engineering models of different typical hydraulic structures are provided in this laboratory for thorough understanding of the subject. More than 25 wooden models are displayed in this laboratory.",points:["Canal Regulator (Models)","Canal Drop","Saddle syphon spillway","Aqueduct","Syphon Aqueduct","Level crossing","Supper passage","Supressed weir","Fish ladder","Canal Intake","Hydraulic jump","Spilway gate","Tank weir","Tank sluice with lower head","Different types of dams","Sluice gate","Gibbs model","Slit ejector","River head works"]},{name:"ENVIRONMENTAL ENGINEERING LAB",img:"https://res.cloudinary.com/dby2vbxv3/image/upload/v1726828824/KPGU/Images/Labs/KSET-Civil-Engineering/enviornmental-engineering-lab-66ed50b33650a_vpnp8a.webp",des:"Environmental engineering laboratory is equipped with all the latest instruments of reputed brands to perform various experiments and tests on water, wastewater and air samples. The laboratory is ready to accept consultancy assignments and environmental audit challenges. Major instruments existing in the laboratory are as follows.",points:["Turbidity Meter","UV-Vis spectrophotometer","COD Digester","Water bath","High speed mixer","pH meter","Electronic Autoclave","Jar test apparatus","Digital muffle furnace","Hot air oven","BOD incubator","Electronic weighing balance (0.01 mg accuracy)","High Volume Sampler","Multi Parameter Meter for pH","Conductivity and DO"]},{name:"HIGHWAY ENGINEERING LAB",img:"https://res.cloudinary.com/dby2vbxv3/image/upload/v1726828825/KPGU/Images/Labs/KSET-Civil-Engineering/highway-engineering-lab-66ed50aa7d8d7_uejflu.webp",des:"Highway Engineering laboratory is designed to carry out qualitative and quantitative tests for raw materials like Aggregate, Sand, Bitumen etc. The laboratory is designed with a vision of testing requirements of industry and different research areas of highway engineering. Major instruments existing in the laboratory are as under.",points:["Thickness gauge","Length gauge","Ductility test apparatus","Crushing value apparatus","Sieve Sets","Standard tar viscometer","Oven","Ring and ball apparatus","Pycnometer","Los Angeles Abrasion testing machine","Aggregate impact test apparatus","Modified Marshall apparatus","Bitumen flash and fire point test apparatus and Asphalt mixer."]},{name:"HYDRAULICS LABORATORY",img:"https://res.cloudinary.com/dby2vbxv3/image/upload/v1726828846/KPGU/Images/Labs/KSET-Civil-Engineering/hydraulics-lab-66ed50aa4e77d_eniwlz.webp",des:"Hydraulics laboratory is well established to perform laboratory experiments of basic and advanced fluid mechanics. Set ups for following experiments are available in the laboratory.",points:["Open Channel Flow Setup","Tilting Flume, Supersonic Wind Tunnel","Pelton Wheel Test Rig","Combine Rig for Free Forced Vortex","Orifice Mouthpiece","Reynold’s Apparatus","Combine Rig for Pipe Friction","Fitting","Venturimeter","Orificemeter","Rotameter Apparatus","Pressure Measurement Devices","Combine Rig for Bernoulli’s Theorem","Metacentric Height Apparatus","Notch Apparatus & Pitot Static Tube Apparatus","Electrical Analogy Setup"]},{name:"CONCRETE TECHNOLOGY",img:"https://res.cloudinary.com/dby2vbxv3/image/upload/v1726828825/KPGU/Images/Labs/KSET-Civil-Engineering/concrete-technology-4-kset-civil-21-66ed50c14afc2_njzsao.webp",des:"Concrete technology laboratory is designed to carry out qualitative and quantitative tests for raw materials, fresh and hardened concrete. The laboratory is designed with a vision of testing requirements of industry and different research areas of concrete design. Major instruments existing in the laboratory are as follows.",points:["Aggregate Crushing Value Apparatus","Compaction Factor Apparatus","Density Baskets Vee-Bee Consistometer","High Pressure Autoclave for Soundness test","Cast Iron Moulds for Cube","Cylindrical and beam molding","Vibrating Machine and Vibrating table","Concrete Mixer","U–Box, L–Box and V–Box Apparatus","Flow Table for SCC.","Electronic balances (capacity 10 kg and 100 kg)","Motorized Sieve Shaker","Heat of Hydration","Flexure Testing Machine","Compression testing Machine"]},{name:"SOIL MECHANICS LAB",img:"https://res.cloudinary.com/dby2vbxv3/image/upload/v1726828873/KPGU/Images/Labs/KSET-Civil-Engineering/soil-mechanics-lab-kset-civil-9-24-66ed50bd26df4_zxs1xk.webp",des:"The laboratory is equipped to perform experiments as well as to carry our field testing works in the field of Geotechnical Engineering. The key instruments available with the laboratory are Swell Pressure test apparatus.",points:["Laboratory CBR apparatus","Unconfined compressive strength apparatus","Consolidation apparatus (3 Gang)","Universal Triaxial test set up with Electronic Measuring Outfit","Standard penetration test set","Sand density cone, Relative Density Apparatus","Hydraulic and Manual Sample extruder","Constant temperature bath","Motorized Sieve shaker","Direct Shear apparatus motorized"]},{name:"STRUCTURAL ENGINEERING LAB",img:"https://res.cloudinary.com/dby2vbxv3/image/upload/v1726828874/KPGU/Images/Labs/KSET-Civil-Engineering/structural-engineering-lab-kset-civil-10-23-66ed50aeb0c3e_ctrhwg.webp",des:"Structural Engineering laboratory is equipped with a universal test frame which is having experiments set up for the following equipment.",points:["Simple pendulum","Compound pendulum","Biflair&Triflair suspension","Single rotor transitional vibrations","Two rotor transitional vibrations","Damped torsional vibrations","Natural vibration spring mass system","Forced damped vibrations"]},{name:"SURVEYING ENGINEERING LAB",img:"https://res.cloudinary.com/dby2vbxv3/image/upload/v1726828875/KPGU/Images/Labs/KSET-Civil-Engineering/surveying-lab-66ed50b2e4ac3_qqw9em.webp",des:"The surveying laboratory is planned as a part of the fundamental survey laboratory to carry out survey projects and also to take up the field survey consultancy works. It is equipped with the following latest equipment.",points:["Electronic Digital Planimeter","Transit Vernier Theodolite 20″ accuracy with stand","Leveling staffs and Ranging rods","Fiberglass tape","Theodolite with compensator and stand","Electronic distance measurement device","Total Station (Ele.) Pentax – 874922","Plane Table With all Accessories."]}],i=({name:s,col:l})=>r.jsx("h6",{className:"fw-bold color-secondary mt-3 mb-3 me-3 p-2 smooth-shadow-card",style:{display:"inline-block"},children:s}),o=({name:s,img:l,des:c,points:d,index:u})=>r.jsxs(jn,{expanded:e===u,onChange:n(u),elevation:0,className:"smooth-shadow-card rounded-2 py-2",sx:{position:"static"},children:[r.jsx(En,{expandIcon:r.jsx(bk,{}),"aria-controls":"panel1bh-content",id:"panel1bh-header",children:r.jsx("h6",{className:"fw-bold color-secondary mb-0  text-uppercase",children:s})}),r.jsx(Pn,{sx:{textAlign:"justify"},children:r.jsxs(k,{container:!0,spacing:2,children:[r.jsx