024-09-28-at-142844-791992f2-66f7e1aa5bbb9_thd4fw.webp"},{name:"Dr. Hitesh Miyani",designation:"Assistant Professor",experience:5,imgNo:"",qualification:"B.A.M.S. || M.D. [Roga Nidan]",customLink:"https://res.cloudinary.com/dby2vbxv3/image/upload/v1727090279/KPGU/Faculty%20Images/KAMC/dr-hitesh-miyani-66f14e1fc462d_eggtlq.webp"},{name:"Dr. Sreelakshmi S Kartha",designation:"Assistant professor",experience:2,imgNo:"",qualification:"B.A.M.S. || M.D. [Shalya Tantra]",customLink:"https://res.cloudinary.com/dby2vbxv3/image/upload/v1727521238/KPGU/Faculty%20Images/KAMC/whatsapp-image-2024-09-26-at-130953-135e7ba4-66f7e1aa921cd_1_tl3mmd.webp"}];return r.jsxs(r.Fragment,{children:[r.jsx(Ke,{value:n,children:r.jsx(w,{className:"smooth-shadow",bgcolor:"rgba(256, 256, 256, 0.6)",sx:{backdropFilter:"blur(10px)"},p:2,borderRadius:4,mt:7,position:"sticky",top:0,maxWidth:e,mx:"auto",zIndex:99999999,children:r.jsxs(Ve,{onChange:i,"aria-label":"lab API tabs example",orientation:"horizontal",textColor:"secondary",indicatorColor:"secondary",variant:"scrollable",children:[r.jsx(G,{className:"align-items-start fw-bold text-start  fs-5",label:"Message From Director",value:"1",href:"#director-message"}),r.jsx(G,{className:"align-items-start fw-bold text-start  fs-5",label:"vision",value:"2",href:"#vision"}),r.jsx(G,{className:"align-items-start fw-bold text-start  fs-5",label:"mission",value:"3",href:"#mission"}),r.jsx(G,{className:"align-items-start fw-bold text-start  fs-5",label:"Faculty",value:"4",href:"#faculty"}),r.jsx(G,{className:"align-items-start fw-bold text-start  fs-5",label:"Programs",value:"5",href:"#program"}),r.jsx(G,{className:"align-items-start fw-bold text-start  fs-5",label:"KAMC at Glance",value:"6",href:"#at-glance"})]})})}),r.jsx("div",{style:{padding:"40px 0 0 0"},id:"director-message",children:r.jsxs(w,{maxWidth:e,mx:"auto",p:"3%",bgcolor:"#fff",borderRadius:4,className:"smooth-shadow",children:[r.jsx(gr,{title:"Krishna Ayurved Medical College [KAMC]"}),r.jsx(vr,{dirImg:"https://res.cloudinary.com/dby2vbxv3/image/upload/v1709631583/KPGU/Faculty%20Images/KAMC/dir-img.webp",dirEmail:"dir.kamc@kpgu.ac.in",dirName:"Dr. Malhari K. Sirdeshpande",dirOf:"Krishna Ayurved Medical College",dirOfShort:"[KAMC]",dirMessage:["Krishna Ayurved Medical College established in the year of 2019, is a world class educational institute developed for top quality teaching and training in the field of Ayurved with the vision of the founder President Hon. Jagdishbhai Patel.","This institute is one of the renouned colleges, managed by Shree Krishna educational and charitable trust, Vadodara.Krishna Ayurved Medical College & Davalba Ayurved Medical Hospital are well equipped with all teaching and training facilities for students. Academic excellence is our Moto and to achieve this, highly qualified teaching staff is working hard to carve out the future of the students.","Apart from the academic activities, sports facilities, developed campus, world class infra structure in a nature friendly environment provide all opportunities of complete personality developments of students. Library having more than 8000 books, medicinal plant garden, Teaching Pharmacy, Teaching aids such as projectors, E- Library are some of the tools for high quality teaching and learning process.","The clinical exposure is equally important for medical students. Davalba Ayurved Medical Hospital is an ideal example of social service with academic facility for students. We render completely free of cost treatment for patients helping particularly the less privileged section from rural area of Varnama and other villages in vicinity.  Students can easily get the practical clinical experiences from the well developed OPDS having up to 300 patients per day & 60 beded IPD of Matoshri  Davalba Ayurved Medical Hospital.  Full flagged Panchakarma unit, fully functional Operation Theater, Physiotherapy section, Advanced Pathology lab, X-ray unit and quality medicines make the hospital a unique Ayurved Treatment center with all modern facilities.","We are well prepared to welcome our third academic batch in coming days. Over & above the norms of CCIM & Gujarat Ayurved University, the KAMC team is committed for shaping & polishing of our students nurturing them into the shining diamonds to offer the best medical services to the society, using the ancient treasure of Ayurved with modern scientific outlook."]}),r.jsxs(w,{p:1,className:"smooth-shadow-card",width:"max-content",borderRadius:2,children:[r.jsx("h4",{children:"FOR MORE INFORMETION CLICK HERE"}),r.jsx($,{variant:"contained",color:"secondary",href:"https://krishnaayurvedic.org/",children:"More info"})]})]})}),r.jsx("div",{style:{padding:"40px 0 0 0"},id:"vision",children:r.jsxs(w,{bgcolor:"#fff",borderRadius:4,className:"smooth-shadow",p:"3%",maxWidth:e,mx:"auto",children:[r.jsx("h2",{className:"fw-bold color-secondary fs-1",children:"Vision"}),r.jsx(Qe,{quote:"To be a Globally recognized Centre for excellence in Ayurved and to statuette competentn & efficient physicianin the society and excelin the Healthcare sector.",right:!0})]})}),r.jsx("div",{style:{padding:"40px 0 0 0"},id:"mission",children:r.jsxs(w,{bgcolor:"#fff",borderRadius:4,className:"smooth-shadow",p:"3%",maxWidth:e,mx:"auto",children:[r.jsx("h2",{className:"fw-bold color-secondary fs-1",children:"Mission"}),r.jsx(Qe,{quote:"To make a commitment to encouraging efficiency and high professional standards in teaching, healthcare, and research development, while also extending quality healthcare to nearby and needy society areas to achieve complete holistic development.",right:!0})]})}),r.jsx("div",{style:{padding:"40px 0 0 0"},id:"faculty",children:r.jsxs(w,{bgcolor:"#fff",borderRadius:4,className:"smooth-shadow",p:"3%",maxWidth:e,mx:"auto",children:[r.jsx(w,{mb:4,children:r.jsx("h2",{className:"fw-bold color-secondary fs-1",children:"Faculty Members"})}),r.jsx(k,{container:!0,spacing:4,children:s.map(({name:l,designation:c,experience:d