condary",indicatorColor:"secondary",variant:"scrollable",onChange:i,"aria-label":"lab API tabs example",children:r.jsx(G,{className:"fw-bold",label:"ug",value:"1"})}),r.jsx(W,{value:"1",sx:{px:"0 !important"},children:r.jsx(k,{container:!0,spacing:2,children:c.map(({des:d,link:u,pageLink:h,title:m,duration:f,fees:g},b)=>r.jsx(zk,{des:d,link:u,pageLink:h,title:m,duration:f,fees:g},b))})})]})})})]})}function Zq(){const{maxWidth:e,innerWidth:t}=p.useContext(X),n=xt();p.useState("1");const[a,i]=p.useState("1"),o=(u,h)=>{i(h)},s=[{name:"Dr. Rita Mahapatra",imgNo:"6220",designation:"Assistant Professor || Head, Dept. of Biotechnology",experience:11,qualification:"Ph.D [Biotechnology]",customLink:""},{name:"Dr. Asha Joshi",imgNo:"6099",designation:"Assistant Professor || HOD[Dept. of Chemistry]",experience:7,qualification:"Ph.D [Chemistry]",customLink:""},{name:"Dr. Parul Shrivastava",imgNo:"6102",designation:"Assistant Professor || HOD[Dept. of Microbiology]",experience:5,qualification:"Ph.D [Microbiology]",customLink:""},{name:"Dr. Poonam Mishra",imgNo:"6098",designation:"Assistant Professor",experience:5,qualification:"Ph.D [Biotechnology]",customLink:""},{name:"Dr. Miral Vora",imgNo:"6101",designation:"Assistant Professor",experience:3,qualification:"Ph.D [Chemistry]",customLink:""},{name:"Dr. Nikita Patel",imgNo:"6104",designation:"Assistant Professor",experience:3,qualification:"Ph.D [Chemistry]",customLink:""},{name:"Dr. Shilpi Thakur",imgNo:"6103",designation:"Assistant Professor",experience:2,qualification:"Ph.D [Microbiology]",customLink:""},{name:"Dr. Margi Patel",imgNo:"6222",designation:"Assistant Professor",experience:3,qualification:"Ph.D [Microbiology]",customLink:""},{name:"Dr. Swati Patel ",imgNo:"3413",designation:"Assistant Professor",experience:1,qualification:"Ph.D [Biotechnology]",customLink:""},{name:"Mr. Tejas Pandya",imgNo:"6108",designation:"Assistant Professor || Head, Dept. of Physics",experience:9,qualification:" Ph.D [Pursuing] || M.Sc || M.Phil [Physics]",customLink:""},{name:"MS. Foram Shah",imgNo:"6100",designation:"Assistant Professor || Head, Dept. of Mathematics",experience:8,qualification:"M.Sc || B.Ed [Mathematics]",customLink:""},{name:"Ms. Disha Vainsh",imgNo:"",designation:"Assistant Professor",qualification:"M.Sc. Biotechnology || GSET",customLink:"https://res.cloudinary.com/dby2vbxv3/image/upload/v1726827326/KPGU/Faculty%20Images/KSS/ms-disha-vainsh-66ed4b1f32892_ao0ubu.webp"},{name:"Ms. Dipti Upadhyay",imgNo:"",designation:"Assistant Professor",qualification:"M.Sc. Chemistry || Ph.D. Chemistry (Pursuing)",customLink:"https://res.cloudinary.com/dby2vbxv3/image/upload/v1726827325/KPGU/Faculty%20Images/KSS/ms-dipti-upadhyay-66ed4b209267f_dqhecf.webp"},{name:"Mr. Ravindra Patil",imgNo:"",designation:"Assistant Professor",qualification:"M.Sc. Organic Chemistry || Ph.D. Chemistry (Pursuing)",customLink:"https://res.cloudinary.com/dby2vbxv3/image/upload/v1726827325/KPGU/Faculty%20Images/KSS/mr-ravindra-patil-66ed4b2097479_e6nk21.webp"}],l=[{img:"https://res.cloudinary.com/dby2vbxv3/image/upload/v1709706408/KPGU/icon/Biotechnology.svg",name:"Biotechnology",link:"/academics/kss/biotechnology"},{img:"https://res.cloudinary.com/dby2vbxv3/image/upload/v1709706408/KPGU/icon/Chemistry.svg",name:"Chemistry",link:"/academics/kss/chemistry"},{img:"https://res.cloudinary.com/dby2vbxv3/image/upload/v1709706408/KPGU/icon/Mathematics.svg",name:"Mathematics",link:"/academics/kss/mathematics"},{img:"https://res.cloudinary.com/dby2vbxv3/image/upload/v1709706408/KPGU/icon/Microbiology.svg",name:"Microbiology",link:"/academics/kss/microbiology"},{img:"https://res.cloudinary.com/dby2vbxv3/image/upload/v1709706408/KPGU/icon/Physics.svg",name:"Physics",link:"/academics/kss/physics"}],c=["Recognized as Zonal Training Centre from MakeIntern for E-cell IIT Kharagpur in 2023 and IIT- Hyderabad in 2024.","GSBTM-DST sanctioned ₹70,000/- to the Department of Biotechnology to conduct a National Symposium on 6 December 2024.",'Online workshop on "Bioinformatics: tools and softwares" as a part of Zonal Championship, organized jointly by KSS, and Makeintern- E- Cell- IIT-Kharagpur from 27-29 July, 2023.','Three days workshop on "Recombinant DNA Technology" as a part of Zonal Championship, organized jointly by KSS, and Makeintern- E- Cell- IIT-Hyderabad from 27-29 July, 2023.',"Dr. Parul Shrivastava, Eshpreet Kaur Sandhu and Jugalkumari Vireshkumar Shah received ₹42000/- for development of “Proof of concept” for “Potential probiotic application of Lactobacilli obtained from feaces of asymptomatic covid-19 individuals.” under SSIP after project pitching on 11 July, 2023.","Dr. Asha Joshi, Dr. Miral Vora, Dr. Nikita Patel, ₹42000/- for development of “Proof of concept” for “Extraction, Isolation, Purification, Optimization and Dyeing of Natural Dye on Textiles from Natural Products.” under SSIP after recommendation of Jury members subsequent to project pitching on 11 July, 2023.","Dr. Swati Patel, Dr. Poonam Mishra and Dr. Rita Mahapatra ₹90000/- for development of “Proof of concept” for “Isolation of the antimicrobial compound from plant extract of Axora coccinia” under SSIP after project pitching on 27  July, 2024.","A major Project entitled “Evaluation of role of Aspergillus flavus derived elicitor to control fungal pathogens and aflatoxin contamination in Capsicum annum L”. Submitted by Dr. Rita Mahapatra (Principal investigator) and Dr. Poonam Mishra (Co-investigator) to the Gujarat Council on Science and Technology (GUJCOST), Gujarat, India.","A major Project entitled “Community-based training to tribal farmers on Biofertilizer utilization for sustainable agriculture, and Biotechnology”. Submitted by Dr. Rita Mahapatra (Principal investigator) et al. (Prof. A. B. Chaudhuri, Dr. Asha Joshi, Dr. Margi Patel, Dr. Shilpi Thakur, Dr. Poonam Mishra, Dr. Nikita Patel as a Co- investigators) to the Gujarat Council on Science and Technology (GUJCOST), Gujarat, India.","Dr. Rita Mahapatra achieved 1st rank in poster presentation in two days national seminar organized as a part of 35th Gujarat Science Congress-2024 “Empowering Tribes through Science: A journey of Discovery” on 3-4 February 2024 at Shri Govind Guru University, Godhra jointly organized by SGGU, GSA, GUJCOST, CSMCRI.","Organized an Educational and Industrial tour of Semester V students to Savli Technology and Business incubator on 26 August 2023.","Ataliya Saxiben (B.Sc. Sem-II) secured 1st Rank in Chess during SWEEK-2022.","Maitreyee Motaval, Dhruvi Purohit, Khevna Kathiriya Vaibhavi Tarsadiya B.Sc. Sem-II students secured 3rd rank in Relay race in SWEEK-2022.","Gracy Maharaj, a B.Sc. Biotechnology student of KSS, previously known as Krishna Science College, affiliated to SGGU, Godhra, secured First position and awarded Gold Medal in the Convocation of SGGU 2023, Godhara. Also, qualified the GAT-B (Graduate Aptitude test) -Biotechnology-2023, a national level exam conducted by Department of Biotechnology, Government of India, for selection of students for Post-graduate studies at Institute and Universities of National Repute.","Hiya Desai, Kinjal Rathod, Aarti Vasava, and Vishwakarma Sweta (B.Sc. Sem IV) achieved First Rank in Model making under the category of Chemical Science in the National Science Day Celebration 2024 Organized by Parul Institute of Applied Sciences and hosted by Parul University on 28 February 2024.","Hardik Jadhav, Margiben Pandya and Vaibhavi Soni (B.Sc. Sem IV) achieved special appreciation for their performance in the 8th National Zonal Championship 2024 Organized by MakeIntern and E Cell IIT Delhi on 16-17 March 2024.","Gohil Trushali (B.Sc. Sem IV) achieved Third Rank in AIPPM Yuvamanthan Model United Nations Event on the theme of “ Lifestyle for Environment” Organized by KPGU on 13 April, 2024.","Kachhiya Vinayak Sanjaybhai (B.Sc. Sem VI) achieved Second Rank in COP Yuvamanthan Model United Nations Event on the theme of “ Lifestyle for Environment” Organized by Drs. Kiran and Pallavi Patel Global University on 13 April, 2024.","Devang Prakashbhai Rathod (B.Sc. Sem III) and Maahi Patel (B.Sc Sem V) received certificates of appreciation for their participation in essay writing organized by MYCOASIA, India on the Topic, Fungi: The Future of Sustainability and innovation.","Patel Bhargav (Sem II), performed the highest no. of Surya Namaskar(133) on the occasion of International Yoga Day Event @KPGU campus 0n 21 June, 2023","Under “Video Reel Competition” on theme “SuryaNamaskar-Unite with self”, the reel of Kachhiya Vinayak (Sem V) selected in the best 3 Reels at International Yoga Day Event @KPGU campus 0n 21 June, 2023","Kachhiya Vinayak S (Sem V) participated in Elocution competition organized by KSN under G20 activity on the topic ‘Strategic Planning for Zero Hunger’ on 17 July,2023. and secured 1st rank.","Dhairya Rajput (Sem III) and Devang Rathod (Sem III) participated in Debate competition organized by KSDS under G20 activity with the theme ‘Potable water for all’ on 20  July,2023. and secured 3rd position.","Kesha Patel (Sem III) and Hiya Desai (Sem III) participated organized by KSS in Poster Competition under G20 activity with the theme ‘Clean Energy’ on 25 July, 2023. and secured 2nd position.","Dhairya Rajput (Sem III) and Tanushree Thakkar(Sem III) participated  in event organized by KSP on Extempore Debate competition under G20 activity with the theme ‘Sustainable Development Goals’ on 7 August, 2023. and secured 3rd position on the topic ‘Industry, innovation and Infrastructure’.","Devang Rathod (Sem III) participated in drawing  competition organized by KSPR under G20 activity on the topic ‘Save Environment’ on 1st August, 2023.","Rathod Devang P (Sem III) participated in an MycoAsia Essay Competition 2023 on “Fungi :The future of sustainability and innovation”","Tanushree Thakkar and Dhairya Rajput (B.Sc. Sem III) participated in G20 Regional level debate competition held at Navrachana University on the topic ‘Politics as a lucrative career option’. Tanushree spoke for the motion and  Dhairya spoke against the motion.","Sukhpal Singh Pannu (Sem III) and Madhvi Kantilal Kaua (Sem III) participated in Intercollege Debate Competition organized by KSDS under G20 activity on 14/09/23 on the topic ‘World without Borders’.","KSS students participated in BIOIMPACT 2024 organized by Department of Biotechnology, PDEU in collaboration with DST and GSBTM and won prizes in various competitions as follows","Arya Aditi Atulesh, Soni Vaibhavi Mayur, Kadam Pratham Ajit secured 3rd rank in BioQuiz.","Solanki Parixit Harishchandra Sinh, Mahek Yashprakash Kolekar, Vanzara Maitri Ketankumar, Iyer Nandini Kevalkumar have jointly secured 2nd rank in Crime Scene Investigation.","Rathod Devang Prakashbhai secured 2nd rank in Creative logo creation"],d=({name:u,img:h,link:m})=>r.jsx(k,{item:!0,xs:12,sm:6,md:4,children:r.jsx(w,{className:"smooth-shadow-card department-card",p:2,borderRadius:4,onClick:()=>n(m),children:r.jsxs(k,{container:!0,spacing:2,alignItems:"center",children:[r.jsx(k,{item:!0,xs:12,sm:12,md:3,children:r.jsx("img",{src:h,alt:"",className:"w-100 d-block mx-auto",style:{maxWidth:"120px"}})}),r.jsxs(k,{item:!0,xs:12,sm:12,md:9,textTransform:"uppercase",textAlign:{xs:"center",md:"start"},children:[r.jsx("h5",{className:"mb-0 fw-bold ",children:"Department of "}),r.jsx("h5",{children:u})]})]})})});return r.jsxs(r.Fragment,{children:[r.jsx(Ke,{value:a,children:r.jsx(w,{className:"smooth-shadow",bgcolor:"#fff",p:2,borderRadius:4,mt:7,position:"sticky",top:0,maxWidth:e,mx:"auto",zIndex:99999999,children:r.jsxs(Ve,{onChange:o,"aria-label":"lab API tabs example",orientation:"horizontal",textColor:"secondary",indicatorColor:"secondary",variant:"scrollable",children:[r.jsx(G,{className:"align-items-start fw-bold text-start  fs-5",label:"Message From Director",value:"1",href:"#director-message"}),r.jsx(G,{className:"align-items-start fw-bold text-start  fs-5",label:"Departments",value:"2",href:"#department"}),r.jsx(G,{className:"align-items-start fw-bold text-start  fs-5",label:"Faculty",value:"4",href:"#faculty"}),r.jsx(G,{className:"align-items-start fw-bold text-start  fs-5",label:"Programs",value:"3",href:"#program"}),r.jsx(G,{className:"align-items-start fw-bold text-start  fs-5",label:"Achievements",value:"5",href:"#achievements"})]})})}),r.jsx("div",{style:{padding:"40px 0 0 0"},id:"director-message",children:r.jsxs(w,{maxWidth:e,mx:"auto",p:"5%",bgcolor:"#fff",borderRadius:4,className:"smooth-shadow",children:[r.jsx(gr,{title:"Krishna School of Science [KSS]"}),r.jsx(vr,{dirImg:"https://res.cloudinary.com/dby2vbxv3/image/upload/v1726837072/KPGU/Images/WhatsApp_Image_2024-09-20_at_15.30.48_2ec38aff_oz7pkq.jpg",dirEmail:"dir.kss@kpgu.ac.in",dirName:"Prof. A.B. Chaudhari",dirOf:"Krishna School of Science",dirOfShort:"[KSS]",dirMessage:["At Krishna School of Science (KSS), we take immense pride in being a center of excellence in scientific education and research, perfectly aligned with the vision of KPGU to serve the greater good through continual progress and innovation. Our mission is to nurture and empower young minds to become the scientists, innovators, and global leaders of tomorrow. We believe that fostering a passion for discovery, critical thinking, and problem-solving is essential to preparing our students for successful careers in an ever-evolving world.","At KSS, we provide a stimulating learning environment where students engage in cutting-edge experiments, explore new scientific theories, and collaborate with their peers. Our state-of-the-art laboratories and research facilities offer hands-on experiences, enabling students to work alongside distinguished faculty members who are leaders in their fields. We are committed to instilling a scientific attitude through a comprehensive, student-centric curriculum that covers a wide range of disciplines, including Physics, Chemistry, Mathematics, Microbiology, and Biotechnology, ensuring a holistic approach to scientific learning.","Beyond the classroom, we actively encourage our students to participate in research projects, attend seminars, and engage in workshops conducted by renowned scientists and industry experts. This supports the mission of KPGU to provide a collaborative environment for the exchange of ideas and to nurture innovative and socially responsible global citizens. We also prioritize the holistic development of our students by offering extracurricular activities, competitions, and events that foster leadership, teamwork, and personal growth.","Through initiatives such as Science Day celebrations, field trips, and industrial visits, our students gain exposure to real-world applications of science, expanding their horizons and preparing them for future challenges. Additionally, we place great emphasis on the well-being and personal development of each student. Our dedicated counseling team ensures that students are provided with a nurturing and inclusive environment where they can thrive, in line with KPGU's aim to cultivate good human beings with compassion, empathy, and scientific temper.","I would like to express my deepest appreciation to our exceptional faculty members and staff, whose unwavering dedication and expertise are the pillars of Krishna School of Science. Together, we strive to create a positive, inspiring atmosphere that reflects the KPGU Vision-2040 and prepares our students to excel in their academic journeys.","Lastly, I extend my heartfelt gratitude to the parents and guardians who have entrusted us with their children's education and future. We value your trust and are committed to providing the highest standards of education and support to ensure your child’s success.","As we look ahead to an exciting academic year, filled with scientific achievements, let us continue pushing the boundaries of knowledge, empowering the next generation of scientific leaders, and contributing to the greater mission of KPGU in service to society and global excellence.","With best wishes"]})]})}),r.jsx("div",{style:{padding:"40px 0 0 0"},id:"department",children:r.jsxs(w,{maxWidth:e,mx:"auto",p:"5%",bgcolor:"#fff",borderRadius:4,className:"smooth-shadow",children:[r.jsx("h2",{className:"fw-bold color-secondary mb-4",children:"Department"}),r.jsx(k,{container:!0,spacing:4,children:l.map(({img:u,name:h,link:m},f)=>r.jsx(d,{img:u,name:h,link:m},f))})]})}),r.jsx("div",{style:{padding:"40px 0 0 0"},id:"faculty",children:r.jsxs(w,{maxWidth:e,mx:"auto",p:"5%",bgcolor:"#fff",borderRadius:4,className:"smooth-shadow",children:[r.jsx("h2",{className:"fw-bold color-secondary mb-4",children:"Faculty"}),r.jsx(k,{container:!0,spacing:4,children:s.map(({name:u,designation:h,experience:m,qualification:f,imgNo:g,customLink:b},C)=>r.jsx(Qt,{name:u,qualification:f,designation:h,experience:m,facultyName:"KSS",imgNo:g,MainLink:"https://res.cloudinary.com/dby2vbxv3/image/upload/v1707807610/KPGU/Faculty%20Images/",customLink:b},C))})]})}),r.jsx("div",{style:{padding:"40px 0 0 0"},id:"program",children:r.jsx(Br,{Programs:Wq.Programs})}),r.jsx("div",{style:{padding:"40px 0 0 0"},id:"faculty",children:r.jsxs(w,{maxWidth:e,mx:"auto",p:"5%",bgcolor:"#fff",borderRadius:4,className:"smooth-shadow",children:[r.jsx("h2",{className:"fw-bold color-secondary mb-4",children:"Achievements"}),r.jsx("ul",{children:c.map((u,h)=>r.jsx("li",{className:"fs-5 fw-bold mt-3",children:u},h))})]})})]})}function eY(){const{maxWidth:e}=p.useContext(X);xt(),p.useState("1");const[t,n]=p.useState("1"),a=(s,l)=>{n(l)},i=[{name:"Dr. Paras Bhura ",imgNo:"6096",designation:"Professor || Director (I/C)",experience:11,experienceC:"9 Months",qualification:"Ph.D || MPT",customLink:""},{name:"Dr. Camy Bhura (PT) ",imgNo:"5852",designation:"Associate Professor",experience:11,experienceC:"5 Months",qualification:"MPT || Ph.D (Pursuing)",customLink:""},{name:"Dr. Pragna Landge (PT)",imgNo:"5864",designation:"Associate Professor",experience:9,experienceC:"1 Year 