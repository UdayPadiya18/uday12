e().getFullYear()," ","KPGU. All rights reserved."]}),r.jsxs(ce,{direction:"row",children:[r.jsx(qn,{sx:{color:"#fff"},size:"large",target:"_blank",href:"https://www.facebook.com/KPGU.Vadodara/",children:r.jsx(yk,{fontSize:"large"})}),r.jsx(qn,{sx:{color:"#fff"},size:"large",target:"_blank",href:"https://www.instagram.com/kpgu_official/?hl=en",children:r.jsx(SV,{fontSize:"large"})}),r.jsx(qn,{sx:{color:"#fff"},size:"large",target:"_blank",href:"https://in.linkedin.com/company/kpgu-vadodara",children:r.jsx(xk,{fontSize:"large"})}),r.jsx(qn,{sx:{color:"#fff"},size:"large",target:"_blank",href:"https://www.youtube.com/channel/UCpnW4eginLfg2rCcMjAn5dA",children:r.jsx(wk,{fontSize:"large"})})]})]})})]})}function gq(){const{maxWidth:e}=p.useContext(X),t=[{para:"The common man from the hardcore agronomist family visualized the dream in 2000 and crystallized the efforts to establish the BITS Edu Campus, now identified as a beacon of educational excellence. Now, the campus has emerged as one of the most sought-after institutions for technical education in the region. The mission derived from national aspirations with a global perspective achieved success due to the dynamic leadership of Shree Krishna Educational and Charitable Trust (SKECT), founded by Shree Jagdishbhai D. Patel: an ardent philosopher, philanthropist, and compassionate human being. His vision of inclusive governance has empowered each stakeholder in the organization to share efforts in the pursuit of excellence."},{para:"The basic education has shaped Shree Jagdishbhai D. Patel's mission. Despite merit, admission to BE was denied which resolute him before his father that no one would be deprived of admission in the future. This unwavering commitment laid the foundation for BITS Edu Campus and other educational initiatives, which stand today as a testament to his resolve and the divine inspiration of Lord Ganesha. The missed opportunity turned into a mission for sponsoring equitable access to technical education, leading to the construction of a holistic educational campus in 2003 under the SKECT head."},{para:"The BITS Edu Campus has prospered since 2004 at Varnama, Vadodara, offering UG, PG, PhD programs across engineering, pharmacy, healthcare, science, commerce, and management with steadfast support from his family and the dedicated staff. The vision has always been to create an environment conducive to academic excellence, supported by state-of-the-art infrastructure and a research-oriented faculty. BITS Edu Campus continues to play a pivotal role in shaping the industry-ready future workforce."},{para:"The ingenious efforts are further strengthened by support from both the Government of Gujarat and the Government of India through initiatives such as the “Student Startup & Innovation Policy (SSIP)”, the “BITS Innovation Centre”, and the “Centre for Entrepreneurship, Technology Incubation & Business Acceleration (CETIBA)”. Accordingly, the constituent schools have developed active collaborations with national and international institutions notably, Carleton University, Canada, the University of North Alabama (UNA), USA, the Catholic University of Murcia (UCAM), Spain, and North Southern Eastern University (NSU), Florida for nurturing a global educational ethos."},{para:"The academic and administrative governance of the campus is structured around seamless academic functions, and research, ensuring that all constituent schools become centers of global acclaim. For this, the campus consistently fosters creativity, innovation, and research, to ensure excellence so that students excel in an evolving global landscape."},{para:"In addition to his contributions to BITS, Shree Jagdishbhai D. Patel is the founder and promoter of Rudraksha Academy Pvt. Ltd. and established Dr. Kiran C. Patel Medical College & Research Institute in Bharuch, under the Public Private Partnership (PPP) model of Gujarat’s Health Policy 2016. His efforts have been widely recognized with numerous awards, including the Shiksha Bharti Award (2010)”, the “Samaj Ratna Award (2013)”, and the “Jewel of Baroda Award (2014)”. He has also been honored for his contributions during the COVID-19 pandemic with the “Corona Yodha Award (2020)” by the Collector and District Magistrate of Vadodara."},{para:"Besides, Shree Jagdishbhai D. Patel remains actively involved in various social organizations namely, Founder Trustee of “Sardardham and Kelvanidham”, Ahmedabad, Vice President of “Shri Saurashtra Leuva Patel Samaj”, Vadodara, and a Trustee of “RMS Hospital”, Dhandhuka, Ahmedabad, Gujarat. His appointment as a member of the Fee Regulatory Committee (Technical) by the Government of Gujarat further exemplifies his dedication to public service."},{para:"The inspiring leadership of the Founder President has transformed the BITS Edu Campus into a vibrant educational hub, renowned for its academic, co-curricular, and research-driven atmosphere. As SKECT continues its pursuit of newer horizons, it proudly bestows Drs. Kiran and Pallavi Patel Global University (KPGU) to advance India’s educational landscape, with assurance to reach stakeholder expectations."}],n=[{img:"https://res.cloudinary.com/dby2vbxv3/image/upload/v1703929293/KPGU/Images/Jagdishbhai_D_Patel.webp",name:"Shree Jagdishbhai D. Patel",designation:"Hon’ble Founder President & Managing Trustee"},{img:"https://res.cloudinary.com/dby2vbxv3/image/upload/v1703929293/KPGU/Images/Kamal_J_Patel.webp",name:" Smt. Kamalben J. Patel ",designation:"Trustee"},{img:"https://res.cloudinary.com/dby2vbxv3/image/upload/v1729238129/KPGU/Images/anand-desai-md-anupam-rasayan-5x5-671214417098c_ko4eq2.webp",name:" Shri Anand S. Desai",designation:"Trustee"},{img:"https://res.cloudinary.com/dby2vbxv3/image/upload/v1729238348/KPGU/Images/jitendrabhai-patel-6712153d7a439_obh5dv.webp",name:"Shri Jitendra C. Patel",designation:"Trustee"}],a=({img:i,name:o,designation:s})=>r.jsx(k,{item:!0,xs:12,sm:6,md:4,lg:3,children:r.jsxs(w,{className:"smooth-shadow-card h-100",bgcolor:"#fff",borderRadius:4,overflow:"hidden",children:[r.jsx(w,{children:r.jsx("img",{src:i,alt:"photo",className:"img-fluid"})}),r.jsxs(w,{p:2,children:[r.jsx(w,{children:r.jsx("h4",{className:"fw-bold ",children:o})}),r.jsx(w,{children:r.jsx("h6",{className:"color-secondary fw-bolder",style:{fontSize:"18px"},children:s})})]})]})});return r.jsxs(r.Fragment,{children:[r.jsxs(hi,{children:[r.jsx("title",{children:"Shree Krishna Educational & Charitable Trust (SKECT)"}),r.jsx("meta",{name:"description",content:"Welcome to the Shree Krishna Educational & Charitable Trust (SKECT). Discover our commitment to educational excellence and our journey towards becoming a hub for academic and professional development."})]}),r.jsxs(w,{maxWidth:e,mx:"auto",p:"5%",children:[r.jsx("h4",{className:"display-6 fw-semibold mb-4",children:"Shree Krishna Educational & Charitable Trust [SKECT]"}),t.map(({para:i},o)=>r.jsx(Je,{content:[i]},o)),r.jsx(k,{container:!0,mt:10,spacing:3,children:n.map(({designation:i,img:o,name:s},l)=>r.jsx(a,{designation:i,img:o,name:s},l))})]})]})}function vq(){const{maxWidth:e,innerWidth:t}=p.useContext(X),[n,a]=p.useState("1"),i=(c,d)=>{a(d)},o=[{des:"A great visionary philosopher and philanthropist driven by his aspirations for a Global Outlook, the Founder President, and Managing Trustee of Shree Krishna Educational & Charitable Trust (SKECT), Shree Jagdishbhai D. Patel has been an ardent dynamic leader known for his passion for Excellence and relentless actions. Over the decades, he has transformed himself into a proactive administrator with the capacity to execute mega-projects associated with education, healthcare, and nursing sectors through his unique model consisting of Conception, Collaboration, Strategic Execution, completion of the projects & making them self-sustained, progressive institutions in tune with the advances of the world."},{des:"In the past, the missed opportunities led him to an altruistic introspection about professional education, that motivated him to work for an equitable technical education. It’s here that, the mission of developing a Holistic Educational Campus to provide quality professional education was conceived to establish the BITS Edu Campus in 2003."},{des:"Due to the abundant grace of Lord Shree Siddhivinayak and the relentless efforts of Shree Jagdishbhai D. Patel, the institution successfully introduced academic programs at undergraduate and postgraduate levels in Pharmacy, Physiotherapy, Ayurveda, Nursing, and Sciences. This milestone not only expanded the academic horizons but also strengthened the status for upholding the principles of quality education, discipline amongst students, cultural ethos, and a commitment to a sustainable environment on the campus."},{des:"With the patronage of Hon’ble founder President Shree Jagdishbhai D. Patel and consistent academic growth, Drs. Kiran & Pallavi Patel Global University (KPGU), Vadodara was established in 2021. The university introduced various programs like Diploma Engineering, Chemical Engineering, Food Technology (B. Tech), GNM (Nursing), B.B.A., B.Com, B.A., and Master's programs in Computer Science, Computer Engineering, and IT. Moreover, Ph.D. programs in Engineering, Pharmacy, Management, Science, and Physiotherapy were started for the benefit of students which placed KPGU at the forefront among the leading private universities in Gujarat."},{des:'The institution offered numerous Freeships and Scholarships amounting to ₹ 16.20 Crores allocated to support meritorious underprivileged students since its inception. Besides, special initiatives such as the "Vidhava Kanya Kelavani Sahay" for the education of the girl child of widows, and the "Vidhava Kuldipak Kelavani Sahay" for the boy child of widows, practiced to support over four years. Moreover, four-year tuition fee waivers have been rendered to student aspirants admitted from Dhandhuka Taluka, as a tribute to his motherland.'},{des:"He has been actively contributing to the social cause of numerous organizations. He is the Founder and Promoter of Dr. Kiran C. Patel Medical College & Research Institute (KMCRI), Bharuch. He has been the Vice-President of Shri Sourashtra Leuva Patel Seva Samaj, Vadodara, Trustee of RMS Hospital, Dhandhuka, Founder Trustee of Kelavani Dham, Sardar Dham, Ahmedabad, Shree Siddhivinayak Temple, President of Shri Vighneshwari Charitable Trust: “Anandima No Vadalo”, Mansa, to name a few."},{des:"He is the recipient of various Awards, including the Education Leadership Award, Global Education Excellence Award, Samaj Ratna Award, Indira Gandhi Shiksha Shiromani Award, Shiksha Bharti Award, and Samaj Gaurav Award. He was also appointed as a member of the Fee Regulatory Committee (Technical) by the Government of Gujarat for the period of 2020-to-2023 and extended for another term from April 2024 onwards."},{des:"The inherent dynamic qualities, a mission mode approach adopted for Quality & Excellence, and vast experience out of completing several milestones in the past 20 years span assisted the SKECT in shaping Drs. Kiran & Pallavi Patel Global University (KPGU), Vadodara for the greater cause of higher professional education."},{des:"The vision and mission articulated by Hon’ble Founder President, Shree Jagdishbhai D. Patel, to establish Drs. Kiran & Pallavi Patel Global University (KPGU) Vadodara as the first foreign university campus in Gujarat now appears to be a reality due to the transformative framework of the National Education Policy (NEP) 2020 and active cooperation rendered by Dr. Kiran C. Patel, a distinguished Indian American Philanthropist, who is closely associated with KPGU, Vadodara. The ingenious efforts of Dr. Kiran C. Patel made the top-ranked US-based university operational under his patronage is set to collaborate with KPGU, Vadodara, and establish Gujarat's first foreign university campus, adhering to international benchmarks and standards, ensuring a bright future for our students."}],s=[{des:"Dr. Kiran C. Patel grew up ethnically to Asian-Indian Parents in Africa, was educated under the British Educational System, and then got his Diplomas from Cambridge University and The University of London. Then, he graduated in Medicine at Medical College in Gujarat, did his residency in Internal Medicine in New Jersey, and completed a Cardiology program affiliated with Columbia University of New York. Thereafter, Dr. Kiran Patel began his practice in cardiology for over four decades and soon became a distinguished Cardiologist in Tampa, Florida. This experience motivated him to develop a Physician Practice Management Company which provided 14 practices, including family medicine, internal medicine, pediatrics, and cardiology to serve more than 8000 patients which helped him to form a multi-specialty network. His success in Managed Care Contracts led to the foundation of Well Care HMO, Inc. to work with several hospitals in the USA. These efforts recognized Dr. Kiran Patel to serve as Chairman of Visionary Medical Systems and prompted to establishment of Drs. Kiran C. Patel and Pallavi Patel Family Foundation for the betterment of the world through health, education, and culture and respond in times of need."},{des:"Over the period, Dr. Kiran C Patel has witnessed a paradigm shift in higher education & healthcare fostered by the ethos of service to humankind and observed its impact the world over, especially in the context of his motherland, India. In recognition of his efforts, the Govt. of India has felicitated him with Pravasi Bharatiya Samman."},{des:"He has been making earnest endeavors to enhance the standards of higher education with high-quality, career-driven, globalized pedagogy in the centre of excellence. Towards this end, he has established centres of importance worldwide namely, Nova Southeastern University, University of South Florida, Centre for Global Solutions in the US, and Centre for Sustainable Development at IIT Gandhinagar. He has contributed over $ 800 million in charity for the said cause. India has remained at the centre of active collaboration in all endeavors. He established Dr. Kiran Patel Medical College & Research Center (KMCRI) at Bharuch in Gujarat."},{des:"To further his aspirations for the people of India and Gujarat more objectively, he ideated the establishment of Drs. Kiran & Pallavi Patel Global University (KPGU) at Varnama, Vadodara under the sponsorship of Shree Krishna Educational & Charitable Trust (SKECT), to transform the science and technology domain to bring dynamics of societal change. In a tribute to his motherland and to provide global-level education to student aspirants from Gujarat, Dr. Kiran C. Patel is taking ingenious efforts to bring a prestigious top-ranked university from the USA, which is operational under his cooperation and inspiration to collaborate with KPGU, Vadodara, and establishing Gujarat's first foreign university campus as per the framework of the National Education Policy (NEP) 2020, adhering to international benchmarks and standards. This milestone marks a bright future for students and stands as a testament to Dr. Kiran C. Patel's unwavering commitment to education in his homeland and further expects that KPGU, Vadodara shall be the Gateway to Global Excellence in its true sense."}],l=[{des:"Smt. Kamalben J. Patel is an enthusiastic visionary leader dedicated to social upliftment and women’s empowerment through education, skill development, and healthcare. As the Founder Trustee of the Shree Krishna Educational & Charitable Trust (SKECT) in Vadodara, Smt. Kamalben J. Patel has been instrumental in advancing the vision of higher education, health care, and service to the humanity. Her extensive involvement with various educational institutions, industrial units, and NGOs highlights her commitment to holistic student development."},{des:"Notably, she is the promoter of the Dr. Kiran C. Patel Medical College and Research Institute (KMCRI) in Bharuch, Vadodara. Smt. Patel has also played a pivotal role in realizing the collective dream of establishing the Drs. Kiran & Pallavi Patel Global University (KPGU), Vadodara, which aims to be an institution of universal excellence, fostering the growth of all its stakeholders."}];return r.jsxs(r.Fragment,{children:[r.jsxs(hi,{children:[r.jsx("title",{children:"KPGU'S LEADERSHIP"}),r.jsx("meta",{name:"description",content:"Meet the visionary leaders driven the mission of Drs. Kiran & Pallavi Patel Global University (KPGU). From the dynamic grassroots leadership of Shree Jagdishbhai D. Patel, Founder President & Managing Trustee, to the philanthropic endeavors of Dr. Kiran C Patel, Patron, and the inspiring leadership of Smt. Kamalben J. Patel, Chairman & Vice Managing Trustee, discover the commitment to educational excellence, innovation, and societal impact."})]}),r.jsxs(w,{maxWidth:e,mx:"auto",p:"5%",children:[r.jsx(Ke,{value:n,children:r.jsx(w,{className:"smooth-shadow",bgcolor:"rgba(256, 256, 256, 0.6)",sx:{backdropFilter:"blur(10px)",borderRadius:"20px 20px 0 0"},p:2,position:"sticky",top:0,mb:4,maxWidth:e,mx:"auto",zIndex:99999999,children:r.jsxs(Ve,{onChange:i,"aria-label":"lab API tabs example",orientation:"horizontal",textColor:"secondary",indicatorColor:"secondary",variant:`${t<700?"scrollable":"fullWidth"}`,children:[r.jsx(G,{className:"align-items-center fw-bolder fs-5",label:"Shree Jagdishbhai D. Patel",value:"1",href:"#shree-jagdishbhai-d-patel"}),r.jsx(G,{className:"align-items-center fw-bolder fs-5",label:"Dr. Kiran C. Patel",value:"2",href:"#dr-kiran-c-patel"}),r.jsx(G,{className:"align-items-center fw-bolder fs-5",label:"Smt. Kamalben J. Patel",value:"3",href:"#smt-kamalben-j-patel"})]})})}),r.jsx("div",{id:"shree-jagdishbhai-d-patel",children:r.jsxs(k,{container:!0,className:"smooth-shadow",borderRadius:3,overflow:"clip",children:[r.jsx(k,{item:!0,bgcolor:"#fff",xs:12,md:4,children:r.jsx(w,{className:"w-100 h-100 ",children:r.jsx("img",{src:"https://res.cloudinary.com/dby2vbxv3/image/upload/v1703929293/KPGU/Images/Jagdishbhai_D_Patel.webp",className:"w-100 h-100 object-fit-cover",alt:"photo"})})}),r.jsxs(k,{item:!0,bgcolor:"#fff",xs:12,md:8,p:2,children:[r.jsx("h3",{className:"display-5 fw-semibold",children:"Shree Jagdishbhai D. Patel"}),r.jsxs("p",{className:"fs-4 mb-2",children:[r.jsx("b",{children:" Hon’ble Founder President"}),r.jsx("br",{}),"Drs. Kiran & Pallavi Patel Global University (KPGU), Vadodara"]}),r.jsxs("p",{className:"fs-4 mb-2",children:[r.jsx("b",{children:"Hon’ble Founder President & Managing Trustee"})," ",r.jsx("br",{}),"Shree Krishna Educational & Charitable Trust (SKECT), Vadodara (Sponsoring Body of KPGU Vadodara)"]}),r.jsxs("p",{className:"fs-4 mb-2",children:[r.jsx("b",{children:"Hon'ble Founder & CEO"}),r.jsx("br",{}),"Dr. Kiran C. Patel Medical College & Research Institute (KMCRI), Bharuch."]}),r.jsx(Qe,{quote:"Education is not meant merely to earn a degree; rather, it is an earnest pursuit of nurturing academic, co-academic, career, and global citizenship traits that foster the attainment of life goals."})]})]})}),r.jsx(w,{mt:5,children:o.map(({des:c},d)=>r.jsx(Je,{content:[c]},d))}),r.jsxs("div",{id:"dr-kiran-c-patel",children:[r.jsxs(k,{container:!0,className:"smooth-shadow",borderRadius:3,overflow:"clip",mt:3,children:[r.jsx(k,{item:!0,bgcolor:"#fff",xs:12,md:4,children:r.jsx(w,{className:"w-100 h-100 ",children:r.jsx("img",{src:"https://res.cloudinary.com/dby2vbxv3/image/upload/v1703929293/KPGU/Images/Dr_Kiran_C_Patel.webp",className:"w-100 h-100 object-fit-cover",alt:"photo"})})}),r.jsxs(k,{item:!0,bgcolor:"#fff",xs:12,md:8,p:2,children:[r.jsx("h3",{className:"display-5 fw-semibold",children:"Dr. Kiran C. Patel"}),r.jsxs("p",{className:"fs-4 mb-2",children:[r.jsx("b",{children:"Hon’ble President"}),r.jsx("br",{}),"Drs. Kiran & Pallavi Patel Global University (KPGU), Vadodara"]}),r.jsxs("p",{className:"fs-4 mb-2",children:[r.jsx("b",{children:"Hon’ble Chairman"}),r.jsx("br",{}),"Dr. Kiran C. Patel Medical College & Research Institute (KMCRI), Bharuch"]}),r.jsxs("p",{className:"fs-4 mb-2",children:[r.jsx("b",{children:"Indian-American Philanthropist & Cardiologist"})," ",r.jsx("br",{}),"Tampa, Florida, USA"]}),r.jsx(Qe,{quote:"Follow your dreams, but understand that there is no shortcut in life. Passion and hard work, persistence, and remaining focused on what you want to achieve. Don't expect miracles, there is no microwave in life, you have to earn it the hard way."})]})]}),r.jsx(w,{mt:5,children:s.map(({des:c},d)=>r.jsx(Je,{content:[c]},d))})]}),r.jsxs("div",{id:"smt-kamalben-j-patel",children:[r.jsxs(k,{container:!0,className:"smooth-shadow",borderRadius:3,overflow:"clip",children:[r.jsx(k,{item:!0,bgcolor:"#fff",xs:12,md:4,children:r.jsx(w,{className:"w-100 h-100 ",children:r.jsx("img",{src:"https://res.cloudinary.com/dby2vbxv3/image/upload/v1703929293/KPGU/Images/Kamal_J_Patel.webp",className:"w-100 h-100 object-fit-cover",alt:"photo"})})}),r.jsxs(k,{item:!0,bgcolor:"#fff",xs:12,md:8,p:2,children:[r.jsx("h3",{className:"display-5 fw-semibold",children:"Smt. Kamalben J. Patel"}),r.jsxs("p",{className:"fs-4 mb-2",children:[r.jsx("b",{children:"Governing Body Member"})," ",r.jsx("br",{}),"Drs. Kiran & Pallavi Patel Global University (KPGU), Vadodara"]}),r.jsxs("p",{className:"fs-4 mb-2",children:[r.jsx("b",{children:"Trustee"}),r.jsx("br",{}),"Shree Krishna Educational & Charitable Trust (SKECT), Vadodara (Sponsoring Body of KPGU Vadodara)"]}),r.jsx(Qe,{quote:"Every woman is strong, an embodiment of strength & sacrifice Empower her with equity she shall nurture the humankind"})]})]}),r.jsx(w,{mt:5,children:l.map(({des:c},d)=>r.jsx(Je,{content:[c]},d))})]})]})]})}function us({name:e,des:t,img:n,link:a}){const i=xt();return r.jsx(k,{item:!0,xs:12,sm:6,md:4,children:r.jsx(w,{className:"smooth-shadow-card h-100",borderRadius:4,position:"relative",overflow:"clip",bgcolor:"#fff",children:r.jsxs(w,{p:2,children:[r.jsx(He,{variant:"h6",fontWeight:600,mb:1,color:"secondary.main",children:e}),r.jsx(He,{variant:"body1",fontWeight:600,color:"#535353",mb:3,textAlign:"justify",children:t}),r.jsx("br",{}),r.jsx($,{target:"_blank",variant:"contained",color:"secondary",endIcon:r.jsx(ze,{}),sx:{position:"absolute",bottom:16},onClick:()=>i(a),children:"View more"})]})})})}function bq(){const{maxWidth:e}=p.useContext(X),t=[{title:"Krishna School of Emerging Technology and Applied Research",link:"/academics/krishna-school-of-emerging-technology-and-applied-research"},{title:"Krishna School of Diploma Studies",link:"/academics/krishna-school-of-diploma-studies"},{title:"Krishna School Of Technology",link:"/academics/krishna-school-of-technology"},{title:"Krishna School of Science",link:"/academics/krishna-school-of-sciences"},{title:"Krishna School of Physiotherapy and Rehabilitation",link:"/academics/krishna-school-of-physiotherapy-and-rehabilitation"},{title:"Krishna Ayurved Medical College with attached Matrushri Davalba Ayurved Hospital",link:"/academics/krishna-ayurved-medical-college"},{title:"Krishna School of Pharmacy and Research",link:"/academics/krishna-school-of-pharmacy-and-research"},{title:"Krishna School of Nursing",link:"/academics/krishna-school-of-nursing"},{title:"Krishna School commerce",link:"/academics/krishna-school-of-commerce"},{title:"Krishna School of Business Management",link:"/academics/krishna-school-of-business-management"},{title:"Krishna School of Arts and Humanities",link:"/academics/krishna-school-of-arts-and-humanities"}];return r.jsxs(w,{maxWidth:e,mx:"auto",p:"5%",children:[r.jsxs(hi,{children:[r.jsx("title",{children:"Significant Achievements of Krishna Edu Campus"}),r.jsx("meta",{name:"description",content:"Explore the remarkable achievements of Krishna Edu Campus, established by Shree Krishna Educational and Charitable Trust (SKECT). Since its inception in 2004, the campus has been a beacon of educational excellence, offering equitable professional education in engineering, pharmacy, nursing, physiotherapy, ayurveda, and pure science programs. Discover the milestones, including establishment of state-of-the-art infrastructure, research initiatives, industry collaborations, academic awards, and student achievements that have shaped the campus into a hub of academic and professional growth."})]}),r.jsx("h4",{className:" fw-semibold color-secondary",children:"KPGU'S SPONSORING"}),r.jsx("h3",{className:"display-4 fw-semibold mb-4",children:"SIGNIFICANT ACHIEVEMENTS"}),r.jsx(Je,{content:["The Krishna Edu Campus, established by Shree Krishna Educational and Charitable Trust (SKECT), today, stands testimony as the significant hub for educational excellence, consistently in the pursuit of newer horizon. Since, its inception during the year 2004, the institutions run by it has been providing equitable professional education offering programs, the most sought-after by meritorious students in Engineering, Pharmacy, Nursing, Physiotherapy, Ayurveda and Pure Science, both at UG & PG level in an environment conducive for academic and professional growth. The significant milestones include:"]}),r.jsxs("ol",{children:[r.jsx("li",{className:"fs-5 mb-3 text-capital fw-semibold ",children:"Established Shree Krishna Educational & Charitable Trust in 2004"}),r.jsx("li",{className:"fs-5 mb-3 text-capital fw-semibold ",children:"Established Krishna Edu Campus built on a sprawling 27 Acres of green campus with landscapes,gardens & serene environs."}),r.jsx("li",{className:"fs-5 mb-3 text-capital fw-semibold ",children:"Provided institutions with 8.42 Lakhs Sq.Mt. of the State-of-the-Art Infrastructure for Academic, and Research & Skills Building Functions."}),r.jsx("li",{className:"fs-5 mb-3 text-capital fw-semibold ",children:"Established the following Eight Professional Institutions and Three none Professional Institutions."}),r.jsx(k,{container:!0,my:5,spacing:4,children:t.map(({des:n,img:a,title:i,link:o},s)=>r.jsx(us,{name:i,des:n,img:a,link:o},s))}),r.jsx("li",{className:"fs-5 mb-3 text-capital fw-semibold ",children:"These 11 institutions offers 17 UG programs that include Bachelor of Engineering (6 branches), B Pharm, BPT, BAMS, BSc (Nursing), BSc ( Science) with intake of 1035 students and 20 PG Programs including Master of Engineering (2 branches), M Pharm (4 branches), MPT (3 branches) and MSc. (3 branches) with overall intake of 135 students."}),r.jsx("li",{className:"fs-5 mb-3 text-capital fw-semibold ",children:"Highly committed, motivated, highly qualified, well-experienced, research driven, employability-oriented faculty and equally competent non-teaching staff nurtured."}),r.jsx("li",{className:"fs-5 mb-3 text-capital fw-semibold ",children:"Comprehensive Research Policy is implemented to motivate faculty and students to conduct quality & high impact research, that has led to conduct of 101 Research Projects amounting to Rs 120 Lakhs from AICTE, SSIP & SOIC & GUJCOST and 4.50 crores from SSIP and SIOC."}),r.jsx("li",{className:"fs-5 mb-3 text-capital fw-semibold ",children:"The University has created"}),r.jsx("li",{className:"fs-5 mb-3 text-capital fw-semibold ",children:"Total of 331 scientific papers published in reputed, highly acclaimed Journals with high impact factors."}),r.jsx("li",{className:"fs-5 mb-3 text-capital fw-semibold ",children:"Institute Innovation Cell (IIC) under MHRD, Biotechnology Incubator under Gujarat Biotechnology Policy and Entrepreneurship Development Cell in Collaboration with National Entrepreneurship Network established and Engineering & Pharmacy colleges recognised as Nodal Institute under Assistance to Start-Up/ Innovation."}),r.jsx("li",{className:"fs-5 mb-3 text-capital fw-semibold ",children:"Centre for Entrepreneurship, Technology Incubation & Business Acceleration (CETIBA)-District Training Centre by SPIPA."}),r.jsx("li",{className:"fs-5 mb-3 text-capital fw-semibold ",children:"Entered into MOU with 6 Industrial Associations, 44 Industries and 15 students’ start-ups incubated."}),r.jsx("li",{className:"fs-5 mb-3 text-capital fw-semibold ",children:"Towards Collaborations, the institutions are encouraged to enter into active collaborations with Regional, National International organizations, Universities and Industries to facilitate Student and Staff Mobility, high Impact Collaborative Research, establish Collaborative Joint-Programs and to provide platform for knowledge sharing, thereby enriching skills, knowledge and attitudes of our stakeholders to face the ever-changing paradigms in the emerging educational field. Apart from number of regional & national collaborations, the institutes have fostered active collaboration with Carleton Global Academy-Carleton University, Canada, University of North Alabama (UNA), USA, Catholic University of Murcia (UCAM), Spain and North Southern Eastern University (NSU), Florida."}),r.jsx("li",{className:"fs-5 mb-3 text-capital fw-semibold ",children:"Made available, the Freeships & scholarships worth Rs 5 Crores for deserving, meritorious and economically weak students."}),r.jsx("li",{className:"fs-5 mb-3 text-capital fw-semibold ",children:"Library and Information Centre with the built-up area of 20000 Sq. Ft., accommodating 1000 students at a time consists of rich collection of Text books, Reference Books, e-Resources, national & international journals, periodicals and newspapers, rare books with total library resource holding of 59314 with cumulative expenditure to the tune of over Rupees Two Crores."}),r.jsx("li",{className:"fs-5 mb-3 text-capital fw-semibold ",children:"Library is made fully automated with Library Management System with RFID (Radio Frequency Identification System) Technology with SOUL2.0 (Software made by INFLIBNET) Centre."}),r.jsx("li",{className:"fs-5 mb-3 text-capital fw-semibold ",children:"Computer centre is equipped with 52 Computers with dedicated leased Wi-Fi connection."}),r.jsx("li",{className:"fs-5 mb-3 text-capital fw-semibold ",children:"Campus has been provided with ICT enabled Smart Class rooms internet & campus wide Wi-Fi, Computer Laboratory, Gymnasium, Transport facility, Auditorium, Sports ground etc., Student Community Learning Club, Shopping Complex, Banks & ATM, Parking, Security posts, Student cell such as Anti-ragging Cell, Anti-Sexual harassment Cell, Anti-discrimination cell, Career and Placement Cell and Community Learning Club."}),r.jsx("li",{className:"fs-5 mb-3 text-capital fw-semibold ",children:"Our institutions have been producing good results and our students have consistently been getting academic Gold Medals from their respective universities. Our results range between 70% to 90% in UG programs and 90% to 100% in PG programs and our students have, till date received 18 Gold Medals."}),r.jsx("li",{className:"fs-5 mb-3 text-capital fw-semibold ",children:"Career Counseling and Placements cell is industry driven and our placement has been on an average 80% students who register for placement drives."}),r.jsx("li",{className:"fs-5 mb-3 text-capital fw-semibold ",children:"Awards; our institutions and student have been receiving recognition awards signifying their involvement and strength in those areas. So far 40 Recognition Awards haven received in recognition of leadership, distinguished services, outstanding achievements, NSS, blood donation, Thalassemia drive, best student award, sports award (University Blue)"}),r.jsx("li",{className:"fs-5 mb-3 text-capital fw-semibold ",children:"Hostels are available for both Boys (155 rooms) and Girls hostel (56 rooms) with all modern amnesties including AC facilities. Hygienic, modern mess & Cafeteria cater to the varied taste of the student community. Also, Tea-post & Nescafe joints are available near sports and recreational zone."})]})]})}function yq(){const{maxWidth:e,innerWidth:t}=p.useContext(X),n=xt(),[a,i]=p.useState("1"),o=(m,f)=>{i(f)},s=["Diploma Programs","Undergraduate Programs","Postgraduate Programs","Doctoral Programs"],l=(