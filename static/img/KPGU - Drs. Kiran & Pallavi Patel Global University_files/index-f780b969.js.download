",borderRadius:4,className:"smooth-shadow",children:[r.jsx(gr,{title:"Krishna School of Technology (KST)"}),r.jsx(vr,{dirImg:"https://res.cloudinary.com/dby2vbxv3/image/upload/v1708500691/KPGU/Faculty%20Images/KSET/Director.webp",dirEmail:"dir.kst@kpgu.ac.in",dirName:"Dr. Nitesh Sureja",dirOf:"Krishna School of Technology",dirOfShort:"[KST]",dirMessage:["Welcome to Krishna School of Technology (KST), a constituent institute of Drs. Kiran and Pallavi Patel Global University, Vadodara, Gujarat, INDIA, where the pursuit of knowledge and the passion for innovation converge to shape the future. As the Director of this esteemed institution, it is both an honor and a privilege to extend a warm greeting to all members of our vibrant academic community.Welcome to Krishna School of Technology (KST), a constituent institute of Drs. Kiran and Pallavi Patel Global University, Vadodara, Gujarat, INDIA, where the pursuit of knowledge and the passion for innovation converge to shape the future. As the Director of this esteemed institution, it is both an honor and a privilege to extend a warm greeting to all members of our vibrant academic community.","Our institute stands at the forefront of engineering education, driven by a commitment to excellence and a dedication to nurturing the next generation of leaders and innovators. We believe that engineering is not merely a field of study, but a gateway to transforming ideas into reality and solving the complex challenges of our world.","At KST, we offer more than just a curriculum; we provide an environment that fosters creativity, critical thinking, and collaboration. Our world-class faculty, state-of-the-art facilities, and robust industry connections ensure that our students receive a comprehensive education that prepares them for the dynamic demands of the engineering profession.","We emphasize a holistic approach to learning, combining rigorous academic instruction with hands- on experience and real-world applications. Our strong industry ties and research initiatives provide our students with unparalleled opportunities to engage in ground breaking projects and make meaningful contributions to their fields of interest. Our institute’s values are grounded in integrity, innovation, and excellence, and we strive to uphold these principles in all that we do.","As we move forward, our focus remains on continuously evolving our programs and resources to stay ahead of emerging trends and technologies. We are excited about the future and the endless possibilities that lie ahead for our students, faculty, and the engineering profession as a whole.","Thank you for being a part of the KST family. Together, let us embark on this journey of discovery, learning, and growth, and make a positive impact on the world.","With best regards,"]})]})}),r.jsx("div",{style:{padding:"40px 0 0 0"},id:"department",children:r.jsxs(w,{maxWidth:e,mx:"auto",p:"3%",bgcolor:"#fff",borderRadius:4,className:"smooth-shadow",children:[r.jsx("h2",{className:"fw-bold color-secondary mb-4",children:"Department"}),r.jsx(k,{container:!0,spacing:4,children:o.map(({img:l,name:c,link:d},u)=>r.jsx(s,{img:l,name:c,link:d},u))})]})}),r.jsx("div",{style:{padding:"40px 0 0 0"},id:"program",children:r.jsx(Br,{Programs:Bq.Programs})})]})}function iY(){const{maxWidth:e,innerWidth:t}=p.useContext(X),n=xt();p.useState("1");const[a,i]=p.useState("1"),o=(c,d)=>{i(d)},s=[{img:"https://res.cloudinary.com/dby2vbxv3/image/upload/v1708498523/KPGU/icon/comuter-science.svg",name:"COMPUTER SCIENCE AND ENGINEERING",link:"/academics/ksds/computer-science-and-engineering"},{img:"https://res.cloudinary.com/dby2vbxv3/image/upload/v1708498523/KPGU/icon/infromation-tech.svg",name:"information technology",link:"/academics/ksds/information-technology"},{img:"https://res.cloudinary.com/dby2vbxv3/image/upload/v1708498523/KPGU/icon/electrical-engineering.svg",name:"electrical engineering",link:"/academics/ksds/electrical-engineering"},{img:"https://res.cloudinary.com/