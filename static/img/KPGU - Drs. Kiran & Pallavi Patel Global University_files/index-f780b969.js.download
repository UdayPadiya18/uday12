e:"smooth-shadow",children:r.jsx(vr,{dirImg:"https://res.cloudinary.com/dby2vbxv3/image/upload/v1720073518/KPGU/Images/devendra-yadav.webp",dirEmail:"placement@kpgu.ac.in",dirName:"Devendra Singh Yadav",dirOf:"Training & Placement and Industry - Academia Relation Cell",dirMessage:["Since its advent, Drs Kiran & Pallavi Patel Global University (formerly known as Babaria Institute of technology) has had the vision to provide quality education and research, as well as a mission to develop students an Industry ready. In accordance with this vision, KPGU Vadodara has maintained an exemplary record of academic contribution to achieving excellence in teaching and research.","The students usually come from varied educational, social and cultural backgrounds. The academic programs are designed to instill innovation, leadership, teamwork, and global focus in its students. Our alumni have excelled in every field, be it the core engineering, research and teaching, consulting and investment banking, IT and ITES, or administrative and social sectors. They really have made us proud!","KPGU has an excellent recruitment record. The graduates and postgraduates of KPGU have been selected by some of the world’s leading corporations, as well as most of the leading Indian corporations. I welcome both the recruiters and our graduating students to come to this platform and get the best out of each other. A special invitation to all organizations and corporations! Do Come to the campus and test our budding talents. We will be happy to receive your suggestions to further improve the process of recruitment.","Welcome you all to KPGU Campus."]})})]})}function eie(){const{maxWidth:e}=p.useContext(X),t=["To provide students with the resources, tools, and guidance they need to explore career options and make informed decisions.","To support students in their job search efforts and provide ongoing career support throughout their professional journey.","To assist students in developing the skills and competencies necessary to succeed in the workforce.","To connect students with potential employers and job opportunities.","To offer Industrial reach for students skilling"],n=["Excellent infrastructure with separate group discussion rooms, interview rooms, state of the art seminar hall","Systematic and continuous placement oriented soft skills training by professional trainers","Frequent Seminars/Expert lectures for guiding the students to post graduation","Preferred venue by leading MNC’s for off campus recruitment events","Strong support by alumni for student guidance & placements","Strong Industry connect leading to good placements","English Laboratory to enhance language proficiency"];return r.jsxs(r.Fragment,{children:[r.jsx(An,{banner:{title:"T&P and Industry-Academia Cell",img:"https://res.cloudinary.com/dby2vbxv3/image/upload/v1702100388/KPGU/Banners/banner-2.jpg"}}),r.jsxs(w,{maxWidth:e,mx:"auto",p:"3%",bgcolor:"#fff",mt:7,borderRadius:4,className:"smooth-shadow",children:[r.jsx("h3",{className:"fw-bold color-secondary",children:"Training & Placement and Industry - Academia Relation Cell"}),r.jsx("h5",{className:"fw-bold color-secondary mt-4 mb-3",children:"About"}),r.jsx(Je,{content:["The Training & Development cell is to empower students to achieve their career aspirations by providing them with the necessary support, guidance, and resources. The Centre is committed to promoting a culture of lifelong learning and to helping students acquire the skills and knowledge needed to succeed in a rapidly changing job market.","The primary objective of T&P Cell is to provide students with a variety of career-related services, Placements and Industry exposure that will help them to prepare for, enter, and succeed in the workforce. "]}),r.jsx("h5",{className:"fw-bold color-secondary mt-5 mb-3",children:"The key objectives"}),r.jsx(k,{container:!0,spacing:4,justifyContent:"center",children:t.map(a=>r.jsx(k,{item:!0,xs:12,sm:6,md:4,children:r.jsx(w,{className:"smoo