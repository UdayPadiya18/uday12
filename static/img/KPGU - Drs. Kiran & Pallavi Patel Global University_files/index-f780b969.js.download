ssName:"smooth-shadow-card h-100",borderRadius:4,overflow:"hidden",children:[r.jsx(w,{children:r.jsx("img",{src:a,alt:"",className:"w-100"})}),r.jsx(w,{p:2,children:r.jsx("h4",{className:"fw-bold color-secondary",children:n})})]})});return r.jsxs(w,{borderRadius:4,children:[r.jsx("h2",{className:"fw-bold color-secondary fs-1 mb-4",children:"Honors - Minors Offered Broadly"}),r.jsx(k,{container:!0,spacing:4,children:e.map(({title:n,img:a},i)=>r.jsx(t,{img:a,title:n},i))})]})}function cre(){const e=[{title:"POWER ELECTRONICS LAB",des:["To enable students, understand the operation of semiconductor devices and power electronics converters, the laboratory is equipped with experimental set-ups where students are exposed to design-based experiments. The laboratory also enables students to carry out UG projects effectively.","Thyristor converters, DC chopper modules, power devices such as Thyristors, Power MOSFETs, IGBTs of various voltage and current ratings, Opto-Isolators, Pulse transformers and other related commutating components are there in the laboratory.","A Number of modules of AC-DC converters, voltage controllers – single phase as well as three phase, DC chopper units and inverters using Power MOSFETs and IGBTs, solid state soft start units for three phase induction motors have been built in the last five years as project works of UG students."],img:"https://res.cloudinary.com/dby2vbxv3/image/upload/v1721902959/KPGU/Images/Labs/KSET-Electrical-Engineering/power-electronics-lab-kset-and-ksds-11-37-66a227220bda4_yqguwx.webp"},{title:"ELECTRICAL MEASUREMENT AND INSTRUMENTATION LABORATORY",des:["This is the lab which is very important for the basic knowledge about the various instruments with facilities for the group of 20 students to carry out experiments independently.","The lab is equipped with latest technologies in electrical measurement and instrumentation such as Kelvin Bridges, Wheatstone’s bridges, energy meters, digital multi meters, etc. It ensures that the students become experts in practical knowledge related to electrical measurement process under the guidance of faculty members from the Department of Electrical Engineering. The lab is well equipped and enables students to understand the fundamentals of various measuring instruments.","Major Equipment in Measurement and instrumentation Lab areLVDT(Linear Variable differential transformer), Thermocouple, pressure gauge, Resistance strain gauge etc."],img:"https://res.cloudinary.com/dby2vbxv3/image/upload/v1721902960/KPGU/Images/Labs/KSET-Electrical-Engineering/electrical-measurement-and-instrumentation-laboratory-kset-and-ksds-2-38-66a227195697b_cjhizr.webp"},{title:"HIGH VOLTAGE ENGINEERING LABORATORY",des:["A state-of-the-art laboratory is designed to provide platform for basic studies. It offers testing facilities for the power apparatus insulators. This laboratory helps students to understand the various aspects of insulation and phenomenon like lightning and surges in electrical power system.",""],img:"https://res.cloudinary.com/dby2vbxv3/image/upload/v1721902960/KPGU/Images/Labs/KSET-Electrical-Engineering/high-voltage-engineering-laboratory-kset-and-ksds-10-42-66a2271d837b2_gfy5fi.webp"},{title:"POWER SYSTEM PROTECTION LABORATORY",des:["A protection laboratory equipped with number of relays including numerical relays for transformer, and motor protection has been developed. This laboratory is useful to the students of UG in getting up-to-date knowledge of the working of various types of relays by actual demonstration on in-house designed panels."],img:"https://res.cloudinary.com/dby2vbxv3/image/upload/v1721902959/KPGU/Images/Labs/KSET-Electrical-Engineering/power-system-protection-laboratory-kset-and-ksds-12-41-66a22725b7d7a_tknj51.webp"},{title:"ELECTRICAL WORKSHOP LAB",des:["The workshop is used for course introduction to electrical engineering. Here the students are given hands on training in electrical wirings. They are given a basic idea about the operation and power consumption of certain electrical appliances such are mixtures, iron box, pumps, fan etc. Students are familiarized with supply arrangements and their limitations, knowledge of standard voltages and their tolerances, safety aspects of electrical systems and importance of protective measures in wiring systems, knowledge about the types of wires, cables and other accessories used in wiring. Students are able to wire simple lighting circuits for domestic buildings and distinguish between light and power circuits and to measure electrical circuit parameters and current, voltage and power in a circuit."],img:"https://res.cloudinary.com/dby2vbxv3/image/upload/v1721902959/KPGU/Images/Labs/KSET-Electrical-Engineering/electrical-workshop-lab-kset-and-ksds-11-35-66a22719deb85_h8kgme.webp"},{title:"MICROPROCESSOR LABORATORY",des:["This laboratory will introduce students to get familiar with the architecture and basic operations of micro controller and microprocessor. It provides in-depth knowledge of Software and hardware experiments with a microprocessor and controller system. It also deals with assembly language programming, simple input/output interfacing, and interrupt processing in microprocessor and micro controller systems."],img:"https://res.cloudinary.com/dby2vbxv3/image/upload/v1721902959/KPGU/Images/Labs/KSET-Electrical-Engineering/microprocessor-laboratory-kset-and-ksds-4-39-66a22721c32f1_p0rcua.webp"},{title:"Machines Lab",des:["The Machines Lab in the Electrical Engineering Department at Krishna School of Diploma Studies is equipped with advanced machinery and tools essential for hands-on learning and experimentation. The lab features a wide range of electrical machines  allowing students to gain practical experience in operating, testing, and analyzing these machines. The lab's infrastructure is designed to simulate real-world industrial scenarios, helping students understand the principles of electromagnetism, power generation, and electrical drives. With modern equipment and dedicated faculty support, the Machines Lab ensures that students develop strong technical skills and a deeper understanding of electrical engineering concepts."],img:"https://res.cloudinary.com/dby2vbxv3/image/upload/v1721902961/KPGU/Images/Labs/KSET-Electrical-Engineering/electrical-machine-lab-kset-and-ksds-7-36-66a2271593fae_coxmao.webp"}],t=({title:n,img:a,des:i})=>r.jsx(k,{item:!0,xs:12,sm:6,children:r.jsxs(w,{className:"smooth-shadow-card h-100",borderRadius:4,overflow:"hidden",children:[r.jsx(w,{children:r.jsx("img",{src:a,className:"w-100",alt:""})}),r.jsxs(w,{p:2,children:[r.jsx("h4",{className:"fw-bold color-secondary",children:n}),i.map(o=>r.jsx("h6",{className:"fw-bold text-secondary mb-3",children:o}))]})]})});return r.jsx(r.Fragment,{children:r.jsxs(w,{borderRadius:4,children:[r.jsx("h2",{className:"fw-bold color-secondary fs-1 mb-4",children:"Electrical Machines  Labs"}),r.jsx(k,{container:!0,spacing:2,children:e.map(({title:n,des:a,img:i},o)=>r.jsx(t,{title:n,des:a,img:i},o))})]})})}function dre(){const{maxWidth:e,innerWidth:t}=p.useContext(X),[n,a]=Pe.useState("1"),i=(o,s)=>{a(s)};return r.jsx(r.Fragment,{children:r.jsx(Ke,{value:n,children:r.jsx(w,{maxWidth:e,mx:"auto",children:r.jsxs(k,{container:!0,px:"3%",mt:7,children:[r.jsx(k,{item:!0,xs:12,md:3,pb:4,children:r.jsx(w,{className:"smooth-shadow",bgcolor:"#fff",p:2,borderRadius:4,position:"sticky",top:0,children:r.jsxs(Ve,{onChange:i,"aria-label":"lab API tabs example",orientation:`${t<900?"horizontal":"vertical"}`,textColor:"secondary",indicatorColor:"secondary",variant:"scrollable",children:[r.jsx(G,{className:"align-items-start fw-bold text-start ",label:"Message From HOD",value:"1"}),r.jsx(G,{className:"align-items-start fw-bold text-start ",label:"About Department",value:"2"}),r.jsx(G,{className:"align-items-start fw-bold text-start ",label:"Vision And Mission",value:"3"}),r.jsx(G,{className:"align-items-start fw-bold text-start ",label:"SOFTWARE LAB",value:"4"}),r.jsx(G,{className:"align-items-start fw-bold text-start ",label:"LABORATORIES",value:"5"}),r.jsx(G,{className:"align-items-start fw-bold text-start ",label:"Research Areas",value:"6"}),r.jsx(G,{className:"align-items-start fw-bold text-start ",label:"Faculty",value:"8"})]})})}),r.jsx(k,{item:!0,xs:12,md:9,pl:t<900?"0":4,children:r.jsxs(w,{className:"smooth-shadow",bgcolor:"#fff",borderRadius:4,children:[r.jsx(W,{value:"1",children:r.jsx(nre,{})}),r.jsx(W,{value:"2",children:r.jsx(are,{})}),r.jsx(W,{value:"3",children:r.jsx(ire,{})}),r.jsx(W,{value:"4",children:r.jsx(ore,{})}),r.jsx(W,{value:"5",children:r.jsx(cre,{})}),r.jsx(W,{value:"6",children:r.jsx(sre,{})}),r.jsx(W,{value:"7",children:r.jsx(lre,{})}),r.jsx(W,{value:"8",children:r.jsx(rre,{})})]})})]})})})})}function ure(){return p.useContext(X),r.jsx(r.Fragment,{children:r.jsx(In,{hodImg:"https://res.cloudinary.com/dby2vbxv3/image/upload/v1709708448/KPGU/Faculty%20Images/KSS/hod-bio.webp",hodEmail:"ritamahapatra.kss@kpgu.ac.in",hodName:"Dr. Rita Mahapatra",hodOf:"Biotechnology",hodOfShort:"[KSS]",hodMessage:["It gives me immense pleasure in welcoming you to the Department of Biotechnology, Krishna School of Science. Our department aspires to provide an intellectually stimulating environment and works for the strong foundation stone of the budding scientists in the domains of Biotechnology. Our well-qualified and experienced faculties are providing individual attention to the students in innovative projects, assignments and activities in the broad spectrum of science by nurturing their critical thinking and problem-solving skills. The well-equipped laboratories of our department play a crucial role to give practical exposure to the students and to give best quality education and to prepare them to address real-world problems.","Apart from the curriculum the department also arranges national and international workshops, seminars, conferences, and training sessions and motivates students to participate in such activities in-house as well as outside campus to enhance their exposure to the latest advancements in the field of Science. The department arrange sessions and provide training to the students and inspire them to attend for various national level competitive examination for their future endeavors.","I wish bright future to our students!"]})})}function hre(){return r.jsxs(w,{borderRadius:4,children:[r.jsx("h2",{className:"text-uppercase fw-bold color-secondary mb-4",children:"About Department"}),r.jsx(Je,{content:["The Department of Biotechnology was recently established in 01st June 2020, and initially functioned in the University’s main campus at the Krishna school of Science, Drs. Kiran Patel & Pallavi Global University, Vadodara. The B.Sc. programme was initiated with the enrolment of 60 students each year under choice based credit system (CBCS). After the execution of NEP-2020, the Department offers B.Sc. (Bachelor of Science) Honours with Research in the subject of Biotechnology. This B.Sc. course as per NEP-2020 is 4 years (8-semesters) graduation program to provide a clear understanding of fundamental research in Biotechnology and solving the real-world problems through research and innovation. In the academic year 2024-25 M.Sc. Biotechnology was introduced in the Department. The Department also offers Ph.D. programs in Biotechnology. All the UG, PG and Ph.D. program is a perfect combination of theories & practical, which enables students to study, comprehend and resolve problems of society through their Biotechnological skills. The Department provides ample scope to students and faculties for academics and research.  Each  faculty  member manages  and  runs  his/her  laboratory  independently  where  research  is  carried out  in  different  areas  of basic  and  applied  Biotechnology.  The  faculty  members  have  had  national  as  well as  international collaborations  to  develop  mutually  beneficial  scientific  interactions.  This has  also  helped our  laboratories to  develop  new  technologies  diversify  our  areas  of  research. The class size is kept large enough to provide a vibrant learning environment. The department of Biotechnology is well-equipped with modern laboratories to provide quality teaching and research opportunities for students. The department provide consultancy to various leading industries related to food, pharmaceutical and agrochemicals sector. Our department is equipped with state-of-the-art laboratory with facilities like UV-Visible Spectrophotometer, Laminar Air flow chamber, Cooling Centrifuge, Autoclave, Light microscope, Water Bath, Orbital Shaker Incubator, Bacteriological Incubator, UV-Trans illuminator, Hot Air Oven, Refrigerator, pH meter, Dry Bath, Weighing balance, Magnetic stirrer, Vortex and Gel electrophoresis apparatus etc. and classroom facilities, incorporating modern teaching and learning tools that ensure a robust educational experience for our students.","The curriculum is designed as per NEP-2020 following the SOP of Government of Gujarat, which includes Major subjects of Biotechnology, Minor subjects includes allied subjects of biotechnology, Multidisciplinary subjects (MDC), Value added courses (VAC) which include the Integrated Personality Development Course (IPDC), Indian Knowledge System (IKS), Skill enhancement courses (SEC) and Ability Enhancement courses (AEC) to empower students with specialized skills that complement their academics and research and making them industry ready.","Other co-curricular and extracurricular activities such as Sports, NCC, NSS, social drives, Blood donation camp, Industrial visits, picnic to historical places etc. are organized by the department to create social awareness among students."]})]})}function mre(){const e=["UV-Visible Spectrophotometer","Laminar Air flow chamber","Cooling Centrifuge","Autoclave","Light microscope","Water Bath","Orbital Shaker Incubator","Bacteriological Incubator","UV-Trans illuminator","Hot Air Oven","Refrigerator","pH meter","Dry Bath","Weighing balance","Magnetic stirrer","Vortex and Gel electrophoresis apparatus"],t=({name:n})=>r.jsx(k,{item:!0,xs:12,sm:4,children:r.jsx(w,{className:"smooth-shadow-card h-100 d-flex align-items-center ",borderRadius:2,overflow:"hidden",children:r.jsx(w,{p:2,textAlign:"start",children:r.jsx("h6",{className:"fw-bold color-secondary mb-0 ",children:n})})})});return r.jsx(r.Fragment,{children:r.jsxs(ce,{borderRadius:4,spacing:3,children:[r.jsx("h2",{className:"text-uppercase fw-bold color-secondary mb-4",children:"Facilities"}),r.jsx(k,{container:!0,spacing:2,children:e.map((n,a)=>r.jsx(t,{name:n},a))})]})})}function pre(){const e=["To create and maintain programs of excellence in areas of research, education and public outreach.","To foster and encourage the pursuit of new knowledge in science.","To impart and enhance the advanced knowledge and skills of science and to offer effective solution to the industries through research and consultancies.","To inculcate the importance of basic sciences and develop methodologies which in turn shall mould the students into a competent professional."];return r.jsxs(r.Fragment,{children:[r.jsxs(w,{borderRadius:4,className:"smooth-shadow-card p-3",children:[r.jsx("h2",{className:"fw-bold color-secondary fs-1",children:"Vision"}),r.jsx(Qe,{quote:"Our vision is to impart fundamental knowledge in the broad spectrum of science and technology and enhance critical thinking and problem solving skills. The School provides innovative teaching methodologies and comprehensive   evaluation strategies. The School, further focuses on upgrading scientific inquiry and enhancing its global presence across various fields of the science by producing competent researches required for industries and academia.",right:!0})]}),r.jsxs(w,{mt:7,borderRadius:4,className:"smooth-shadow-card p-3",children:[r.jsx("h2",{className:"fw-bold color-secondary fs-1 mb-4",children:"Mission"}),r.jsx(w,{pl:2,color:"secondary.main",children:e.map((t,n)=>r.jsxs(ce,{direction:"row",mb:1,children:[r.jsx(w,{children:r.jsx(ze,{sx:{fontSize:"25px"}})}),r.jsx(w,{children:r.jsx("h4",{children:t})})]},n))})]})]})}function fre(){const e=["Graduates will be successful in pursuing higher studies in pure and applied science.","Graduates will pursue career paths in teaching at schools and at different type of institute for competitive exams.","PG/Doctorate students can planning for research/teaching career at universities/colleges in different branches.","A Bachelor’s degree in mathematics followed by Master’s degree is highly desirable for a career in research and Development (R&D) in various national level institutes funded by CSIR, DBT and ICMR, Government of India, New Delhi.","After graduation, they can do their masters in Bioinformatics and Biostatics and work as a biological data analyst in Biotech/ Bio-parma research companies or consultancies.","Students can opt for Biotechnology entrepreneurship and Start-Up for being self-reliant."];return r.jsxs(w,{borderRadius:4,textAlign:"justify",children:[r.jsx("h2",{className:"fw-bold color-secondary fs-1 mb-3",children:"Scope of the Program"}),r.jsx("h5",{className:"text-secondary mb-3",children:"After doing B.Sc. (Biotechnology), student can prefer either further studies or take up various jobs. Students will be able to apply theoretical and practical knowledge in various competitive examinations like IIT-JAM, GATE, DBT- CET for higher studies. They can be an asset to a biopharmaceutical and other biotechnological industries in research and development activities as well as in quality control & quality assurance departments. The course is also beneficial for students who wish to pursue multi and inter-disciplinary science careers in future."}),r.jsx("h4",{className:"color-secondary mb-3 fw-semibold ",children:"Some of the most relevant further education programs after B.Sc. (Biotechnology) includes"}),e.map((t,n)=>r.jsxs(ce,{direction:"row",mb:1,color:"secondary.main",className:"smooth-shadow-card mb-3 ",p:1,borderRadius:2,children:[r.jsx(w,{children:r.jsx(ze,{sx:{fontSize:"25px"},color:"inherit"})}),r.jsx(w,{children:r.jsx("h5",{className:"mb-0",children:t})})]},n))]})}function gre(){const{maxWidth:e,innerWidth:t}=p.useContext(X),[n,a]=Pe.useState("1"),i=(o,s)=>{a(s)};return r.jsx(r.Fragment,{children:r.jsx(Ke,{value:n,children:r.jsxs(k,{container:!0,maxWidth:e,mx:"auto",mt:7,children:[r.jsx(k,{item:!0,xs:12,md:3,pb:4,children:r.jsx(w,{className:"smooth-shadow",bgcolor:"#fff",p:2,borderRadius:4,position:"sticky",top:0,children:r.jsxs(Ve,{onChange:i,"aria-label":"lab API tabs example",orientation:`${t<900?"horizontal":"vertical"}`,textColor:"secondary",indicatorColor:"secondary",variant:"scrollable",children:[r.jsx(G,{className:"align-items-start fw-bold text-start ",label:"Message From HOD",value:"1"}),r.jsx(G,{className:"align-items-start fw-bold text-start ",label:"About Department",value:"2"}),r.jsx(G,{className:"align-items-start fw-bold text-start ",label:"Scope of the Program",value:"6"}),r.jsx(G,{className:"align-items-start fw-bold text-start ",label:"Vision And Mission",value:"3"})]})})}),r.jsx(k,{item:!0,xs:12,md:9,pl:t<900?"0":4,children:r.jsxs(w,{className:"smooth-shadow",bgcolor:"#fff",borderRadius:4,children:[r.jsx(W,{value:"1",children:r.jsx(ure,{})}),r.jsx(W,{value:"2",children:r.jsx(hre,{})}),r.jsx(W,{value:"3",children:r.jsx(pre,{})}),r.jsx(W,{value:"5",children:r.jsx(mre,{})}),r.jsx(W,{value:"6",children:r.jsx(fre,{})})]})})]})})})}function vre(){return p.useContext(X),r.jsx(r.Fragment,{children:r.jsx(In,{hodImg:"https://res.cloudinary.com/dby2vbxv3/image/upload/v1709713665/KPGU/Faculty%20Images/KSS/hod-chemistry.webp",hodEmail:"bos2.kss@kpgu.ac.in",hodName:"Dr. Asha Joshi",hodOf:" Chemistry",hodOfShort:"[KSS]",hodMessage:["Dear learned visitor, It is with immense pride and pleasure that I welcome you to the Department of Chemistry at Krishna School of Science. Ours is one of the department established in 2021 on the main campus. It started as a single faculty department in the subject of Chemistry to the students mainly coming from the rural & urban background and impart necessary skills required for the grooming chemical industries in this western part of the country, for creating self-entrepreneurs and also churn out academicians and researchers who can take up jobs in educational institutes and research laboratories. Our department has a rich legacy of academic excellence and a dynamic culture of innovation in both teaching and research. We are committed to providing a world-class education that equips our students with not only a deep understanding of chemical sciences but also the skills required to address complex global challenges.","At the core of our mission is a dedication to fostering a vibrant learning environment that encourages curiosity, critical thinking, and interdisciplinary collaboration. Our faculty members are accomplished researchers and educators who are passionate about mentoring the next generation of scientists. We emphasize a holistic approach to learning that integrates rigorous academic training with hands-on laboratory experiences, research projects, and opportunities for real-world problem-solving.","The Department of Chemistry is actively engaged in cutting-edge research across a broad spectrum of fields, including analytical chemistry, organic and inorganic synthesis, materials science, environmental chemistry, natural products and medicinal chemistry, green chemistry, petrochemical technology, industrial chemsitry, and theoretical and computational chemistry. Through these endeavors, we aim to contribute to the advancement of knowledge and the development of sustainable solutions to the world’s most pressing issues.","As part of our commitment to the overall development of our students, we also encourage participation in extracurricular activities, community outreach, and professional development programs. By nurturing well- rounded individuals, we prepare our graduates for successful careers in academia, industry, and beyond.","I invite you to explore our website, learn more about our programs, and discover the exciting opportunities that awaits you in the Department of Chemistry. Together, let us inspire and create a better future through the transformative power of science."]})})}function bre(){return r.jsxs(w,{borderRadius:4,children:[r.jsx("h2",{className:"text-uppercase fw-bold color-secondary mb-4",children:"About Department"}),r.jsx(Je,{content:["The Department of Chemistry at Krishna School of Science, Drs. Kiran & Pallavi Patel Global University (KPGU), offers B.Sc. (Hons.) with Research in Chemistry, M.Sc. Organic Chemistry as per NEP 2020 and Ph.D. programs in Chemistry. Our department is equipped with state-of-the-art laboratory and classroom facilities, incorporating modern teaching and learning tools that ensure a robust educational experience for our students.","Our faculty members are highly competent, with diverse teaching and research backgrounds gained from leading national and international institutions. The Department maintains collaborative Memoranda of Understanding (MOUs) with various academic institutions and industries, providing excellent opportunities for student training, internships, and placements.","We regularly organize industrial and institutional tours to broaden the practical understanding of our students. Additionally, students are encouraged to engage in research activities by working on small projects, which foster analytical thinking and problem-solving skills. These projects culminate in formal reports, preparing students for future academic or professional pursuits.","The Department also motivates students to participate in national and international workshops, seminars, conferences, and training sessions to enhance their exposure to the latest advancements in chemistry.","A step towards Skill Enhanced Courses (SEC), are designed to bridge the gap between theoretical knowledge and practical skills, providing students with industry-relevant competencies that prepare them for real-world challenges. The Department of Chemistry, has initiated SEC to empower students with specialized skills that complement their academic learning. These courses focus on enhancing students' problem-solving abilities, technical proficiency, and application-based knowledge, making them well-prepared for diverse career paths.","Value-Added Courses (VAC) has been initiated to instill Universal Human Values, helping students develop into responsible and loyal citizens. Beyond academics, the Department actively promotes co-curricular and extracurricular activities that foster social awareness. These include the Integrated Personality Development Course (IPDC), Indian Knowledge System (IKS), National Cadet Corps (NCC), National Service Scheme (NSS), and various social drives such as plastic-free campus initiatives, blood donation camps, field trips to historical sites, and more.","Our department strives to create well-rounded graduates equipped with scientific knowledge, ethical values, and a sense of responsibility toward society."]})]})}function yre(){const e=["Procure quality teaching-learning, research and service opportunities leading to holistic development of students through collusive exchange of ideas, unallied thought, and the highest ethical standards.","Serve high quality academic experiences through comprehensive & relevant curriculum at UG levels.","Foster research aptitude by extending infrastructural support and research guidance.","Inculcate the values of multi-disciplinary and inter-disciplinary approach and innovative thinking by promoting learning experiences in the field of chemical sciences and its allied fields.","Fruitage knowledgeable graduates for careers in academia, industry and GOs/NGOs. Promote an ethical and professional environment amongst faculties and students of the department.","Promote an ethical and professional environment amongst faculties and students of the department."];return r.jsxs(r.Fragment,{children:[r.jsxs(w,{borderRadius:4,className:"smooth-shadow-card p-3",textAlign:"justify",children:[r.jsx("h2",{className:"fw-bold color-secondary fs-1",children:"Vision"}),r.jsx(Qe,{quote:"The Department of Chemistry endeavors to be perceived for excellence in Teaching – Learning adjunct by accrediting graduating students to strive in and confer to the developing exigency of the society.",right:!0})]}),r.jsxs(w,{mt:7,borderRadius:4,className:"smooth-shadow-card p-3",children:[r.jsx("h2",{className:"fw-bold color-secondary fs-1 mb-4",children:"Mission"}),r.jsx(w,{pl:2,color:"secondary.main",children:e.map((t,n)=>r.jsxs(ce,{direction:"row",mb:1,textAlign:"justify",children:[r.jsx(w,{children:r.jsx(ze,{sx:{fontSize:"25px"}})}),r.jsx(w,{children:r.jsx("h4",{children:t})})]},n))})]})]})}function xre(){const e=["Higher Education and Advanced Research","Research and Development (R&D)","Chemical and Pharmaceutical Industries","Environmental Science and Sustainability","Materials Science and Nanotechnology","Biotechnology and Healthcare","Academia and Teaching","Chemical Analysis and Testing Services","Agriculture and Agrochemicals","Government and Public Sector Roles","Entrepreneurship and Start-ups","Interdisciplinary Fields"],t=["Academic and Teaching Careers - University Professorship, Postdoctoral Research","Research and Development (R&D) - Industrial R&D, Pharmaceuticals and Biotech","Government and Regulatory Agencies - Policy and Regulatory Roles, Scientific Advisors","Scientific Research Institutions - Independent Researcher, Interdisciplinary Research","Chemicals and Materials Industry - Product Development, Quality Control and Safety","Environmental and Energy Sectors - Environmental Chemistry, Energy Research","Patent Law and Intellectual Property - Patent Examiner, IP Consultancy, Entrepreneurship and Start- ups, Chemical Start-ups, Innovation and Commercialization","Consulting and Advisory Roles - Chemical Consultant, Science Communication","Data Science and Computational Chemistry - Computational Research, Data Analyst"];return r.jsxs(w,{borderRadius:4,children:[r.jsx("h2",{className:"fw-bold color-secondary fs-1 mb-3",children:"Scope of the B.Sc. (Hons.) With Research / M.Sc. Program"}),r.jsx("h4",{className:"color-secondary mb-3 fw-semibold ",children:"The B.Sc. (Hons.) with Research in Chemistry program is designed to provide students with an in-depth understanding of chemistry along with hands-on research experience. This program not only equips students with fundamental and advanced knowledge of chemical sciences but also hones their analytical, experimental, and problem-solving skills through active engagement in research projects. The following outlines the diverse career and academic opportunities available for graduates of this program"}),r.jsx(k,{container:!0,children:e.map((n,a)=>r.jsx(k,{item:!0,xs:6,sm:4,mb:2,children:r.jsx($,{variant:"text",className:"fw-bold border-2 smooth-shadow-card h-100 rounded-4",color:"secondary",children:n})}))}),r.jsx("h4",{className:"color-secondary mb-3 fw-semibold ",children:"The M.Sc. (Organic Chemistry) program thus provides a versatile platform for a wide array of career paths, making it an ideal choice for students looking to make significant contributions to both industry and academia."}),r.jsx("h2",{className:"fw-bold color-secondary fs-1 mb-3",children:"Scope of the Ph.D. Chemistry Program"}),r.jsx("h4",{className:"color-secondary mb-3 fw-semibold ",children:"A Ph.D. in Chemistry offers a profound and comprehensive pathway for individuals aiming to engage in advanced research, academic excellence, and specialized career roles. The program is designed to push the boundaries of chemical knowledge through original research, critical analysis, and innovation, opening numerous opportunities in academia, industry, government, and beyond. Below are some of the key career and research avenues for Ph.D. Chemistry graduates:"}),r.jsx(k,{container:!0,children:t.map((n,a)=>r.jsx(k,{item:!0,xs:12,sm:6,mb:2,children:r.jsx($,{variant:"text",className:"fw-bold border-2 smooth-shadow-card h-100 rounded-4",color:"secondary",children:n})}))}),r.jsx("h4",{className:"color-secondary mb-3 fw-semibold ",children:"A Ph.D. in Chemistry opens doors to diverse and prestigious career pathways across academia, industry, government, and entrepreneurial sectors. It equips graduates with the expertise to solve complex chemical problems, lead innovative research, and contribute meaningfully to scientific advancements. Whether aiming for academic distinction, industrial leadership, or cutting-edge research, the scope of a Ph.D. in Chemistry is vast and impactful."}),r.jsx("h4",{className:"text-uppercase color-secondary fw-bold mt-4",children:"Jobs"}),r.jsxs(ce,{direction:"row",gap:2,flexWrap:"wrap",children:[r.jsx($,{variant:"text",className:"fw-bold border-2 smooth-shadow-card",color:"secondary",children:"Chemist"}),r.jsx($,{variant:"text",className:"fw-bold border-2 smooth-shadow-card",color:"secondary",children:"Pharmacy Assistant"}),r.jsx($,{variant:"text",className:"fw-bold border-2 smooth-shadow-card",color:"secondary",children:"Lab Assistant"}),r.jsx($,{variant:"text",className:"fw-bold border-2 smooth-shadow-card",color:"secondary",children:"Toxicologist"}),r.jsx($,{variant:"text",className:"fw-bold border-2 smooth-shadow-card",color:"secondary",children:"Biochemists"}),r.jsx($,{variant:"text",className:"fw-bold border-2 smooth-shadow-card",color:"secondary",children:"School Teacher"})]}),r.jsx("h4",{className:"text-uppercase color-secondary fw-bold mt-4",children:"Certificate Course"}),r.jsxs(ce,{direction:"row",gap:2,flexWrap:"wrap",children:[r.jsx($,{variant:"text",className:"fw-bold border-2 smooth-shadow-card",color:"secondary",children:"Chemical Labs"}),r.jsx($,{variant:"text",className:"fw-bold border-2 smooth-shadow-card",color:"secondary",children:"Clinical Labs"}),r.jsx($,{variant:"text",className:"fw-bold border-2 smooth-shadow-card",color:"secondary",children:"Health Care Industry"}),r.jsx($,{variant:"text",className:"fw-bold border-2 smooth-shadow-card",color:"secondary",children:"Cosmetics and Perfume Industry"}),r.jsx($,{variant:"text",className:"fw-bold border-2 smooth-shadow-card",color:"secondary",children:"Military Hospitals"}),r.jsx($,{variant:"text",className:"fw-bold border-2 smooth-shadow-card",color:"secondary",children:"Fertilizer Plants"}),r.jsx($,{variant:"text",className:"fw-bold border-2 smooth-shadow-card",color:"secondary",children:"Energy Firms"}),r.jsx($,{variant:"text",className:"fw-bold border-2 smooth-shadow-card",color:"secondary",children:"Forensic Labs"})]}),r.jsx("h4",{className:"text-uppercase color-secondary fw-bold mt-4",children:"Opt. for Civil Services"}),r.jsxs(ce,{direction:"row",gap:2,flexWrap:"wrap",children:[r.jsx($,{variant:"text",className:"fw-bold border-2 smooth-shadow-card",color:"secondary",children:"UPSC"}),r.jsx($,{variant:"text",className:"fw-bold border-2 smooth-shadow-card",color:"secondary",children:"GPSC"}),r.jsx($,{variant:"text",className:"fw-bold border-2 smooth-shadow-card",color:"secondary",children:"ASI"}),r.jsx($,{variant:"text",className:"fw-bold border-2 smooth-shadow-card",color:"secondary",children:"PSI"}),r.jsx($,{variant:"text",className:"fw-bold border-2 smooth-shadow-card",color:"secondary",children:"SSC"})]})]})}function wre(){const{maxWidth:e,innerWidth:t}=p.useContext(X),[n,a]=Pe.useState("1"),i=(o,s)=>{a(s)};return r.jsx(r.Fragment,{children:r.jsx(Ke,{value:n,children:r.jsxs(k,{container:!0,maxWidth:e,mx:"auto",mt:7,children:[r.jsx(k,{item:!0,xs:12,md:3,pb:4,children:r.jsx(w,{className:"smooth-shadow",bgcolor:"#fff",p:2,borderRadius:4,position:"sticky",top:0,children:r.jsxs(Ve,{onChange:i,"aria-label":"lab API tabs example",orientation:`${t<900?"horizontal":"vertical"}`,textColor:"secondary",indicatorColor:"secondary",variant:"scrollable",children:[r.jsx(G,{className:"align-items-start fw-bold text-start ",label:"Message From HOD",value:"1"}),r.jsx(G,{className:"align-items-start fw-bold text-start ",label:"About Department",value:"2"}),r.jsx(G,{className:"align-items-start fw-bold text-start ",label:"Vision And Mission",value:"3"}),r.jsx(G,{className:"align-items-start fw-bold text-start ",label:"Scope",value:"5"})]})})}),r.jsx(k,{item:!0,xs:12,md:9,pl:t<900?"0":4,children:r.jsxs(w,{className:"smooth-shadow",bgcolor:"#fff",borderRadius:4,children:[r.jsx(W,{value:"1",children:r.jsx(vre,{})}),r.jsx(W,{value:"2",children:r.jsx(bre,{})}),r.jsx(W,{value:"3",children:r.jsx(yre,{})}),r.jsx(W,{value:"5",children:r.jsx(xre,{})})]})})]})})})}function Cre(){return r.jsxs(w,{borderRadius:4,children:[r.jsx("h2",{className:"text-uppercase fw-bold color-secondary mb-4",children:"About Department"}),r.jsx(Je,{content:["The Department of Mathematics at KPGU was established in June, 2020. The Department is established with aim to provide a wide knowledge of Mathematics with good choice of subject areas. Initially it started with B.Sc. Mathematics, a 3 years UG course under choice-based credit system (CBCS).  After the execution of NEP – 2020, the Department offers B.Sc. (Bachelor of Science) Honours/ Honours with Research in the subject of Mathematics. This B.Sc. course is 4 years (8-semesters) graduation program to provide a clear understanding of fundamental concepts of Mathematics. This program is a perfect combination of theories & practical, which enables students to study, comprehend and resolve problems of Mathematics.","The design of this course is to give you an expertise in Mathematical Sciences. The objective of our program is to cultivate a fine mathematical taste, nurture mathematical interests, motivate research in mathematical sciences and train computational scientists who can work on challenging real-life problems.","Apart from academics, other curricular and co-curricular activities are also organized by the department to create social awareness among students. For this, a NCC, NSS, Social Drive, Plastic-free campus program, Blood donation camp, Picnic to historical places, Field visits etc., are also organized.","","",""]})]})}function Sre(){const e=["To equip all of our students with the conceptual understanding, computational skills, and persistent disposition required to use quantitative reasoning and analysis effectively in their personal and professional lives.","To make student aware of technology to explore mathematical concepts through activities and experimentation.","To inculcate in students, the ability to apply mathematical and computational skills to model,formulate and solve real life applications.","To make the students capable of discharging professional,social and economic responsibilities ethically.","To provide platform to acquire abilities to evaluate problems using analytical/numerical/graphical techniques.","To achieve high standards of excellence in generating and propagating knowledge in Mathematics. Department is committed to providing an education that combines rigorous academics with joy of discovery."];return r.jsxs(r.Fragment,{children:[r.jsxs(w,{borderRadius:4,className:"smooth-shadow-card p-3",children:[r.jsx("h2",{className:"fw-bold color-secondary fs-1",children:"Vision"}),r.jsx(Qe,{quote:"Imparting of quality mathematics education and inculcating the spirit of logical reasoning, critical thinking and problem-solving ability through innovative teaching and research methodologies. The long-term vision of this department is to prepare qualified graduates who are equipped with deeper insight and research skills in the field of Mathematics.",right:!0})]}),r.jsxs(w,{mt:7,borderRadius:4,className:"smooth-shadow-card p-3",children:[r.jsx("h2",{className:"fw-bold color-secondary fs-1 mb-4",children:"Mission"}),r.jsxs(w,{pl:2,color:"secondary.main",children:[r.jsx("h5",{className:"text-secondary mb-3",children:"The mission of the Mathematics Department at KPGU is to emerge as a global center of learning, academic excellence, and innovative research."}),r.jsx("h5",{className:"text-secondary mb-3",children:"We aim to provide high-quality education in undergraduate and graduate mathematics, meeting the needs of a diverse student body and diverse state population."}),e.map((t,n)=>r.jsxs(ce,{direction:"row",mb:1,children:[r.jsx(w,{children:r.jsx(ze,{sx:{fontSize:"25px"}})}),r.jsx(w,{children:r.jsx("h4",{children:t})})]},n))]})]})]})}function jre(){const e=["Graduates will be successful in pursuing higher studies in pure and applied science or Management.","Graduates will pursue career paths in teaching at schools and at different type of institute for competitive exams.","PG/Doctorate students can planning for research/teaching career at universities/colleges in different branches.","A Bachelor’s degree in mathematics followed by an MBA is highly desirable for a career in investment banking.","After graduation, they can do their masters in data science and work as a data analyst or machine learning engineer in tech/ market research companies or consultancies. In the field of insurance sector as an actuarial analyst."];return r.jsxs(w,{borderRadius:4,textAlign:"justify",children:[r.jsx("h2",{className:"fw-bold color-secondary fs-1 mb-3",children:"Scope of the Program"}),r.jsx("h5",{className:"text-secondary mb-3",children:"After doing B.Sc. (Mathematics), one can prefer for either further studies or take up various jobs. Students are able to apply mathematical skills in various competitive examinations for employment and higher studies. They can analyze and interpret data. The course is also beneficial for students who wish to pursue multi and inter-disciplinary science careers in future."}),r.jsx("h4",{className:"color-secondary mb-3 fw-semibold ",children:"Some of the most relevant further education programs after B.Sc. (Mathematics) includes"}),e.map((t,n)=>r.jsx(ce,{direction:"row",mb:1,color:"secondary.main",className:"smooth-shadow-card mb-3 ",p:1,borderRadius:2,children:r.jsx(w,{children:r.jsx("h5",{className:"mb-0",children:t})})},n))]})}function Pre(){const{maxWidth:e,innerWidth:t}=p.useContext(X),[n,a]=Pe.useState("2"),i=(o,s)=>{a(s)};return r.jsx(r.Fragment,{children:r.jsx(Ke,{value:n,children:r.jsxs(k,{container:!0,maxWidth:e,mx:"auto",mt:7,children:[r.jsx(k,{item:!0,xs:12,md:3,pb:4,children:r.jsx(w,{className:"smooth-shadow",bgcolor:"#fff",p:2,borderRadius:4,position:"sticky",top:0,children:r.jsxs(Ve,{onChange:i,"aria-label":"lab API tabs example",orientation:`${t<900?"horizontal":"vertical"}`,textColor:"secondary",indicatorColor:"secondary",variant:"scrollable",children:[r.jsx(G,{className:"align-items-start fw-bold text-start ",label:"About Department",value:"2"}),r.jsx(G,{className:"align-items-start fw-bold text-start ",label:"Vision And Mission",value:"3"}),r.jsx(G,{className:"align-items-start fw-bold text-start ",label:"Scope",value:"6"})]})})}),r.jsx(k,{item:!0,xs:12,md:9,pl:t<900?"0":4,children:r.jsxs(w,{className:"smooth-shadow",bgcolor:"#fff",borderRadius:4,children:[r.jsx(W,{value:"1"}),r.jsx(W,{value:"2",children:r.jsx(Cre,{})}),r.jsx(W,{value:"3",children:r.jsx(Sre,{})}),r.jsx(W,{value:"6",children:r.jsx(jre,{})})]})})]})})})}function Ere(){return p.useContext(X),r.jsx(r.Fragment,{children:r.jsx(In,{hodImg:"https://res.cloudinary.com/dby2vbxv3/image/upload/v1709719212/KPGU/Faculty%20Images/KSS/hod-microbiology.webp",hodEmail:"parulshrivastava.kss@kpgu.ac.in",hodName:"Dr. Parul Shrivastava",hodOf:" Microbiology",hodOfShort:"[KSS]",hodMessage:["Greetings from the Department of Microbiology at Krishna School of Science, Drs. Kiran & Pallavi Patel Global University, Vadodara!","Since its inception in 2020, our department has been dedicated to providing quality education and hands-on experience to students from diverse backgrounds, whether rural or urban. Our aim is to equip students with the essential skills needed to thrive in various industries such as pharmaceuticals, food, healthcare, and agriculture.","In today's rapidly evolving global landscape, the demand for skilled microbiologists is more crucial than ever. Our department is committed to addressing the challenges faced by both industry and academia by preparing highly competent professionals in the field. All our faculty members hold Ph.D. degrees and bring a wealth of expertise to the classroom.","We invite you to embark on an enriching educational journey with us, aligned with the principles of NEP 2020. Together, we will tackle real-world problems and contribute to your success. We look forward to welcoming you to a dynamic and supportive learning environment where we can achieve great heights together."]})})}function kre(){return r.jsxs(w,{borderRadius:4,children:[r.jsx("h2",{className:"text-uppercase fw-bold color-secondary mb-4",children:"About Department"}),r.jsx(Je,{content:["Department of Microbiology at Krishna School of Science, Drs. Kiran & Pallavi Patel Global University (KPGU) offers B.Sc. program in Microbiology under Choice Based Credit System (CBCS). We are excited to announce that we have now launched the first batch of our Master of Science (MSc) in Microbiology for 2024! This new program is designed to offer advanced knowledge and practical skills in the ever-evolving field of microbiology. Department of Microbiology has state-of-the-art laboratory and classroom facilities, equipped with modern teaching and learning tools.","Department of Microbiology has adequate and competent faculty members having diverse teaching and research experience with exposure from national and international institutes. Additionally, the Department of Microbiology has collaborative MOU with various Academia and Industries for the training & Placement of students.","Various industrial and institutional tours are also organized by the department to motivate the students. Students are also encouraged to do research by assigning them small projects for which they have to submit a report. The students of B.Sc. Microbiology are also encouraged to participate in various national and international workshops, seminars, conferences and training sessions.","Department of Microbiology have initiated a step towards VAC in order to make students learn Universal Human Values that will help the students to become a loyal and responsible citizen towards the nation.","Apart from academics, other curricular and co-curricular activities are also organized by the department to create social awareness among students. For this, a NCC, NSS, Social Drive, Plastic-free campus program, Blood donation camp, Picnic to historical places, Field visits etc., are also organized."]})]})}function Tre(){const e=["Procure quality teaching-learning, research and service opportunities leading to holistic development of students through collusive exchange of ideas, unallied thought, and the highest ethical standards.","Serve high quality academic experiences through comprehensive & relevant curriculum at UG levels.","Foster research aptitude by extending infrastructural support and research guidance.","Inculcate the values of multi-disciplinary and inter-disciplinary approach and innovative thinking by promoting learning experiences in the field of chemical sciences and its allied fields.","Fruitage knowledgeable graduates for careers in academia, industry and GOs/NGOs.","Promote an ethical and professional environment amongst faculties and students of the department."];return r.jsxs(r.Fragment,{children:[r.jsxs(w,{borderRadius:4,className:"smooth-shadow-card p-3",textAlign:"justify",children:[r.jsx("h2",{className:"fw-bold color-secondary fs-1",children:"Vision"}),r.jsx(Qe,{quote:"TThe Department of Microbiology endeavors to be perceived for excellence in Teaching – Learning adjunct by accrediting graduating students to strive in and confer to the developing exigency of the society.",right:!0})]}),r.jsxs(w,{mt:7,borderRadius:4,className:"smooth-shadow-card p-3",children:[r.jsx("h2",{className:"fw-bold color-secondary fs-1 mb-4",children:"Mission"}),r.jsx(w,{pl:2,color:"secondary.main",children:e.map((t,n)=>r.jsxs(ce,{direction:"row",mb:1,textAlign:"justify",children:[r.jsx(w,{children:r.jsx(ze,{sx:{fontSize:"25px"}})}),r.jsx(w,{children:r.jsx("h4",{children:t})})]},n))})]})]})}function Nre(){const e=["After doing B.Sc. (Microbiology), one can prefer for either further studies or take up various jobs and also take up internships to prepare for industry level entries.","In recent times, due to favorable governmental initiatives, opting for a start-up can be an excellent choice for graduates of B.Sc. (Microbiology) program.","After successful completion of B.Sc. (Microbiology) program one can always opt for civil service and other government sector employment exams.","Now a days there is a bright scope in the field of research and development so once students get completed with M.Sc. in Microbiology can either opt for Ph.D. program or research projects in India or abroad."],t=["<b>Research and Development :</b> Work in laboratories conducting research in areas such as pharmaceuticals, biotechnology, and environmental science.","<b>Healthcare :</b> Pursue roles in clinical microbiology, diagnostics, or infectious disease management, often working in hospitals or diagnostic labs.","<b> Pharmaceutical Industry :</b> Involvement in drug development, quality control, or regulatory affairs for companies that produce medications.","<b>Food Microbiology :</b> Engage in food safety, quality control, or product development within the food and beverage industry.","<b>Environmental Microbiology :</b> Focus on bioremediation, pollution control, or research in microbial ecology.","<b>Academia :</b> Pursue a PhD and engage in teaching, research, or both at universities.","<b>Government and Regulatory :</b> Bodies Work with agencies that monitor public health, food safety, or environmental issues.","<b>Consultancy :</b> Provide expertise to organizations on microbiological practices, safety regulations, and compliance.","<b>Entrepreneurship :</b> Start your own venture related to microbiology, such as a lab, consulting firm, or biotechnology startup."],n=[{title:"Jobs",scope:["PHARMACEUTICAL INDUSTRY","ENVIRONMENTAL AGENCY","FOOD INDUSTRY","BEVERAGE INDUSTRY","CHEMICAL INDUSTRY","AGRICULTURE DEPARTMENT","GOVERNMENT AND PRIVATE HOSPITAL","LABORATORY","RESEARCH PROJECTS"]},{title:"Certificate Course",scope:["CLINICAL LABS","HEALTH CARE INDUSTRY","MILITARY HOSPITALS","FORENSIC LABS"]},{title:"Further Studies",scope:["M.SC.","M.SC.","PH.D.","MLT","RESEARCH ASSISTANT","RESEARCH SCIENTIST","MCA/MBA","B.ED.","COMPETITIVE EXAMS-GATE/NET/GSET ETC.","M.ED."]},{title:"Further Studies",scope:["UPSC","GPSC","ASI","PSI","SSC"]}];return r.jsxs(w,{borderRadius:4,children:[r.jsx("h2",{className:"fw-bold color-secondary fs-1 mb-3",children:"Scope of B.Sc. (Microbiology) Program"}),e.map((a,i)=>r.jsx(ce,{direction:"row",mb:1,color:"secondary.main",className:"smooth-shadow-card mb-3 ",p:1,borderRadius:2,children:r.jsx(w,{children:r.jsx("h5",{className:"mb-0",children:a})})},i)),r.jsx("h4",{className:"color-secondary mb-3 mt-4 fw-semibold ",children:"Some of the most relevant further education programs after B.Sc. (Microbiology) and various fields for job in industrial sector includes following:"}),n.map(({title:a,scope:i},o)=>r.jsxs(r.Fragment,{children:[r.jsx("h4",{className:"text-uppercase color-secondary fw-bold mt-4",children:a},o),r.jsx(ce,{direction:"row",gap:2,flexWrap:"wrap",children:i.map((s,l)=>r.jsx($,{variant:"text",className:"fw-bold border-2 smooth-shadow-card",color:"secondary",children:s}))},o)]})),r.jsx("h2",{className:"fw-bold color-secondary fs-1 mb-3 mt-4",children:"Scope of M.Sc. Microbiology"}),r.jsx("h4",{className:"color-secondary mb-3 mt-4 fw-semibold ",children:"After completing an MSc in Microbiology, you have a wide range of career opportunities available to y