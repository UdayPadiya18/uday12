hildren:[r.jsx("h2",{className:"fw-bold color-secondary fs-1",children:"Objectives"}),r.jsx("ul",{children:a.map((s,l)=>r.jsx("li",{className:"fs-4 fw-bold",children:s},l))})]}),r.jsxs(w,{px:"3%",py:"2%",bgcolor:"#fff",mt:7,borderRadius:4,className:"smooth-shadow",maxWidth:e,mx:"auto",children:[r.jsx("h2",{className:"fw-bold color-secondary fs-1",children:"Events"}),r.jsx(k,{container:!0,spacing:3,mt:1,children:n.map(({date:s,des:l,img:c,title:d},u)=>r.jsx(J0,{date:s,des:l,img:c,title:d,column:6},u))})]})]})}function Wre(){const{maxWidth:e}=p.useContext(X),t=[{des:"For the purpose of serving the society and to work for the poor and underprivileged people and to encourages and promote various social welfare activities, Krishna Center of Institutional Social Responsibility (KCISR) has been established under the hood of Drs. Kiran and Pallavi Patel Global University. The KCISR proposes to create social impact through hands-on execution of the social initiatives, directly and through partnerships with individuals, institutions, NGOs, and local Government bodies for the purposes of accessing and enhancing expertise and resources to cater to the needs of social activities."},{des:"KCISR Policy aims to involve and engage the employees and the students of the institutes to nurture a culture of “paying back to society” which leaves them with a sense of fulfilment of their social commitments. Our Key focus on ISR is on the areas of Environment conservation, Recycling of Wasted papers, ISR at Workplace, ISR on Community and ISR of promoting research and innovation to match the global standards of services."},{des:"The Goal of KCSIR isto bring about a long-term sustainable change in the lives of less privileged through implementation of initiatives that have a clear societal impact and to support communities to lead purposeful, healthy & dignified lives, thereby driving “holistic empowerment” and overall well-being of the community."}];return r.jsxs(r.Fragment,{children:[r.jsx(w,{maxWidth:e,mx:"auto",p:"3%",bgcolor:"#fff",mt:7,borderRadius:4,className:"smooth-shadow",children:t.map(({des:n},a)=>r.jsx(Je,{content:[n]},a))}),r.jsxs(w,{maxWidth:e,mx:"auto",p:"3%",bgcolor:"#fff",mt:7,borderRadius:4,className:"smooth-shadow",children:[r.jsx("h3",{className:"fw-bold color-secondary",children:"Main objectives of Krishna Center of Institutional Social Responsibility"}),r.jsxs("ol",{children:[r.jsx("li",{className:"fw-semibold color-secondary fs-5 mb-2",children:"To imbibe social responsibility concept among the students by imparting Knowledge and Skills for the welfare of the society."}),r.jsx("li",{className:"fw-semibold color-secondary fs-5 mb-2",children:"To serve society by organizing various programme on Health, Hygiene, Child development activities, environment protection, Blood donation camp, gender discrimination and women empowerment Programs."}),r.jsx("li",{className:"fw-semibold color-secondary fs-5 mb-2",children:"To promote value-based education by propagating integration of services, service-based learning and experiment-based learning into a curricular and co-curricular Programmes. This helps in promoting practical learning and problem-solving approach among students by means of direct engagement with the community."}),r.jsx("li",{className:"fw-semibold color-secondary fs-5 mb-2",children:"To promote community-university partnerships to encourage participatory research in the field of social activities."}),r.jsx("li",{className:"fw-semibold color-secondary fs-5 mb-2",children:"To work for welfare of the schedule caste, tribes, other backward classes, minorities, and women."})]})]})]})}function qre(){const{maxWidth:e}=p.useContext(X);return r.jsxs(r.Fragment,{children:[r.jsxs(w,{maxWidth:e,mx:"auto",p:"3%",bgcolor:"#fff",mt:7,borderRadius:4,className:"smooth-shadow",children:[r.jsx("h3",{className:"color-secondary fw-bold mb-4",children:"KRISHNA CENTER OF INTERNATIONAL AFFAIRS"}),r.jsx(Je,{content:["Drs. Kiran and Pallavi Patel Global University (KPGU) have made significant strides in fostering global connectivity and understanding through the establishment of the Krishna Center of International Affairs (KCIA). This center serves as a beacon for the university's commitment to cultivating relationships with nations and institutions worldwide. Through a multifaceted approach, the center actively engages in diplomatic dialogues, academic collaborations, and cultural exchanges to promote cross-cultural understanding and cooperation. By leveraging its extensive network of international partners, KCAI not only facilitates academic and research collaborations but also serves as a platform for promoting socio-economic development and peace initiatives on a global scale. Through its relentless pursuit of forging meaningful connections and fostering mutual understanding, the center embodies KPGU's vision of becoming a hub for international discourse and collaboration in the ever-evolving global landscape."]})]}),r.jsxs(w,{maxWidth:e,mx:"auto",p:"3%",bgcolor:"#fff",mt:7,borderRadius:4,className:"smooth-shadow",children:[r.jsx("h3",{className:"color-secondary fw-bold mb-4",children:"Core activities "}),r.jsxs(ce,{direction:"row",flexWrap:"wrap",gap:4,children:[r.jsx("h5",{className:"mb-0 color-secondary smooth-shadow-card p-2 rounded-2 fw-semibold ",children:"Facilitate Study India Initiative"}),r.jsx("h5",{className:"mb-0 color-secondary smooth-shadow-card p-2 rounded-2 fw-semibold ",children:"Study Abroad Program"}),r.jsx("h5",{className:"mb-0 color-secondary smooth-shadow-card p-2 rounded-2 fw-semibold ",children:"International Exchange and Mobility"})]})]}),r.jsxs(w,{maxWidth:e,mx:"auto",p:"3%",bgcolor:"#fff",mt:7,borderRadius:4,className:"smooth-shadow",children:[r.jsx("h3",{className:"color-secondary fw-bold mb-4",children:"Objectives Of Krishna Center of International Affairs "}),r.jsxs("ol",{children:[r.jsx("li",{className:"fw-semibold color-secondary fs-5 mb-2",children:"To coordinate all matters relating to welcoming and supporting foreign students"}),r.jsx("li",{className:"fw-semibold color-secondary fs-5 mb-2",children:"To disseminate information related to admission process among prospective foreign students."}),r.jsx("li",{className:"fw-semibold color-secondary fs-5 mb-2",children:"To engage in promotional activities and brand building campaign abroad."}),r.jsx("li",{className:"fw-semibold color-secondary fs-5 mb-2",children:"Single point contact for carrying out all collaborative activities with foreign institutions."}),r.jsx("li",{className:"fw-semibold color-secondary fs-5 mb-2",children:"Act as a liaisoning body between the foreign students and sponsoring agency."}),r.jsx("li",{className:"fw-semibold color-secondary fs-5 mb-2",children:"To address the grievances of foreign students in all matters."}),r.jsx("li",{className:"fw-semibold color-secondary fs-5 mb-2",children:"Single point contact for registration with FRRO/e-FRRO."}),r.jsx("li",{className:"fw-semibold color-secondary fs-5 mb-2",children:"To facilitate networking with fellow students."}),r.jsx("li",{className:"fw-semibold color-secondary fs-5 mb-2",children:"To extend all possible help to the foreign students to adapt to the new cultural environment and make their stay in India comfortable and enriching."}),r.jsx("li",{className:"fw-semibold color-secondary fs-5 mb-2",children:"To provide a platform to students and staff to explore their research capabilities through joint research programs and with the interaction of collaborated universities."}),r.jsx("li",{className:"fw-semibold color-secondary fs-5 mb-2",children:"To provide exposure to the students and faculty members to global technologies in the area of advanced research, innovation & development."}),r.jsx("li",{className:"fw-semibold color-secondary fs-5 mb-2",children:"To improve communication skills, self-esteem, creativity, and leadership ability of students, which are key attributes to nurture successful engineers, scientists and business leaders."}),r.jsx("li",{className:"fw-semibold color-secondary fs-5 mb-2",children:"To develop the international learning environment by inviting the faculties, scientists and researcher from the various universities of India and abroad."}),r.jsx("li",{className:"fw-semibold color-secondary fs-5 mb-2",children:"To offer long term and short terms technical and academic programs to international students at KPGU."}),r.jsx("li",{className:"fw-semibold color-secondary fs-5 mb-2",children:"To identify and invite international companies for the placements and industrial internship."})]})]})]})}function Yre(){const{maxWidth:e}=p.useContext(X),t=xt(),n=[{des:"The Krishna centre of Excellence in Startup and entrepreneurship is dedicated to support and fulfill the dreams of enthusiastic innovators to become successful entrepreneurs and also to contribute in the mission to step ahead in the direction of Aatmnirbhar Bharat. The goal of Krishna Centre of Excellence in startup and Entrepreneurship is creation of a vibrant start-up culture where ideas materialize into products, entrepreneurs are mentored, businesses are incubated and product or process innovation is facilitated to become business of global scale to contribute to economic prosperity of the Nation and for generation of employment.  The policy of the centre encourages the creation of innovation pipelines and pathways for entrepreneurs at University level by sufficient resource mobilization and utilization of pre-incubation and incubation facilities for nurturing innovations and startups of students, Startups and faculty members."},{des:"Another major function of the center is facilitating registration and licensing of Intellectual property of innovators & startups to safeguard their intellectual creations and IP monetization. Promotion and development of Entrepreneurship is one of the major dimensions of the University strategy and is implemented through value added programs such as Conferences, Workshops, Mentoring sessions, Innovation competitions, Hackathons etc. The accomplishment of the Product to market strategy for startups through the development of entrepreneurship culture is not only limited within the boundaries of the University as the strategy is well supported through collaboration with Government agencies and industries."}],a=[{name:"Dr. Prachi Pandey",image:"https://res.cloudinary.com/dby2vbxv3/image/upload/v1710996908/KPGU/CenterOfExcellence/dr-prachi-pandey.webp",designation:"Dy. Director, Startups & Entrepreneurship"}],i=({name:o,img:s,designation:l,quote:c})=>r.jsxs(k,{container:!0,maxWidth:e,mx:"auto",p:"3%",bgcolor:"#fff",mt:7,borderRadius:4,className:"smooth-shadow",overflow:"clip",children:[r.jsx(k,{item:!0,bgcolor:"#fff",xs:12,md:4,children:r.jsx(w,{className:"w-100 h-100 ",children:r.jsx("img",{src:s,className:"w-100 h-100 object-fit-cover rounded-4 ",alt:"photo"})})}),r.jsxs(k,{item:!0,bgcolor:"#fff",xs:12,md:8,p:2,children:[r.jsx("h3",{className:"display-5 fw-semibold",children:o}),r.jsxs("p",{className:"fs-4 mb-2",children:[r.jsxs("b",{children:[" ",l]}),",",r.jsx("br",{}),"Drs. Kiran & Pallavi Patel Global University [KPGU], Vadodara"]}),c?r.jsx(Qe,{quote:c,right:!0}):"",r.jsx($,{variant:"contained",color:"secondary",target:"_blank",href:"tel:7861805185",startIcon:r.jsx(Al,{}),disableElevation:!0,children:"7861805185"}),r.jsx("br",{}),r.jsx($,{variant:"contained",color:"secondary",target:"_blank",className:"text-lowercase mt-2",href:"mailto:dy.dir.startup@kpgu.edu.in",startIcon:r.jsx(gu,{}),disableElevation:!0,children:"dy.dir.startup@kpgu.edu.in"})]})]});return r.jsxs(r.Fragment,{children:[r.jsx(w,{children:a.map(({designation:o,image:s,name:l,quote:c},d)=>r.jsx(i,{designation:o,img:s,name:l,quote:c},d))}),r.jsxs(ce,{direction:"row",maxWidth:e,mx:"auto",px:"3%",py:"2%",bgcolor:"#fff",mt:3,spacing:2,className:"smooth-shadow",borderRadius:4,children:[r.jsx($,{onClick:()=>t("/centers-cells/start-ups"),variant:"contained",className:"p-2 fw-bold",disableElevation:!0,color:"secondary",fullWidth:!0,children:"Startup Cell"}),r.jsx($,{onClick:()=>t("/research-publications/ipr"),variant:"contained",className:"p-2 fw-bold",disableElevation:!0,color:"secondary",fullWidth:!0,children:"IPR Cell"}),r.jsx($,{onClick:()=>t("/research-publications/innovation-research"),variant:"contained",className:"p-2 fw-bold",disableElevation:!0,color:"secondary",fullWidth:!0,children:"Research Projects"}),r.jsx($,{onClick:()=>t("/centers-cells/krishna-educational-foundation"),variant:"contained",className:"p-2 fw-bold",disableElevation:!0,color:"secondary",fullWidth:!0,children:"Krishna Educational Foundation"})]}),r.jsx(w,{maxWidth:e,mx:"auto",p:"3%",bgcolor:"#fff",mt:3,borderRadius:4,className:"smooth-shadow",children:n.map(({des:o},s)=>r.jsx(Je,{content:[o]},s))})]})}function Jre(){const{maxWidth:e}=p.useContext(X),t=[{des:"India and the world as a whole are prone to multiple disasters due to its diverse variability, unique and vast geo-climatic conditions and ecological & socio-economic vulnerabilities"},{des:"Disasters like Earthquake, Cyclone, landslides, floods, draught, tsunami, fires, mass accidents, industrial disasters, etc. have been occurring and are increasing in recent times, especially the Cyclones."},{des:"Disasters that may be natural or man-made ultimately take a big toll leading to large scale loss of life, destruction of infrastructure, assets, resources and services. This ultimately poses a great impact and absolute threat for sustainable development of economy. Due to this, the under-privileged class which is almost always worst affected by disasters, pushes them further into poverty due to losses of their livelihood and assets. The COVID epidemic, has been proving to be greater disaster and has thrown a unique challenge."},{des:"During such disasters, it is the awareness and training of the citizens at large would minimize and mitigate the occurrence such episodes and reduce the impact to a very great extent. Such training sessions in disaster management as well as disaster risk reduction, needs to be conducted on a larger capacity by establishing centers of dedicated for the purpose."},{des:"Keeping this social concern in mind, the university has established a dedicated Krishna Centre of Training in Disaster Management with the aim of providing relief, conducting educational and awareness programs, conduct research and training in disaster mitigation and management."},{des:"The framework of Policy and functionality has been built in concurrence with National Disaster Management guidelines."},{des:"The Center has laid out the plan of action with the built-in systems, structures, programs, resources, capabilities and guiding principles for training individuals for disaster management and preparing them for responding to disasters and threats of disasters in order to save lives and property, avoid disruption of economic activity and damage to environment and to ensure the continuity and sustainability of development."},{des:"The center considers disaster management one of the cores of its activities and it will involve thorough study and research in anticipation of the upcoming and possible disasters and developing resources for readiness and mitigation capacity, in addition to developing systems and processes designed to provide relief and rehabilitation."}];return r.jsx(r.Fragment,{children:r.jsx(w,{maxWidth:e,mx:"auto",p:"3%",bgcolor:"#fff",mt:7,borderRadius:4,className:"smooth-shadow",children:t.map(({des:n},a)=>r.jsx(Je,{content:[n]},a))})})}function Qre(){const{maxWidth:e}=p.useContext(X),t=[{des:"To cater to the needs of genuine and innovative research in the emerging areas, Krishna Centre for Research and Innovation (KCIR) has been established to promote research and innovation aligned with the current societal, state, national and global problems, to ensure that India can compete in a globally competitive environment."},{des:"The objective (KCIR) is to expand the expertise of pool of researchers that can contribute to knowledge base of the world in the form of research articles, books, book chapters, conference proceedings, patents and startups."},{des:"To solve humanity’s biggest challenges in the field of new innovations, the center embraces multidisciplinary collaboration. The main focus is to address industrial challenges via financed initiatives or revenue-generating consulting."},{des:"The strong policy framework of the Centre, guide to develop rules, procedures and guidelines for granting research support, instituting awards, and supporting all other related activities."},{des:"The core focus of (KCIR) is to prepare and regularly update the research agenda of the University, outlining the priorities of research activities to be supported. Also, the research policy is bound to implement a research quality assurance mechanism for ensuring that all research activities of the University conform to the quality specifications."},{des:"It encourages students and faculty members to participate in research, publish their work and participate in national and international conferences to present the research data and to generate new concepts in the emerging areas individually and also by collaborating with other national and foreign universities."},{des:"The centre is also working to identify and establish linkages and long-term relationships with national and international research organizations for widening the scope of research opportunities and funding options available to the teachers and students of the University."},{des:"Ultimately, the goal is to promote researchers, industries, community and the government, all to work together to transform knowledge and innovations into sustainable advancements which can accelerate the intellectual, economic and social empowerment of the nation."}];return r.jsx(r.Fragment,{children:r.jsx(w,{maxWidth:e,mx:"auto",p:"3%",bgcolor:"#fff",mt:7,borderRadius:4,className:"smooth-shadow",children:t.map(({des:n},a)=>r.jsx(Je,{content:[n]},a))})})}function Xre(){const{maxWidth:e}=p.useContext(X),[t,n]=p.useState("1"),[a,i]=p.useState("3"),[o,s]=p.useState("5"),l=(c,d)=>{n(d)};return r.jsxs(r.Fragment,{children:[r.jsx(An,{banner:{title:"Career",img:"https://res.cloudinary.com/dby2vbxv3/image/upload/v1702100388/KPGU/Banners/banner-2.jpg"}}),r.jsx(w,{children:r.jsxs(w,{maxWidth:e,mx:"auto",p:"3%",bgcolor:"#fff",mt:7,borderRadius:4,className:"smooth-shadow",children:[r.jsx("h6",{className:"my-4",children:"DRS KIRAN & PALLAVI PATEL GLOBAL UNIVERSITY (KPGU), VADODARA, State Private University established under the provisions of Gujarat Private Universities Act 2009, Gujarat Private Universities (Amendment) Act 2009 (Act No. 15 of 2021) & Govt. of Gujarat. We are passionate about everything with fun along the way. We are constantly looking for individuals who will add value to our institution with their outstanding and innovative approach. We provide excellent working environment with vast infrastructure and tremendous facilities. KPGU is located near Vadodara city."}),r.jsxs(Ke,{value:t,children:[r.jsx(w,{sx:{borderBottom:1,borderColor:"divider"},children:r.jsxs(Ve,{onChange:l,"aria-label":"lab API tabs example",textColor:"secondary",indicatorColor:"secondary",children:[r.jsx(G,{label:"Current",value:"1",className:"fw-bold "}),r.jsx(G,{label:"Archived",value:"2",className:"fw-bold "})]})}),r.jsxs(W,{value:"1",children:[r.jsxs(k,{container:!0,children:[r.jsx(k,{item:!0,xs:12,sm:4,children:r.jsx("img",{src:"https://res.cloudinary.com/dby2vbxv3/image/upload/v1732960727/KPGU/Career/WhatsApp_Image_2024-11-30_at_10.27.57_bb1acf3f_udglcx.jpg",className:"w-100",alt:""})}),r.jsx(k,{item:!0,xs:12,sm:8})]}),r.jsx("h2",{className:"fw-bold color-secondary",children:"Please Email to HR Department with your CV"}),r.jsx($,{variant:"contained",color:"secondary",href:"mailto:os@kpgu.ac.in",className:"text-lowercase",children:"os@kpgu.ac.in"})]}),r.jsx(W,{value:"2",className:"px-0",children:r.jsx(ce,{children:r.jsxs(Ke,{value:a,children:[r.jsxs(Ve,{variant:"scrollable",onChange:(c,d)=>{i(d)},"aria-label":"lab API tabs example",textColor:"secondary",indicatorColor:"secondary",children:[r.jsx(G,{label:"Application For  Provost",value:"3",className:"fw-bold ps-1"}),r.jsx(G,{label:"Application for Teaching / Admin Staff",value:"4",className:"fw-bold "})]}),r.jsxs(W,{value:"3",children:[r.jsx("h3",{className:"fw-bold color-secondary",children:"Call for Application/Nomination for the position of Provost"}),r.jsx(Je,{content:["The establishment of a world-class university requires strong leadership, a bold vision of the institution’s mission and goals, and a clearly articulated strategic plan to translate the vision into concrete targets and programs. Shree Jagdishbhai Patel, founder managing trustee, and Hon’ble President of the University is a thinker, a philosopher, and a philanthropist is providing very dynamic leadership and guides the University’s development. His strategic agenda will enable the institution to realize a set of ambitious goals. Besides, his initiatives and relentless efforts will impact and elevate every aspect of the University.","Dr. Kiran C Patel and his wife Dr. Pallavi Patel have collaborated with the Hon’ble President to build a world-class university to transform lives and build tomorrow. They represent hope and change, aspiration and inspiration. Dr. Kiran Patel is an accomplished Indo-American Cardiologist, Entrepreneur, Hotelier, and Community leader from Tampa, Florida, USA. Philanthropy has been a valuable resource for higher education.","Drs. Kiran & Pallavi Patel Global University (KPGU), Vadodara sponsored by the Shree Krishna Educational & Charitable Trust (SKECT), Vadodara has been established as the State Private University under the provisions of Gujarat Private Universities Act, 2009 and notified through Gujarat Private Universities (Amendment) Act, 2021 (Gujarat Act No. 15 of 2021). KPGU aspires to be a globally acclaimed a value-driven University recognized for excellence in teaching and research.","KPGU is looking for a visionary with exemplary dynamic leadership qualities, academic and administrative capabilities with highest level of competence, good academic career with research experience and experience of organising NAAC inspection in the University, with National & International experience to implement the NEP-2020 at the KPGU."]}),r.jsxs(k,{container:!0,padding:"2.5%",className:"smooth-shadow",borderRadius:4,spacing:2,children:[r.jsx(k,{item:!0,xs:12,md:5,children:r.jsx(w,{children:r.jsx("img",{src:"https://res.cloudinary.com/dby2vbxv3/image/upload/v1722065690/KPGU/Career/WhatsApp-Image-2022-09-07-at-10.33.41-AM-822x1024_p7olxz.jpg",className:"w-100",alt:""})})}),r.jsxs(k,{item:!0,xs:12,md:7,children:[r.jsxs(w,{mb:3,children:[r.jsx("h4",{className:"fw-bold color-secondary",children:"The Eligibility and Experience are as per the Existing norms of University Grants Commission (UGC)."}),r.jsx("h4",{className:"fw-bold color-secondary",children:"Click here for Application format"}),r.jsx($,{startIcon:r.jsx(ra,{}),target:"_blank",href:"https://res.cloudinary.com/dby2vbxv3/raw/upload/v1722066668/KPGU/Career/KPGU-Application-Form-Format-Provost-2022_1_mue99i.doc",download:!0,variant:"contained",color:"secondary",children:"download"})]}),r.jsx(ao,{color:"warning",icon:r.jsx(Ml,{}),children:r.jsx("h6",{className:"fw-semibold mb-0 ",children:"The application is in editable format for filling up the details only and the heading and other parameters should not be changed. If anything is not applicable, kindly mention Not applicable."})}),r.jsx("h5",{className:"mt-3 fw-bold",children:"The last date of receiving the applications"}),r.jsx($,{size:"small",variant:"contained",color:"secondary",startIcon:r.jsx(lV,{}),children:" 27-09-2022."}),r.jsx("h5",{className:"mt-3 fw-bold",children:"The above filled application or nomination with supporting evidences and necessa